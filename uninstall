#!/usr/bin/env bash
# uninstall — Remove all toolkit installations.
set -euo pipefail

info() { echo -e "\033[0;32m$*\033[0m"; }

info "Removing CLI symlinks..."
sudo rm -f /usr/local/bin/cleanusb
sudo rm -f /usr/local/bin/bravia-ready
sudo rm -f /usr/local/bin/ripcd
sudo rm -f /usr/local/bin/pslag
sudo rm -f /usr/local/bin/music-index
sudo rm -f /usr/local/bin/focus

info "Done. Everything removed."
