[Desktop Entry]
Name=Clean USB
Comment=Wipe, format, and benchmark USB drives for Windows
Exec=cosmic-clean-usb
Icon=com.banglabs.CleanUsb
Terminal=false
Type=Application
Categories=COSMIC;Utility;System;
Keywords=usb;format;wipe;exfat;benchmark;
StartupNotify=true
StartupWMClass=com.banglabs.CleanUsb
