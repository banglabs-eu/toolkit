#!/usr/bin/env bash
set -euo pipefail

REMOTE="pcloud"
SRC="${REMOTE}:"
MARKER_REL="Backups/.bang-pcloud-archive"
# DEST / QUARANTINE_BASE / QUARANTINE are set after mount-point discovery below

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="${SCRIPT_DIR}/logs"
LOG_FILE="${LOG_DIR}/pcloud-archive-$(date +%Y%m%d-%H%M%S).log"

DRY_RUN=false
SKIP_PROMPT=false
LOG_LEVEL="NOTICE"
for arg in "$@"; do
    case "$arg" in
        --dry-run)    DRY_RUN=true ;;
        --yes|-y)     SKIP_PROMPT=true ;;
        --verbose|-v) LOG_LEVEL="INFO" ;;
        --debug)      LOG_LEVEL="DEBUG" ;;
        -h|--help)
            cat <<EOF
Usage: pcloud-archive [flags]
  --dry-run     Preview only, no transfers
  -y, --yes     Skip confirmation prompt
  -v, --verbose Log every file (INFO)   — default is summary only (NOTICE)
  --debug       Log all API traffic (DEBUG, very large)
  -h, --help    This message
EOF
            exit 0 ;;
        *) echo "Unknown flag: $arg (try --help)"; exit 1 ;;
    esac
done

# Pre-flight
command -v rclone >/dev/null || { echo "rclone not installed"; exit 1; }
rclone listremotes | grep -q "^${REMOTE}:$" || { echo "remote '${REMOTE}' not configured"; exit 1; }
MOUNT="${PCLOUD_ARCHIVE_MOUNT:-}"
if [[ -z "$MOUNT" ]]; then
    matches=()
    while IFS= read -r mp; do
        [[ -f "${mp}/${MARKER_REL}" ]] && matches+=("$mp")
    done < <(findmnt -rno TARGET --real 2>/dev/null)

    case "${#matches[@]}" in
        0) echo "no mounted drive contains the marker '${MARKER_REL}'"
           echo "plug in the backup drive, or run once on a fresh drive to set it up:"
           echo "  mkdir -p /path/to/drive/Backups && touch /path/to/drive/${MARKER_REL}"
           exit 1 ;;
        1) MOUNT="${matches[0]}" ;;
        *) echo "multiple drives carry the marker '${MARKER_REL}':"
           printf '  %s\n' "${matches[@]}"
           echo "unplug all but the intended one, or set PCLOUD_ARCHIVE_MOUNT explicitly"
           exit 1 ;;
    esac
fi

DEST="${MOUNT}/Backups/pCloud"
QUARANTINE_BASE="${MOUNT}/Backups/pCloud-deleted"
QUARANTINE="${QUARANTINE_BASE}/$(date +%Y-%m-%d-%H%M%S)"

mkdir -p "$DEST" "$QUARANTINE_BASE" "$LOG_DIR"

FLAGS=(
    --backup-dir "$QUARANTINE"
    --transfers=4
    --checkers=8
    --retries=3
    --low-level-retries=10
    --check-first
    --progress
    --log-file="$LOG_FILE"
    --log-level="$LOG_LEVEL"
)
$DRY_RUN && FLAGS+=(--dry-run)

mark() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" "$*" >> "$LOG_FILE"; }

echo "=== pCloud archive ==="
echo "Source:     ${SRC}"
echo "Dest:       ${DEST}"
echo "Quarantine: ${QUARANTINE}"
echo "Log:        ${LOG_FILE}"
echo

echo "Remote quota:"
rclone about "$SRC" 2>&1 || echo "  (could not fetch quota — proceeding anyway)"
echo
echo "Local free space:"
df -h "$DEST" | tail -1
echo

if ! $SKIP_PROMPT; then
    if [[ -z "$(ls -A "$DEST" 2>/dev/null)" ]]; then
        PROMPT="Start new sync? [Y/n] "
    else
        PROMPT="Resume sync? Files already on the destination will be skipped. [Y/n] "
    fi
    read -rp "$PROMPT" ans
    [[ "$ans" =~ ^[nN] ]] && { echo "aborted"; exit 0; }
fi

mark "=== started (level=${LOG_LEVEL}${DRY_RUN:+, dry-run}) ==="
trap 'mark "=== interrupted (exit=$?) ==="' INT TERM
RC=0
rclone sync "$SRC" "$DEST" "${FLAGS[@]}" || RC=$?
mark "=== finished (exit=${RC}) ==="
trap - INT TERM

# Tidy up empty quarantine dir if nothing was removed/replaced this run
if [[ ! -d "$QUARANTINE" ]] || [[ -z "$(ls -A "$QUARANTINE" 2>/dev/null)" ]]; then
    [[ -d "$QUARANTINE" ]] && rmdir "$QUARANTINE"
    echo "No deletions/replacements this run."
else
    echo "Files moved to quarantine: $QUARANTINE"
fi

# Prune logs (keep last 30)
ls -t "$LOG_DIR"/pcloud-archive-*.log 2>/dev/null | tail -n +31 | xargs -r rm -f

echo "=== Done ==="
