#!/usr/bin/env bash
# clean-usb — Safely wipe and format attached USB drives for Windows use (exFAT + GPT).
# Usage: sudo ./clean-usb [--secure] [DEVICE]
#   --secure   Zero the entire drive before formatting (slow but unrecoverable)
#   If DEVICE is omitted, lists detected USB drives and prompts for selection.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

die()  { echo -e "${RED}Error: $*${RESET}" >&2; exit 1; }
warn() { echo -e "${YELLOW}$*${RESET}"; }
info() { echo -e "${GREEN}$*${RESET}"; }

# --- Parse flags ---

SECURE=false
if [[ "${1:-}" == "--secure" ]]; then
    SECURE=true
    shift
fi

# --- Preflight checks ---

[[ $EUID -eq 0 ]] || die "Must run as root. Use: sudo $0"

for cmd in lsblk wipefs parted mkfs.exfat; do
    command -v "$cmd" &>/dev/null || die "'$cmd' not found. Install with: sudo apt install parted exfatprogs"
done

# --- Discover USB block devices ---

get_usb_devices() {
    lsblk -dnpo NAME,TRAN,TYPE | awk '$2 == "usb" && $3 == "disk" { print $1 }'
}

# --- Select device ---

DEVICES=()

if [[ -n "${1:-}" ]]; then
    DEVICE="$1"
    TRAN=$(lsblk -dnpo TRAN "$DEVICE" 2>/dev/null) || die "$DEVICE does not exist"
    [[ "$TRAN" == "usb" ]] || die "$DEVICE is not a USB device (transport: ${TRAN:-unknown}). Refusing to proceed."
    DEVICES+=("$DEVICE")
else
    mapfile -t USB_DEVICES < <(get_usb_devices)

    if [[ ${#USB_DEVICES[@]} -eq 0 ]]; then
        die "No USB drives detected. Plug one in and try again."
    fi

    echo -e "${BOLD}Detected USB drives:${RESET}"
    echo ""
    for dev in "${USB_DEVICES[@]}"; do
        SIZE=$(lsblk -dnpo SIZE "$dev" | xargs)
        MODEL=$(lsblk -dnpo MODEL "$dev" | xargs)
        echo -e "  ${BOLD}${dev}${RESET} — ${MODEL:-unknown}, ${SIZE}"
        lsblk -po NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$dev" | tail -n +2 | sed 's/^/    /'
        echo ""
        if $SECURE; then
            warn "  ALL DATA will be SECURELY WIPED (full zero pass)."
        else
            warn "  ALL DATA will be permanently destroyed."
        fi
        echo ""
        read -rp "  Wipe ${MODEL:-unknown} (${SIZE})? [y/N]: " answer
        if [[ "${answer,,}" == "y" ]]; then
            DEVICES+=("$dev")
            info "  -> Marked for wiping."
        else
            echo "  -> Skipped."
        fi
        echo ""
    done

    if [[ ${#DEVICES[@]} -eq 0 ]]; then
        echo "No drives selected. Aborted."
        exit 0
    fi

    echo -e "${BOLD}Summary — will wipe:${RESET}"
    for dev in "${DEVICES[@]}"; do
        MODEL=$(lsblk -dnpo MODEL "$dev" | xargs)
        SIZE=$(lsblk -dnpo SIZE "$dev" | xargs)
        echo "  ${dev} — ${MODEL:-unknown}, ${SIZE}"
    done
    if ! $SECURE; then
        echo -e "  (Use ${BOLD}--secure${RESET} for full zero wipe — slower but unrecoverable)"
    fi
    echo ""
    read -rp "Type YES to confirm: " confirm
    [[ "$confirm" == "YES" ]] || { echo "Aborted."; exit 0; }
fi

# --- Process each device ---

SUDO_USER="${SUDO_USER:-$USER}"
MOUNT_BASE="/media/${SUDO_USER}"

for DEVICE in "${DEVICES[@]}"; do
    MODEL=$(lsblk -dnpo MODEL "$DEVICE" | xargs)
    SIZE=$(lsblk -dnpo SIZE "$DEVICE" | xargs)
    echo ""
    echo -e "${BOLD}=== ${MODEL:-unknown} (${SIZE}) — ${DEVICE} ===${RESET}"

    # --- Unmount any mounted partitions ---

    info "Unmounting partitions..."
    for part in $(lsblk -npo NAME "$DEVICE" | tail -n +2); do
        if mountpoint -q "$(lsblk -npo MOUNTPOINT "$part" 2>/dev/null)" 2>/dev/null; then
            umount "$part" && echo "  Unmounted $part"
        fi
    done

    # --- Wipe ---

    info "Wiping filesystem signatures..."
    wipefs --all --force "$DEVICE"

    if $SECURE; then
        info "Securely zeroing entire drive (${SIZE})... this will take a while."
        dd if=/dev/zero of="$DEVICE" bs=4M status=progress conv=fsync 2>&1
        info "Full zero wipe complete."
    else
        info "Zeroing first and last 1 MiB (clears partition tables and backup headers)..."
        dd if=/dev/zero of="$DEVICE" bs=1M count=1 status=none
        SECTORS=$(blockdev --getsz "$DEVICE")
        SECTOR_SIZE=$(blockdev --getss "$DEVICE")
        TAIL_OFFSET=$(( (SECTORS * SECTOR_SIZE) - 1048576 ))
        if [[ $TAIL_OFFSET -gt 0 ]]; then
            dd if=/dev/zero of="$DEVICE" bs=1 count=1048576 seek="$TAIL_OFFSET" status=none
        fi
    fi

    # --- Partition (GPT + single exFAT partition) ---

    # Use a label based on the model name, fallback to "USB"
    LABEL=$(echo "${MODEL:-USB}" | tr -cs '[:alnum:]' ' ' | xargs | cut -c1-11)

    info "Creating GPT partition table with single exFAT partition..."
    parted -s "$DEVICE" mklabel gpt
    parted -s "$DEVICE" mkpart primary 1MiB 100%
    parted -s "$DEVICE" set 1 msftdata on

    partprobe "$DEVICE"
    sleep 1

    # Determine partition path
    if [[ "$DEVICE" =~ [0-9]$ ]]; then
        PART="${DEVICE}p1"
    else
        PART="${DEVICE}1"
    fi

    [[ -b "$PART" ]] || die "Expected partition $PART not found after partitioning"

    # --- Format ---

    info "Formatting ${PART} as exFAT (label: ${LABEL})..."
    mkfs.exfat -L "$LABEL" "$PART"

    # --- Mount ---

    MOUNT_POINT="${MOUNT_BASE}/${LABEL}"
    mkdir -p "$MOUNT_POINT"
    mount -o uid=$(id -u "$SUDO_USER"),gid=$(id -g "$SUDO_USER") "$PART" "$MOUNT_POINT"

    info "Mounted at ${MOUNT_POINT}"

    # --- Done for this device ---

    echo ""
    info "Done! ${DEVICE} is ready for Windows."
    echo -e "  Label:       ${LABEL}"
    echo -e "  Filesystem:  exFAT"
    echo -e "  Partition:   GPT"
    echo -e "  Mounted at:  ${MOUNT_POINT}"
    echo ""

    read -rp "Open in file browser? [y/N]: " open_answer
    if [[ "${open_answer,,}" == "y" ]]; then
        sudo -u "$SUDO_USER" xdg-open "$MOUNT_POINT" &>/dev/null &
        disown
        info "Opened ${MOUNT_POINT} in file browser."
    fi
done

echo ""
info "All done!"
echo -e "  Safely eject with: ${BOLD}sudo eject /dev/sdX${RESET}"
