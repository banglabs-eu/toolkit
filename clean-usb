#!/usr/bin/env bash
# clean-usb — Manage attached USB drives: wipe, secure wipe, or browse.
# Usage: sudo cleanusb [--secure|--open] [DEVICE]
#   No args:     Interactive — shows each USB, choose what to do
#   --secure DEV Full zero wipe + format
#   --open DEV   Just mount and open in file browser
#   DEVICE       Quick wipe + format
#
# Writes a report to ~/usb-report.md after each wipe with speed benchmarks.

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

die()  { echo -e "${RED}Error: $*${RESET}" >&2; exit 1; }
warn() { echo -e "${YELLOW}$*${RESET}"; }
info() { echo -e "${GREEN}$*${RESET}"; }

SUDO_USER="${SUDO_USER:-$USER}"
SUDO_HOME=$(eval echo "~$SUDO_USER")
MOUNT_BASE="/media/${SUDO_USER}"
REPORT_FILE="${SUDO_HOME}/usb-report.md"

# --- Progress bar ---

# Usage: progress_bar "Label" current total
progress_bar() {
    local label="$1" current="$2" total="$3"
    local width=40 pct filled empty bar
    pct=$(( current * 100 / total ))
    filled=$(( current * width / total ))
    empty=$(( width - filled ))
    bar=$(printf '%*s' "$filled" '' | tr ' ' '#')
    bar+=$(printf '%*s' "$empty" '' | tr ' ' '-')
    printf "\r  ${GREEN}%-20s${RESET} [${bar}] %3d%%" "$label" "$pct" >&2
    if [[ "$current" -eq "$total" ]]; then
        echo "" >&2
    fi
}

# --- Preflight checks ---

[[ $EUID -eq 0 ]] || die "Must run as root. Use: sudo $0"

for cmd in lsblk wipefs parted mkfs.exfat; do
    command -v "$cmd" &>/dev/null || die "'$cmd' not found. Install with: sudo apt install parted exfatprogs"
done

# --- Helpers ---

get_usb_devices() {
    lsblk -dnpo NAME,TRAN,TYPE | awk '$2 == "usb" && $3 == "disk" { print $1 }'
}

get_usb_version() {
    local dev="$1"
    local name syspath p speed
    name=$(basename "$dev")
    syspath=$(readlink -f /sys/block/"$name" 2>/dev/null) || { echo "unknown"; return; }
    p="$syspath"
    while [[ "$p" != "/" ]]; do
        if [[ -f "$p/speed" ]]; then
            speed=$(cat "$p/speed")
            case "$speed" in
                12)    echo "USB 1.1" ;;
                480)   echo "USB 2.0" ;;
                5000)  echo "USB 3.0" ;;
                10000) echo "USB 3.1" ;;
                20000) echo "USB 3.2" ;;
                *)     echo "USB (${speed} Mbps)" ;;
            esac
            return
        fi
        p=$(dirname "$p")
    done
    echo "unknown"
}

ensure_mounted() {
    local dev="$1"
    local part mount_point label

    part=$(lsblk -lnpo NAME "$dev" | tail -n +2 | head -1)
    if [[ -z "$part" ]]; then
        echo ""
        return
    fi

    mount_point=$(lsblk -lnpo MOUNTPOINT "$part" 2>/dev/null | xargs || true)
    if [[ -n "$mount_point" ]]; then
        echo "$mount_point"
        return
    fi

    label=$(lsblk -lnpo LABEL "$part" 2>/dev/null | xargs || true)
    label="${label:-USB}"
    mount_point="${MOUNT_BASE}/${label}"
    mkdir -p "$mount_point"
    mount "$part" "$mount_point" 2>/dev/null && echo "$mount_point" || echo ""
}

open_in_browser() {
    local path="$1"
    sudo -u "$SUDO_USER" xdg-open "$path" &>/dev/null &
    disown
}

quick_bench() {
    local mount_point="$1"
    local test_file="${mount_point}/.cleanusb_qbench"
    local write_speed read_speed
    write_speed=$(dd if=/dev/zero of="$test_file" bs=1M count=8 conv=fsync 2>&1 | \
        grep -oP '[\d.]+ [MG]B/s' | tail -1 || true)
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    read_speed=$(dd if="$test_file" of=/dev/null bs=1M count=8 2>&1 | \
        grep -oP '[\d.]+ [MG]B/s' | tail -1 || true)
    rm -f "$test_file"
    echo "${write_speed:-N/A}|${read_speed:-N/A}"
}

show_device() {
    local dev="$1"
    local size model usb_ver mount_point bench write_speed read_speed
    size=$(lsblk -dnpo SIZE "$dev" | xargs)
    model=$(lsblk -dnpo MODEL "$dev" | xargs)
    usb_ver=$(get_usb_version "$dev")

    echo -e "  ${BOLD}${model:-unknown}${RESET} — ${size}, ${usb_ver} ${DIM}(${dev})${RESET}"
    lsblk -po NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$dev" | tail -n +2 | sed 's/^/    /'

    mount_point=$(ensure_mounted "$dev")
    if [[ -n "$mount_point" ]]; then
        printf "    Benchmarking..."
        bench=$(quick_bench "$mount_point")
        write_speed="${bench%%|*}"
        read_speed="${bench##*|}"
        printf "\r    ${GREEN}Write: %-12s Read: %-12s${RESET}\n" "$write_speed" "$read_speed"
    fi
}

unmount_device() {
    local dev="$1"
    for part in $(lsblk -lnpo NAME "$dev" | tail -n +2); do
        if mountpoint -q "$(lsblk -npo MOUNTPOINT "$part" 2>/dev/null)" 2>/dev/null; then
            umount "$part" && echo "  Unmounted $part"
        fi
    done
}

# --- Speed benchmark ---

benchmark_device() {
    local part="$1" mount_point="$2"
    local test_file="${mount_point}/.cleanusb_benchmark"
    local bs=1048576 count=64 i
    local write_speed read_speed

    # Write benchmark with progress
    for ((i = 1; i <= count; i++)); do
        dd if=/dev/zero of="$test_file" bs=$bs seek=$((i - 1)) count=1 conv=notrunc status=none
        progress_bar "Bench write" "$i" "$count"
    done
    sync
    # Get write speed from a single timed pass
    write_speed=$(dd if=/dev/zero of="$test_file" bs=1M count=$count conv=fsync 2>&1 | \
        grep -oP '[\d.]+ [MG]B/s' | tail -1 || true)

    # Clear cache before read test
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

    # Read benchmark with progress
    for ((i = 1; i <= count; i++)); do
        dd if="$test_file" of=/dev/null bs=$bs skip=$((i - 1)) count=1 status=none
        progress_bar "Bench read" "$i" "$count"
    done
    # Get read speed from a single timed pass
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    read_speed=$(dd if="$test_file" of=/dev/null bs=1M count=$count 2>&1 | \
        grep -oP '[\d.]+ [MG]B/s' | tail -1 || true)

    rm -f "$test_file"

    echo "${write_speed:-N/A}|${read_speed:-N/A}"
}

# --- Integrity check ---

verify_integrity() {
    local dev="$1" part="$2" mount_point="$3"
    local test_file="${mount_point}/.cleanusb_verify"
    local checksum_src checksum_dst
    local count=16 i

    # Write 16 MiB of random data with progress
    for ((i = 1; i <= count; i++)); do
        dd if=/dev/urandom of="$test_file" bs=1M seek=$((i - 1)) count=1 conv=notrunc status=none
        progress_bar "Integrity write" "$i" "$count"
    done
    sync

    checksum_src=$(md5sum "$test_file" | awk '{print $1}')

    # Drop caches and re-read with progress
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    # Read back to warm up, then checksum
    for ((i = 1; i <= count; i++)); do
        dd if="$test_file" of=/dev/null bs=1M skip=$((i - 1)) count=1 status=none
        progress_bar "Integrity read" "$i" "$count"
    done

    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    checksum_dst=$(md5sum "$test_file" | awk '{print $1}')

    rm -f "$test_file"

    if [[ "$checksum_src" == "$checksum_dst" ]]; then
        info "  Integrity PASSED (md5: ${checksum_src:0:12}...)" >&2
        echo "PASS"
    else
        warn "  Integrity FAILED! (wrote: ${checksum_src}, read: ${checksum_dst})" >&2
        echo "FAIL"
    fi
}

# --- Report ---

init_report() {
    if [[ ! -f "$REPORT_FILE" ]]; then
        cat > "$REPORT_FILE" <<'HEADER'
# USB Drive Report

| Date | Name | Size | USB Type | Write Speed | Read Speed | Integrity | Action |
|------|------|------|----------|-------------|------------|-----------|--------|
HEADER
        chown "$SUDO_USER":"$SUDO_USER" "$REPORT_FILE" 2>/dev/null || true
    fi
}

append_report() {
    local model="$1" size="$2" usb_ver="$3" write_spd="$4" read_spd="$5" integrity="$6" action="$7"
    local date
    date=$(date '+%Y-%m-%d %H:%M')
    echo "| ${date} | ${model} | ${size} | ${usb_ver} | ${write_spd} | ${read_spd} | ${integrity} | ${action} |" >> "$REPORT_FILE"
}

# --- Wipe device ---

wipe_device() {
    local dev="$1" secure="$2"
    local size model label part usb_ver mount_point
    local write_speed="—" read_speed="—" integrity="—" action_name

    size=$(lsblk -dnpo SIZE "$dev" | xargs)
    model=$(lsblk -dnpo MODEL "$dev" | xargs)
    usb_ver=$(get_usb_version "$dev")

    if $secure; then
        action_name="Secure wipe"
    else
        action_name="Quick wipe"
    fi

    info "Unmounting partitions..."
    unmount_device "$dev"

    info "Wiping filesystem signatures..."
    wipefs --all --force "$dev"

    if $secure; then
        info "Securely zeroing entire drive (${size})..."
        dd if=/dev/zero of="$dev" bs=4M status=progress conv=fsync 2>&1
        info "Full zero wipe complete."
    else
        progress_bar "Zero head" 0 2
        dd if=/dev/zero of="$dev" bs=1M count=1 status=none
        progress_bar "Zero head" 1 2
        local sectors sector_size tail_offset
        sectors=$(blockdev --getsz "$dev")
        sector_size=$(blockdev --getss "$dev")
        tail_offset=$(( (sectors * sector_size) - 1048576 ))
        if [[ $tail_offset -gt 0 ]]; then
            dd if=/dev/zero of="$dev" bs=1 count=1048576 seek="$tail_offset" status=none
        fi
        progress_bar "Zero head+tail" 2 2
    fi

    # Label from model name (exFAT max 11 chars)
    label=$(echo "${model:-USB}" | tr -cs '[:alnum:]' ' ' | xargs | cut -c1-11)

    progress_bar "Partitioning" 0 3
    parted -s "$dev" mklabel gpt
    progress_bar "Partitioning" 1 3
    parted -s "$dev" mkpart primary 1MiB 100%
    progress_bar "Partitioning" 2 3
    parted -s "$dev" set 1 msftdata on
    partprobe "$dev"
    sleep 1
    progress_bar "Partitioning" 3 3

    if [[ "$dev" =~ [0-9]$ ]]; then
        part="${dev}p1"
    else
        part="${dev}1"
    fi

    [[ -b "$part" ]] || die "Expected partition $part not found after partitioning"

    progress_bar "Formatting" 0 1
    mkfs.exfat -L "$label" "$part" >/dev/null
    progress_bar "Formatting" 1 1

    # Mount the fresh partition
    mount_point="${MOUNT_BASE}/${label}"
    mkdir -p "$mount_point"
    mount -o uid=$(id -u "$SUDO_USER"),gid=$(id -g "$SUDO_USER") "$part" "$mount_point"

    info "Mounted at ${mount_point}"

    # Integrity check
    integrity=$(verify_integrity "$dev" "$part" "$mount_point")

    # Speed benchmark
    local bench_result
    bench_result=$(benchmark_device "$part" "$mount_point")
    write_speed="${bench_result%%|*}"
    read_speed="${bench_result##*|}"
    info "  Write: ${write_speed}  Read: ${read_speed}"

    # Write report
    init_report
    append_report "${model:-unknown}" "$size" "$usb_ver" "$write_speed" "$read_speed" "$integrity" "$action_name"
    info "Report updated: ${REPORT_FILE}"

    echo ""
    info "Done! ${dev} is ready for Windows."
    echo -e "  Label:       ${label}"
    echo -e "  Filesystem:  exFAT"
    echo -e "  Partition:   GPT"
    echo -e "  USB:         ${usb_ver}"
    echo -e "  Write:       ${write_speed}"
    echo -e "  Read:        ${read_speed}"
    echo -e "  Integrity:   ${integrity}"
    echo -e "  Mounted at:  ${mount_point}"
    echo ""

    # Unmount and eject
    info "Ejecting ${dev}..."
    umount "$mount_point" 2>/dev/null || true
    eject "$dev" 2>/dev/null || true
    info "Ejected. Safe to remove."
}

# --- Direct mode (with arguments) ---

if [[ -n "${1:-}" ]]; then
    MODE="wipe"
    if [[ "$1" == "--secure" ]]; then
        MODE="secure"
        shift
    elif [[ "$1" == "--open" ]]; then
        MODE="open"
        shift
    fi

    DEVICE="${1:-}"
    [[ -n "$DEVICE" ]] || die "No device specified"
    TRAN=$(lsblk -dnpo TRAN "$DEVICE" 2>/dev/null) || die "$DEVICE does not exist"
    [[ "$TRAN" == "usb" ]] || die "$DEVICE is not a USB device (transport: ${TRAN:-unknown}). Refusing to proceed."

    case "$MODE" in
        open)
            mount_point=$(ensure_mounted "$DEVICE")
            [[ -n "$mount_point" ]] || die "Could not mount $DEVICE — no partitions found"
            open_in_browser "$mount_point"
            info "Opened ${mount_point} in file browser."
            ;;
        secure)
            show_device "$DEVICE"
            echo ""
            warn "ALL DATA will be SECURELY WIPED (full zero pass)."
            read -rp "  Continue? [Y/n]: " confirm
            [[ "${confirm,,}" == "n" ]] && { echo "Aborted."; exit 0; }
            wipe_device "$DEVICE" true
            ;;
        wipe)
            show_device "$DEVICE"
            echo ""
            warn "ALL DATA will be permanently destroyed."
            read -rp "  Continue? [Y/n]: " confirm
            [[ "${confirm,,}" == "n" ]] && { echo "Aborted."; exit 0; }
            wipe_device "$DEVICE" false
            ;;
    esac
    exit 0
fi

# --- Interactive mode (no arguments) ---

mapfile -t USB_DEVICES < <(get_usb_devices)

if [[ ${#USB_DEVICES[@]} -eq 0 ]]; then
    die "No USB drives detected. Plug one in and try again."
fi

# Mount all USB devices first so we can show their state
for dev in "${USB_DEVICES[@]}"; do
    ensure_mounted "$dev" >/dev/null
done

echo ""
echo -e "${BOLD}USB drives:${RESET}"
echo ""

for dev in "${USB_DEVICES[@]}"; do
    # Skip devices that are no longer present (e.g. ejected)
    [[ -b "$dev" ]] || continue

    show_device "$dev"
    echo ""
    echo -e "  ${BOLD}[w]${RESET} Wipe (quick)    ${BOLD}[s]${RESET} Secure wipe    ${BOLD}[o]${RESET} Open in file browser    ${BOLD}[enter]${RESET} Skip"
    read -rp "  Action: " action

    case "${action,,}" in
        w)
            warn "  ALL DATA on this drive will be permanently destroyed."
            read -rp "  Continue? [Y/n]: " confirm
            if [[ "${confirm,,}" != "n" ]]; then
                wipe_device "$dev" false
            else
                echo "  Skipped."
            fi
            ;;
        s)
            warn "  ALL DATA will be SECURELY WIPED (full zero pass). This will take a while."
            read -rp "  Continue? [Y/n]: " confirm
            if [[ "${confirm,,}" != "n" ]]; then
                wipe_device "$dev" true
            else
                echo "  Skipped."
            fi
            ;;
        o)
            mount_point=$(ensure_mounted "$dev")
            if [[ -n "$mount_point" ]]; then
                open_in_browser "$mount_point"
                info "  Opened ${mount_point} in file browser."
            else
                warn "  Could not mount — no partitions found. Wipe first?"
            fi
            ;;
        *)
            echo "  Skipped."
            ;;
    esac
    echo ""
done

info "All done!"
echo -e "  Report: ${BOLD}${REPORT_FILE}${RESET}"
