#!/bin/bash
set -euo pipefail

# mercreate - Generate HTML and PNG from a .mmd mermaid file
# Usage: mercreate FILE.mmd

if [ -z "${1:-}" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Usage: mercreate FILE.mmd"
  echo ""
  echo "Generates HTML and PNG in the same directory as the input file."
  echo "Output files are named: NAME.v1.{html,png}, NAME.v2.{html,png}, etc."
  exit 0
fi

mmd="$(realpath "$1")"
if [ ! -f "$mmd" ]; then
  echo "Error: $mmd not found"
  exit 1
fi

dir="$(dirname "$mmd")"
name="$(basename "${mmd%.mmd}")"

# Find next version number
v=1
while [ -e "${dir}/${name}.v${v}.html" ] || [ -e "${dir}/${name}.v${v}.png" ]; do
  v=$((v + 1))
done
base="${dir}/${name}.v${v}"

# HTML
cat > "${base}.html" << HTMLEOF
<html>
  <head>
    <title>${name}</title>
  </head>
  <body>
    <pre class="mermaid">
$(cat "$mmd")
    </pre>

    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.14.0/dist/mermaid.esm.min.mjs';
      mermaid.initialize({ startOnLoad: true });
    </script>
  </body>
</html>
HTMLEOF
echo "Built ${base}.html"

# PNG
mmdc -i "$mmd" -o "${base}.png" -p ~/.mermaidcli.json -s 4
echo "Built ${base}.png"
