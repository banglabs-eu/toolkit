# 3x5 bitmaps, one string per row, drawn two columns wide so the digits come
# out roughly square in a terminal cell grid.
GLYPHS = {
    "0": ("111", "101", "101", "101", "111"),
    "1": ("010", "110", "010", "010", "111"),
    "2": ("111", "001", "111", "100", "111"),
    "3": ("111", "001", "111", "001", "111"),
    "4": ("101", "101", "111", "001", "001"),
    "5": ("111", "100", "111", "001", "111"),
    "6": ("111", "100", "111", "101", "111"),
    "7": ("111", "001", "010", "010", "010"),
    "8": ("111", "101", "111", "101", "111"),
    "9": ("111", "101", "111", "001", "111"),
    ":": ("0", "1", "0", "1", "0"),
    # Letters are four wide: three cannot hold a diagonal, so N came out solid.
    "D": ("1110", "1001", "1001", "1001", "1110"),
    "O": ("0110", "1001", "1001", "1001", "0110"),
    "N": ("1001", "1101", "1011", "1001", "1001"),
    "E": ("1111", "1000", "1110", "1000", "1111"),
}
GLYPH_ROWS = 5

# GlyphClock: the 1440 minutes from UTC midnight cut into 16 blocks of 90, a
# glyph to each, and each block into three turns of 30 shown as one, two or
# three copies of it. Same reading everywhere, no timezone. See
# glyphclock.bang-labs.eu.
GLYPH_EMOJI = ("🥐", "🦋", "🌷", "☂️",
               "🌵", "🎈", "👓", "⚓",
               "🦚", "🤖", "⭐", "☁️",
               "🌲", "🪁", "🪑", "♻")
GLYPH_NAMES = ("croissant", "butterfly", "tulip", "umbrella",
               "cactus", "balloon", "glasses", "anchor",
               "peacock", "robot", "star", "cloud",
               "tree", "kite", "chair", "recycle")

# Turning a sprite round: reverse each line, then swap the characters that
# have a handedness. Every sprite below is drawn facing right.
_FLIP = {"(": ")", ")": "(", "[": "]", "]": "[", "{": "}", "}": "{",
         "<": ">", ">": "<", "/": "\\", "\\": "/", "d": "b", "b": "d"}


def mirror(art):
    width = max(len(line) for line in art)
    return ["".join(_FLIP.get(c, c) for c in reversed(line.ljust(width))) for line in art]


def colours_on():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def big(text):
    """Render a clock string as a list of GLYPH_ROWS wide lines."""
    lines = []
    for row in range(GLYPH_ROWS):
        parts = []
        for ch in text:
            bits = GLYPHS.get(ch, ("000",) * GLYPH_ROWS)[row]
            parts.append("".join("██" if b == "1" else "  " for b in bits))
        lines.append("  ".join(parts))
    return lines


def clock(seconds):
    seconds = max(0, int(seconds + 0.5))
    if seconds >= 3600:
        return "%d:%02d:%02d" % (seconds // 3600, seconds % 3600 // 60, seconds % 60)
    return "%02d:%02d" % (seconds // 60, seconds % 60)


def glyphclock(moment=None):
    """The GlyphClock reading now: the block's glyph, how many, and its name."""
    moment = moment or datetime.now(timezone.utc)
    minute = moment.hour * 60 + moment.minute
    block = min(minute // 90, 15)
    turn = min(minute % 90 // 30, 2)
    return GLYPH_EMOJI[block], turn + 1, GLYPH_NAMES[block]


ARROWS = {"A": "up", "B": "down", "C": "right", "D": "left"}
_typed = b""                       # what one read took beyond a single keypress


def read_key():
    """One keypress, with the arrows read whole.

    Straight off the descriptor rather than sys.stdin: an arrow is three bytes
    — ESC [ C — and a buffered reader can swallow all three on a one-character
    read, leaving select with nothing to say about the two behind it. A burst
    that arrives together (an arrow held down) is peeled one key at a time.

    Returns "up", "down", "left" or "right" for the arrows, the character for
    anything else, "\x1b" for escape pressed on its own, and "" for a sequence
    this does not know — a function key should not stop a block.
    """
    global _typed
    if not _typed:
        _typed = os.read(sys.stdin.fileno(), 32)
        if not _typed:
            return "q"                           # end of input, nothing more coming
    data, _typed = _typed, b""

    if data[:1] != b"\x1b":
        text = data.decode("utf-8", "replace")
        _typed = text[1:].encode()
        return text[0]
    if len(data) == 1:
        return "\x1b"

    at = 2                                       # past the ESC and its [ or O
    while at < len(data) and chr(data[at]) not in "ABCDEFHPQRS~":
        at += 1
    head, _typed = data[: at + 1], data[at + 1:]
    if head[1:2] in (b"[", b"O") and chr(head[-1]) in ARROWS:
        return ARROWS[chr(head[-1])]
    return ""


def unread():
    """Whether a burst already taken off the descriptor still holds a key.

    select has nothing to say about it — those bytes are out of the kernel
    already — so the countdown asks this before deciding it has nothing to do.
    """
    return bool(_typed)


def line(x0, y0, x1, y1):
    """Bresenham, so a dendrite between two cells is a run of adjacent cells."""
    points = []
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
    err = dx + dy
    while True:
        points.append((x0, y0))
        if x0 == x1 and y0 == y1:
            return points
        step = 2 * err
        if step >= dy:
            err += dy
            x0 += sx
        if step <= dx:
            err += dx
            y0 += sy


def easter_sunday(year):
    """Easter moves, so it has to be computed: Meeus's Gregorian algorithm.

    The first Sunday after the first full moon on or after the equinox, by the
    church's own reckoning of both.
    """
    a = year % 19
    b, c = divmod(year, 100)
    d, e = divmod(b, 4)
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = divmod(c, 4)
    moon = (32 + 2 * e + 2 * i - h - k) % 7
    correction = (a + 11 * h + 22 * moon) // 451
    month = (h + moon - 7 * correction + 114) // 31
    day = (h + moon - 7 * correction + 114) % 31 + 1
    return date(year, month, day)


class Canvas:
    """A grid of characters, each with its own colour, written out in one go.

    Sprites are painted with spaces transparent, so a fish passes behind the
    clock rather than punching a hole through the scene.
    """

    def __init__(self, cols, rows, colour=True):
        self.cols, self.rows = cols, rows
        self.colour = colour
        self.chars = [[" "] * cols for _ in range(rows)]
        self.tints = [[""] * cols for _ in range(rows)]

    def put(self, x, y, text, tint="", opaque=False):
        # floor, not int: a sprite drawn at y and a mark put at y + 1 have to
        # agree about which row that is, and truncation does not for y < 0.
        x, y = math.floor(x), math.floor(y)
        if not 0 <= y < self.rows:
            return
        chars, tints = self.chars[y], self.tints[y]
        for i, ch in enumerate(text):
            col = x + i
            if not 0 <= col < self.cols or (ch == " " and not opaque):
                continue
            chars[col] = ch
            tints[col] = tint if self.colour else ""

    def sprite(self, x, y, art, tint="", opaque=False):
        for dy, line in enumerate(art):
            self.put(x, math.floor(y) + dy, line, tint, opaque)

    def lines(self):
        out = []
        for y in range(self.rows):
            chars, tints = self.chars[y], self.tints[y]
            end = self.cols
            while end and chars[end - 1] == " ":
                end -= 1
            parts, current = [], ""
            for x in range(end):
                if tints[x] != current:
                    current = tints[x]
                    parts.append(RESET + current if current else RESET)
                parts.append(chars[x])
            if current:
                parts.append(RESET)
            out.append("".join(parts))
        return out


class Sprite:
    __slots__ = ("art", "tint", "x", "y", "vx", "vy", "born", "kind",
                 "phase", "timer", "flip")

    def __init__(self, art, tint, x, y, vx=0.0, vy=0.0, kind="", flip=False):
        self.art, self.tint = art, tint
        self.x, self.y, self.vx, self.vy = float(x), float(y), vx, vy
        self.born = 0.0
        self.kind = kind
        self.phase = ""                    # for anything that runs a little routine
        self.timer = 0.0
        self.flip = flip                   # art was mirrored, so new frames must be too

    def move(self, dt):
        self.x += self.vx * dt
        self.y += self.vy * dt

    @property
    def width(self):
        return max(len(line) for line in self.art)


class Theme:
    """The default: an empty stage, nothing behind the clock."""

    name = "plain"
    blurb = "just the goal, the clock and the bar"
    seasonal = False                   # see in_season: some themes keep to a date

    @staticmethod
    def in_season(today=None):
        return True

    def __init__(self):
        self.last = None
        self.total = 1500.0            # length of the block, set by countdown()

    def tick(self, now):
        """Seconds since the previous frame, clamped so a stall cannot jump."""
        dt = 0.0 if self.last is None else min(0.3, now - self.last)
        self.last = now
        return dt

    def draw(self, canvas, now):
        pass

    @staticmethod
    def advance(canvas, sprites, dt, cols, rows=None):
        """Move a pool of crossing sprites, drop what has left, draw the rest."""
        for sprite in list(sprites):
            sprite.move(dt)
            off = (sprite.vx >= 0 and sprite.x > cols + 2) or \
                  (sprite.vx < 0 and sprite.x + sprite.width < 0)
            if rows is not None and not off:
                off = sprite.y + len(sprite.art) < 0 or sprite.y > rows
            if off:
                sprites.remove(sprite)
                continue
            canvas.sprite(sprite.x, sprite.y, sprite.art, sprite.tint)


class Aquarium(Theme):
    name = "aquarium"
    blurb = ("fish, seaweed and a smoking volcano, with a crab or a squid now "
             "and then and one blue whale a block")

    SAND = rgb(125, 105, 75)
    WEED = rgb(40, 150, 95)
    BUBBLE = rgb(110, 165, 200)
    CRAB = rgb(225, 95, 80)
    SQUID = rgb(195, 130, 220)

    FISH = [
        (["><>"], rgb(110, 200, 220)),
        (["><(((°>"], rgb(235, 145, 65)),
        (["  /\\", "><(((°>", "  \\/"], rgb(240, 200, 90)),
        (["><}}}*>"], rgb(205, 125, 205)),
        (["<>>><"], rgb(150, 180, 240)),
    ]
    ROCK = rgb(92, 80, 86)
    EMBER = rgb(200, 95, 55)
    LAVA = rgb(252, 180, 70)
    ASH = rgb(105, 105, 122)
    WHALE_BLUE = rgb(80, 120, 205)

    VOLCANO = ["  /\\_/\\", " /     \\", "/_______\\"]
    WHALE = [
        "                     /\\",
        "  \\/   ____________/  \\___________",
        "   \\__/                           \\__",
        "   /        o                         >",
        "  /\\______________________________.--/",
    ]
    CRAB_FRAMES = [["(\\/)o,,o(\\/)"], ["(/\\)o,,o(/\\)"]]
    SQUID_FRAMES = [[" .--.", "(o  o)", " ;||;"], [" .--.", "(o  o)", " ;)(;"]]

    def __init__(self):
        Theme.__init__(self)
        self.fish, self.bubbles = [], []
        self.visitor = None
        self.weeds, self.weed_cols = [], 0
        self.next_fish = 0.0
        self.next_bubble = 0.0
        self.next_visitor = 25.0
        self.cone, self.vent = None, []
        self.next_puff = 0.0
        self.next_eruption = 0.0
        self.erupting = 0.0
        self.whale, self.whale_at = None, None
        self.started = None

    # --- the tank itself ---

    def _plant(self, cols, floor):
        """Seaweed stays where it grew, so it is only re-sown on a resize."""
        if cols == self.weed_cols:
            return
        self.weed_cols = cols
        self.cone = random.choice((cols // 7, cols - cols // 4)) if cols >= 26 else None
        self.weeds = []
        for x in range(1, cols - 1, 5):
            if self.cone is not None and self.cone - 2 <= x <= self.cone + 10:
                continue                             # nothing grows on the volcano
            if random.random() < 0.55:
                self.weeds.append((x + random.randint(0, 3),
                                   random.randint(3, max(4, min(9, floor - 4))),
                                   random.uniform(0, 6.3),
                                   random.uniform(0.6, 1.4)))

    def _floor(self, canvas, floor):
        """A sparse, stable scatter of sand — the crab needs something to walk on."""
        sand = "".join("." if (x * 7) % 13 == 0 else ("," if (x * 5) % 17 == 0 else " ")
                       for x in range(canvas.cols))
        canvas.put(0, floor, sand, self.SAND)

    def _seaweed(self, canvas, now, floor):
        for x, height, phase, speed in self.weeds:
            for i in range(height):
                lean = math.sin(now * speed + phase + i * 0.55)
                canvas.put(x + (1 if lean > 0.6 else 0), floor - 1 - i,
                           ")" if lean > 0 else "(", self.WEED)

    # --- what lives in it ---

    def _spawn_fish(self, cols, rows, anywhere=False):
        art, tint = random.choice(self.FISH)
        height = len(art)
        if rows - 3 <= 1:
            return
        y = random.randint(1, max(1, rows - 3 - height))
        speed = random.uniform(2.5, 4.0) if height > 1 else random.uniform(3.0, 7.5)
        if random.random() < 0.5:
            x = random.uniform(0, cols) if anywhere else -len(max(art, key=len)) - 1
            self.fish.append(Sprite(art, tint, x, y, speed))
        else:
            art = mirror(art)
            x = random.uniform(0, cols) if anywhere else cols + 1
            self.fish.append(Sprite(art, tint, x, y, -speed))

    def _fish(self, canvas, dt, now, cols, rows):
        if now >= self.next_fish and len(self.fish) < 7:
            self._spawn_fish(cols, rows)
            self.next_fish = now + random.uniform(2.5, 7.0)
        for fish in list(self.fish):
            fish.move(dt)
            if fish.vx > 0 and fish.x > cols or fish.vx < 0 and fish.x + fish.width < 0:
                self.fish.remove(fish)
                continue
            canvas.sprite(fish.x, fish.y, fish.art, fish.tint)

    def _bubbles(self, canvas, dt, now, cols, rows):
        if now >= self.next_bubble and len(self.bubbles) < 14:
            self.bubbles.append(Sprite(["."], self.BUBBLE,
                                       random.randint(1, max(1, cols - 2)), rows - 2,
                                       random.uniform(-0.6, 0.6),
                                       -random.uniform(2.5, 5.0)))
            self.next_bubble = now + random.uniform(0.4, 1.6)
        for bubble in list(self.bubbles):
            bubble.move(dt)
            if bubble.y < 0:
                self.bubbles.remove(bubble)
                continue
            canvas.put(bubble.x, bubble.y, "oO."[int(bubble.y) % 3], bubble.tint)

    def _visitor(self, canvas, dt, now, cols, rows):
        """A crab along the floor or a squid rising through the tank, rarely."""
        if self.visitor is None:
            if now < self.next_visitor:
                return
            if random.random() < 0.6:
                speed = random.uniform(1.2, 2.2)
                art = self.CRAB_FRAMES[0]
                if random.random() < 0.5:
                    self.visitor = Sprite(art, self.CRAB, -12, rows - 1, speed, kind="crab")
                else:
                    self.visitor = Sprite(art, self.CRAB, cols, rows - 1, -speed, kind="crab")
            else:
                self.visitor = Sprite(self.SQUID_FRAMES[0], self.SQUID,
                                      random.randint(2, max(2, cols - 8)), rows - 3,
                                      random.uniform(-0.8, 0.8),
                                      -random.uniform(1.1, 1.8), kind="squid")
            self.visitor.born = now

        guest = self.visitor
        guest.move(dt)
        if guest.kind == "crab":
            guest.art = self.CRAB_FRAMES[int(now * 3) % 2]
            canvas.sprite(guest.x, rows - 1 - (len(guest.art) - 1), guest.art, guest.tint)
            gone = guest.x > cols if guest.vx > 0 else guest.x + guest.width < 0
        else:
            guest.art = self.SQUID_FRAMES[int(now * 2.5) % 2]
            canvas.sprite(guest.x, guest.y, guest.art, guest.tint)
            gone = guest.y + len(guest.art) < 0
        if gone:
            self.visitor = None
            self.next_visitor = now + random.uniform(45.0, 100.0)

    def _volcano(self, canvas, dt, now, rows):
        """It smokes all block, and lets go properly every couple of minutes."""
        if self.cone is None:
            return
        x, floor = self.cone, rows - 1
        if now >= self.next_eruption:
            self.erupting = now + random.uniform(4.0, 8.0)
            self.next_eruption = self.erupting + random.uniform(70.0, 150.0)
        blowing = now < self.erupting

        if now >= self.next_puff:
            hot = blowing and random.random() < 0.8
            mote = Sprite(["*"], self.LAVA, x + 4, floor - 3, random.uniform(-0.7, 0.7),
                          -random.uniform(4.0, 7.0) if hot else -random.uniform(1.4, 2.6),
                          kind="lava" if hot else "ash")
            mote.born = now
            self.vent.append(mote)
            self.next_puff = now + (random.uniform(0.03, 0.1) if blowing
                                    else random.uniform(0.5, 1.5))
        for mote in list(self.vent):
            mote.move(dt)
            age = now - mote.born
            if mote.y < 0 or age > 14.0:
                self.vent.remove(mote)
                continue
            if mote.kind == "lava" and age < 0.7:     # thrown out glowing, then cooling
                char, tint = "*", self.LAVA
            elif mote.kind == "lava" and age < 1.8:
                char, tint = "o", self.EMBER
            else:
                char, tint = ("." if age > 4.0 else "°"), self.ASH
            canvas.put(mote.x, mote.y, char, tint)

        canvas.sprite(x, floor - 2, self.VOLCANO, self.ROCK, opaque=True)
        canvas.put(x + 4, floor - 2, "^" if blowing else "_",
                   self.LAVA if blowing else
                   self.EMBER if math.sin(now * 2.2) > 0 else self.ROCK)

    def _whale(self, canvas, dt, now, cols, rows):
        """One crossing per block, somewhere in the middle of it."""
        if self.whale is None:
            if self.whale_at is None or now < self.whale_at or cols < 30 or rows < 10:
                return
            self.whale_at = None                      # and never a second time
            heading = random.choice((-1, 1))
            art = self.WHALE if heading > 0 else mirror(self.WHALE)
            span = max(len(row) for row in art)
            self.whale = Sprite(art, self.WHALE_BLUE,
                                -span - 2 if heading > 0 else cols + 2,
                                random.randint(1, max(1, rows - len(art) - 3)),
                                heading * random.uniform(2.5, 4.0))
            self.whale.born = now

        whale = self.whale
        whale.move(dt)
        if (whale.vx > 0 and whale.x > cols + 2) or (whale.vx < 0 and whale.x + whale.width < 0):
            self.whale = None
            return
        canvas.sprite(whale.x, whale.y, whale.art, whale.tint)
        if random.random() < 0.15:                    # a breath from the blowhole
            blow = whale.x + (21 if whale.vx > 0 else whale.width - 22)
            self.bubbles.append(Sprite(["."], self.BUBBLE, blow, whale.y,
                                       random.uniform(-0.3, 0.3),
                                       -random.uniform(2.0, 3.5)))

    def draw(self, canvas, now):
        dt = self.tick(now)
        if self.started is None:
            self.started = now
            self.next_visitor = now + random.uniform(20.0, 50.0)
            self.next_eruption = now + random.uniform(15.0, 60.0)
            span = max(20.0, self.total)
            self.whale_at = now + (random.uniform(5.0, 20.0) if span < 60.0
                                   else random.uniform(0.15, 0.7) * span)
            for _ in range(4):
                self._spawn_fish(canvas.cols, canvas.rows, anywhere=True)
        cols, rows, floor = canvas.cols, canvas.rows, canvas.rows - 1
        self._plant(cols, floor)
        self._floor(canvas, floor)
        self._seaweed(canvas, now, floor)
        self._bubbles(canvas, dt, now, cols, rows)
        self._fish(canvas, dt, now, cols, rows)
        self._visitor(canvas, dt, now, cols, rows)
        self._whale(canvas, dt, now, cols, rows)
        self._volcano(canvas, dt, now, rows)


class Airport(Theme):
    name = "airport"
    blurb = "a terminal below, departures, arrivals and helicopters over it"

    GROUND = rgb(110, 120, 140)
    TARMAC = rgb(80, 88, 105)
    GLASS = rgb(150, 190, 220)
    PLANE = rgb(220, 225, 235)
    TAIL = rgb(99, 102, 241)
    CLOUD = rgb(140, 155, 180)
    TUG = rgb(210, 200, 120)

    JET = [
        "      |\\",
        "  ____|_\\____",
        "  \\___o____o__>",
    ]
    PROP = [
        "   |\\",
        " __|_\\__",
        " \\__o___>",
    ]
    HELI = ["  --o--", "+=[___]>", "   ^ ^"]
    ROTOR = ["  --o--", "  -=o=-"]
    TUG_ART = ["[oo]="]

    def __init__(self):
        Theme.__init__(self)
        self.traffic, self.clouds = [], []
        self.next_movement = 0.0
        self.next_tug = 30.0
        self.next_cloud = 0.0
        self.started = None

    # --- the field ---

    def _field(self, canvas, now):
        cols, rows = canvas.cols, canvas.rows
        runway, apron = rows - 1, rows - 2

        canvas.put(0, runway, "━" * cols, self.TARMAC)
        for x in range(3, cols, 9):                      # edge lights, blinking
            lit = (int(now * 1.5) + x // 9) % 4 != 0
            canvas.put(x, runway, "╹" if lit else "╷", AMBER if lit else self.TARMAC)

        width = max(16, min(34, cols // 3))
        if cols < 26 or rows < 12:
            return
        top = apron - 3
        canvas.put(1, top, "╭" + "─" * (width - 2) + "╮", self.GROUND)
        windows = "".join("▫ " if i % 2 == 0 else "  " for i in range((width - 4) // 2))
        canvas.put(1, top + 1, "│ ", self.GROUND)
        canvas.put(3, top + 1, windows[: width - 4], self.GLASS)
        canvas.put(width - 1, top + 1, "│", self.GROUND)
        canvas.put(1, top + 2, "╰" + "─" * (width - 2) + "╯", self.GROUND)

        tower = width + 4
        if tower + 4 < cols and rows >= 16:   # a short terminal has no room for it
            beacon = int(now * 1.2) % 2
            canvas.put(tower + 1, top - 3, "•", GREEN if beacon else AMBER)
            canvas.put(tower, top - 2, "╭─╮", self.GROUND)
            canvas.put(tower, top - 1, "│▫│", self.GLASS)
            canvas.put(tower, top, "╰┬╯", self.GROUND)
            for y in range(top + 1, apron + 1):
                canvas.put(tower + 1, y, "│", self.GROUND)

    # --- the traffic ---

    def _helicopter(self, cols, rows):
        """In from one side, down onto the apron, a pause, then up and away."""
        flip = random.random() < 0.5
        art = mirror(self.HELI) if flip else self.HELI
        speed = random.uniform(5.0, 8.0)
        heli = Sprite(art, self.PLANE, cols + 2 if flip else -10,
                      random.randint(2, max(2, rows // 3)),
                      -speed if flip else speed, 0.0, kind="helicopter", flip=flip)
        heli.phase = "inbound"
        heli.timer = cols * random.uniform(0.5, 0.75)    # where the pad is
        return heli

    def _movement(self, cols, rows):
        """A departure rolling out and climbing, or an arrival coming down."""
        if random.random() < 0.3:
            return self._helicopter(cols, rows)
        art = self.JET if random.random() < 0.7 else self.PROP
        ground = rows - 1 - len(art)
        if random.random() < 0.5:
            plane = Sprite(art, self.PLANE, -len(max(art, key=len)) - 2, ground,
                           random.uniform(7.0, 10.0), kind="departure")
        else:
            speed = random.uniform(9.0, 13.0)
            plane = Sprite(mirror(art), self.PLANE, cols + 2, 1, -speed, 0.0, kind="arrival")
            # Descend so the wheels meet the tarmac about two thirds of the way across.
            plane.vy = (ground - 1) / (cols * 0.66 / speed)
        return plane

    def _traffic(self, canvas, dt, now, cols, rows):
        if now >= self.next_movement and len(self.traffic) < 3:
            self.traffic.append(self._movement(cols, rows))
            self.next_movement = now + random.uniform(7.0, 16.0)
        if now >= self.next_tug:                         # something on the apron
            heading = random.choice((-1, 1))
            art = self.TUG_ART if heading > 0 else mirror(self.TUG_ART)
            self.traffic.append(Sprite(art, self.TUG, -6 if heading > 0 else cols + 2,
                                       rows - 2, heading * random.uniform(3.0, 5.0),
                                       kind="tug"))
            self.next_tug = now + random.uniform(25.0, 60.0)

        for plane in list(self.traffic):
            plane.move(dt)
            wheels = rows - 1 - len(plane.art)
            if plane.kind == "departure":
                plane.vx = min(plane.vx + 4.0 * dt, 18.0)
                if plane.x > cols * 0.4:                 # rotate, then climb away
                    plane.vy = -3.0
            elif plane.kind == "arrival":
                if plane.y >= wheels:                    # touchdown, then roll out
                    plane.y, plane.vy = wheels, 0.0
                    plane.vx = min(plane.vx + 6.0 * dt, -3.0)
            elif plane.kind == "helicopter":
                frame = self.ROTOR[int(now * 9) % 2]
                plane.art = [mirror([frame])[0] if plane.flip else frame] + plane.art[1:]
                if plane.phase == "inbound" and abs(plane.x - plane.timer) < 2.5:
                    plane.vx, plane.vy, plane.phase = 0.0, 2.6, "descending"
                elif plane.phase == "descending" and plane.y >= wheels:
                    plane.y, plane.vy = wheels, 0.0
                    plane.phase, plane.timer = "parked", now + random.uniform(4.0, 9.0)
                elif plane.phase == "parked" and now >= plane.timer:
                    plane.vy, plane.phase = -2.2, "lifting"
                elif plane.phase == "lifting" and plane.y <= 2:
                    plane.vy = 0.0
                    plane.vx = -6.0 if plane.flip else 6.0
                    plane.phase = "outbound"

            gone_right = plane.vx > 0 and plane.x > cols + 2
            gone_left = plane.vx < 0 and plane.x + plane.width < 0
            if gone_right or gone_left or plane.y + len(plane.art) < 0:
                self.traffic.remove(plane)
                continue

            # The top line of a plane is its tail fin, and wears the tail colour.
            if plane.kind == "helicopter":
                canvas.sprite(plane.x, plane.y, plane.art, plane.tint)
            elif len(plane.art) > 1:
                canvas.put(plane.x, plane.y, plane.art[0], self.TAIL)
                canvas.sprite(plane.x, plane.y + 1, plane.art[1:], plane.tint)
            else:
                canvas.sprite(plane.x, plane.y, plane.art, plane.tint)

    def _clouds(self, canvas, dt, now, cols, rows):
        if now >= self.next_cloud and len(self.clouds) < 3:
            self.clouds.append(Sprite([" .--.", "(    )"], self.CLOUD,
                                      -7, random.randint(0, max(0, rows // 3)),
                                      random.uniform(0.5, 1.3)))
            self.next_cloud = now + random.uniform(18.0, 40.0)
        for cloud in list(self.clouds):
            cloud.move(dt)
            if cloud.x > cols:
                self.clouds.remove(cloud)
                continue
            canvas.sprite(cloud.x, cloud.y, cloud.art, cloud.tint)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_movement = now + 1.0
            self.next_tug = now + random.uniform(15.0, 40.0)
            for i in range(2):
                self.clouds.append(Sprite([" .--.", "(    )"], self.CLOUD,
                                          random.randint(0, cols), random.randint(0, rows // 3),
                                          random.uniform(0.5, 1.3)))
            self.next_cloud = now + random.uniform(15.0, 30.0)
        self._clouds(canvas, dt, now, cols, rows)
        self._field(canvas, now)
        self._traffic(canvas, dt, now, cols, rows)


class Space(Theme):
    name = "space"
    blurb = "a twinkling starfield, a ringed planet, rockets and comets"

    FAR = rgb(120, 128, 155)
    NEAR = rgb(215, 220, 240)
    PLANET = rgb(205, 145, 95)
    HULL = rgb(225, 228, 238)
    PANEL = rgb(120, 150, 210)
    COMET = rgb(165, 215, 255)
    FLAME = rgb(250, 160, 60)

    PLANET_ART = ["    .--.", " -=(    )=-", "    '--'"]
    ROCKET = [" /|", "(====>", " \\|"]
    SATELLITE = ["[#]-o-[#]"]
    COMET_ART = [".·-=o"]

    def __init__(self):
        Theme.__init__(self)
        self.stars, self.sky = [], (0, 0)
        self.craft = []
        self.next_craft = 0.0
        self.started = None

    def _starfield(self, canvas, now):
        cols, rows = canvas.cols, canvas.rows
        if (cols, rows) != self.sky:                     # stars keep their places
            self.sky = (cols, rows)
            self.stars = []
            for _ in range((cols * rows) // 22):
                self.stars.append((random.randrange(cols), random.randrange(rows),
                                   random.uniform(0, 6.3), random.random()))
        for x, y, phase, size in self.stars:
            twinkle = math.sin(now * 1.6 + phase)
            if size > 0.93:
                char, tint = ("+" if twinkle > 0 else "*"), self.NEAR
            elif size > 0.6:
                char, tint = ("·" if twinkle > -0.4 else "*"), self.NEAR
            else:
                char, tint = ".", self.FAR
            canvas.put(x, y, char, tint)

    def _launch(self, cols, rows):
        kind = random.random()
        y = random.randint(1, max(1, rows - 4))
        if kind < 0.45:
            art, speed = self.ROCKET, random.uniform(6.0, 11.0)
            craft = Sprite(art, self.HULL, -8, y, speed, -random.uniform(0.0, 0.5),
                           kind="rocket")
        elif kind < 0.8:
            art, speed = self.SATELLITE, random.uniform(1.5, 3.0)
            craft = Sprite(art, self.PANEL, -10, y, speed, 0.0, kind="satellite")
        else:
            craft = Sprite(self.COMET_ART, self.COMET, cols + 4, random.randint(0, rows // 2),
                           -random.uniform(22.0, 34.0), random.uniform(1.5, 3.0), kind="comet")
        if craft.vx > 0 and random.random() < 0.5:       # half of them fly the other way
            craft.art = mirror(craft.art)
            craft.x, craft.vx = cols + 4, -craft.vx
        return craft

    def _traffic(self, canvas, dt, now, cols, rows):
        if now >= self.next_craft and len(self.craft) < 2:
            self.craft.append(self._launch(cols, rows))
            self.next_craft = now + random.uniform(11.0, 26.0)
        for craft in list(self.craft):
            if craft.kind == "rocket":                   # exhaust, trailing the fins
                tail = craft.x - 2 if craft.vx > 0 else craft.x + craft.width
                canvas.put(tail, craft.y + 1, "≈~-"[int(now * 12) % 3] * 2, self.FLAME)
            elif craft.kind == "satellite":
                canvas.put(craft.x + 4, craft.y - 1, "•" if int(now * 2) % 2 else " ",
                           GREEN)
        self.advance(canvas, self.craft, dt, cols, rows)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_craft = now + random.uniform(2.0, 8.0)
        self._starfield(canvas, now)
        if cols > 40 and rows > 10:
            canvas.sprite(cols - 14, 1, self.PLANET_ART, self.PLANET, opaque=True)
        self._traffic(canvas, dt, now, cols, rows)


class Farm(Theme):
    name = "farm"
    blurb = "barn, silo and turning windmill, hens in the yard, a tractor going by"

    SUN = rgb(250, 205, 90)
    CLOUD = rgb(205, 210, 220)
    BARN = rgb(190, 75, 60)
    ROOF = rgb(140, 55, 45)
    SILO = rgb(175, 180, 190)
    TIMBER = rgb(165, 135, 100)
    GRASS = rgb(120, 175, 85)
    WHEAT = rgb(220, 190, 105)
    HEN = rgb(240, 238, 228)
    COMB = rgb(220, 80, 70)
    COW = rgb(235, 235, 235)
    TRACTOR = rgb(95, 155, 75)
    SMOKE = rgb(150, 150, 160)

    BARN_ART = ["   _____", "  /     \\", " /_______\\", " |  ___  |", " |_|___|_|"]
    SILO_ART = [" ___ ", "(   )", "|   |", "|   |", "|___|"]
    BLADES = [[" \\ /", "  o  ", " / \\"], ["  |  ", " -o- ", "  |  "]]
    HEN_ART = [[" ,", "(°>", " ^"], [" ,", "(°_", " ^"]]
    COW_ART = ["  ^__^", " (oo)\\___", " (__)   )"]
    TRACTOR_ART = ["   __", "  |__|_", " (O)_(o)"]
    BIRD = [["~^~"], ["~v~"]]

    def __init__(self):
        Theme.__init__(self)
        self.crop, self.sown, self.fence = [], 0, (1, 10)
        self.hens, self.sky, self.yard = [], [], []
        self.next_tractor = 0.0
        self.next_bird = 0.0
        self.cow_x = 0
        self.started = None

    def _sow(self, cols, rows):
        if cols == self.sown:
            return
        self.sown = cols
        self.crop = [(x, random.uniform(0, 6.3)) for x in range(0, cols, 2)
                     if random.random() < 0.8]
        self.cow_x = random.randint(cols // 2, max(cols // 2, cols - 12))
        # The yard is the open ground between the silo and the windmill.
        self.fence = (20, max(24, cols - 11)) if cols >= 34 else (1, max(4, cols - 5))
        self.hens = []
        for _ in range(3):
            self.hens.append(Sprite(self.HEN_ART[0], self.HEN,
                                    random.randint(*self.fence), rows - 5,
                                    random.choice((-1, 1)) * random.uniform(1.0, 2.2),
                                    kind="hen"))

    def _field(self, canvas, now, cols, rows):
        for x, phase in self.crop:                       # wheat, leaning in the wind
            lean = math.sin(now * 1.1 + phase + x * 0.12)
            canvas.put(x, rows - 2, "*" if lean > 0 else "v", self.WHEAT)
            canvas.put(x, rows - 1, "|", self.WHEAT if lean > 0.7 else self.GRASS)

    def _buildings(self, canvas, now, cols, rows):
        base = rows - 3                                  # everything stands on the yard
        if rows < 12 or cols < 34:
            return
        top = base - len(self.BARN_ART) + 1
        canvas.sprite(2, top, self.BARN_ART[:3], self.ROOF, opaque=True)
        canvas.sprite(2, top + 3, self.BARN_ART[3:], self.BARN, opaque=True)
        canvas.sprite(13, base - len(self.SILO_ART) + 1, self.SILO_ART, self.SILO, opaque=True)

        mill = cols - 9
        canvas.sprite(mill, base - 5, self.BLADES[int(now * 5) % 2], self.TIMBER)
        for y in range(base - 2, base + 1):
            canvas.put(mill + 2, y, "║", self.TIMBER)
        canvas.put(mill + 1, base, "╱╲", self.TIMBER)

        post = self.fence[0]
        while post < mill - 2:                           # a rail between yard and field
            canvas.put(post, base, "─┼──", self.TIMBER)
            post += 4

    def _stock(self, canvas, dt, now, cols, rows):
        canvas.sprite(self.cow_x, rows - 5, self.COW_ART, self.COW, opaque=True)
        canvas.put(self.cow_x - 1, rows - 4, "\\" if int(now * 1.5) % 2 else "/", self.COW)

        for hen in self.hens:
            hen.move(dt)
            left, right = self.fence
            if hen.x < left or hen.x > right:            # turn round at the yard edge
                hen.vx = -hen.vx
                hen.art = mirror(hen.art)
                hen.x = min(max(hen.x, left), right)
            pecking = math.sin(now * 2.0 + hen.y + hen.x * 0.1) > 0.75
            art = self.HEN_ART[1 if pecking else 0]
            if hen.vx < 0:
                art = mirror(art)
            canvas.sprite(hen.x, hen.y, art, hen.tint)
            canvas.put(hen.x + (1 if hen.vx > 0 else 0), hen.y, ",", self.COMB)

        if now >= self.next_tractor:
            heading = random.choice((-1, 1))
            art = self.TRACTOR_ART if heading > 0 else mirror(self.TRACTOR_ART)
            self.yard.append(Sprite(art, self.TRACTOR, -10 if heading > 0 else cols + 2,
                                    rows - 5, heading * random.uniform(4.0, 7.0),
                                    kind="tractor"))
            self.next_tractor = now + random.uniform(30.0, 70.0)
        for machine in self.yard:
            canvas.put(machine.x + (3 if machine.vx > 0 else machine.width - 4),
                       machine.y - 1, "o°·"[int(now * 4) % 3], self.SMOKE)
        self.advance(canvas, self.yard, dt, cols)

        if now >= self.next_bird and len(self.sky) < 3:
            heading = random.choice((-1, 1))
            self.sky.append(Sprite(self.BIRD[0], self.SMOKE,
                                   -4 if heading > 0 else cols + 2,
                                   random.randint(1, max(1, rows // 3)),
                                   heading * random.uniform(5.0, 9.0)))
            self.next_bird = now + random.uniform(8.0, 20.0)
        for bird in self.sky:
            bird.art = self.BIRD[int(now * 5) % 2]
        self.advance(canvas, self.sky, dt, cols)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_tractor = now + random.uniform(10.0, 30.0)
        self._sow(cols, rows)
        if cols > 30:
            canvas.sprite(cols - 7, 0, [" \\|/", "-(_)-", " /|\\"], self.SUN)
        self._field(canvas, now, cols, rows)
        self._buildings(canvas, now, cols, rows)
        self._stock(canvas, dt, now, cols, rows)



class Matrix(Theme):
    name = "matrix"
    blurb = "glyph rain down the columns, bright at the head, fading behind"

    HEAD = rgb(215, 255, 215)
    BODY = rgb(60, 220, 90)
    TRAIL = rgb(22, 110, 45)
    RAIN = ("ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ"
            "0123456789:=*+-<>|")

    def __init__(self):
        Theme.__init__(self)
        self.drops, self.width = {}, 0

    def _drop(self, rows, high=True):
        length = random.randint(4, max(5, rows - 6))
        return [-random.uniform(0, rows if high else rows // 3),
                random.uniform(5.0, 20.0),
                [random.choice(self.RAIN) for _ in range(length)]]

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if cols != self.width:
            self.width = cols
            self.drops = {x: self._drop(rows) for x in range(cols) if random.random() < 0.75}
        for x, drop in self.drops.items():
            drop[0] += drop[1] * dt
            chars = drop[2]
            if random.random() < 0.3:                    # glyphs flicker as they fall
                chars[random.randrange(len(chars))] = random.choice(self.RAIN)
            head = int(drop[0])
            for i, char in enumerate(chars):
                y = head - i
                if 0 <= y < rows:
                    canvas.put(x, y, char,
                               self.HEAD if i == 0 else
                               self.BODY if i < 4 else self.TRAIL)
            if head - len(chars) > rows:
                self.drops[x] = self._drop(rows, high=False)


class Neurons(Theme):
    name = "neurons"
    blurb = "cells wired into a net, pulses running the dendrites, one firing at a time"

    WIRE = rgb(58, 66, 105)
    CELL = rgb(130, 140, 190)
    FIRING = rgb(240, 230, 255)
    PULSE = rgb(140, 200, 255)

    def __init__(self):
        Theme.__init__(self)
        self.cells, self.wires, self.size = [], [], (0, 0)
        self.pulses, self.lit = [], {}
        self.next_spark = 0.0

    @staticmethod
    def _gap(here, there):
        """Distance between two cells, with rows counted double.

        A cell is about twice as tall as it is wide, so plain coordinates call
        a cable two rows up shorter than one four columns across when it is
        drawn longer.
        """
        return (there[0] - here[0]) ** 2 + ((there[1] - here[1]) * 2) ** 2

    def _wire(self, cols, rows):
        """Scatter cells, wire each to its two nearest, then join up the rest."""
        self.size = (cols, rows)
        self.cells, self.wires, self.pulses, self.lit = [], [], [], {}
        tries = 0
        while len(self.cells) < max(8, min(26, cols * rows // 70)) and tries < 600:
            tries += 1
            spot = (random.randrange(2, max(3, cols - 2)), random.randrange(1, max(2, rows - 1)))
            if all(abs(spot[0] - c[0]) + abs(spot[1] - c[1]) * 2 > 7 for c in self.cells):
                self.cells.append(spot)
        seen = set()
        for i, cell in enumerate(self.cells):
            def span(j, here=cell):
                return self._gap(here, self.cells[j])
            for j in sorted(range(len(self.cells)), key=span)[1:3]:
                pair = (min(i, j), max(i, j))
                if pair in seen or span(j) > 34 ** 2:    # no cables across the whole net
                    continue
                seen.add(pair)
                self._cable(i, j, seen)
        self._join(seen)

    def _cable(self, i, j, seen):
        seen.add((min(i, j), max(i, j)))
        self.wires.append((i, j, line(self.cells[i][0], self.cells[i][1],
                                      self.cells[j][0], self.cells[j][1])))

    def _join(self, seen):
        """Wire the islands together, until the net is one net.

        Nearest neighbours alone leave clusters, and sometimes a cell with
        nothing on it at all: a pulse started in one of them could never reach
        the others, so half the screen sits dark for the whole block. This
        takes the two closest cells that are not yet connected and cables
        them, over and over, until every cell can be reached from every other.
        A joining cable ignores the length limit above — a long dendrite is
        better than a piece of the net nothing ever lights.
        """
        home = list(range(len(self.cells)))

        def root(i):
            while home[i] != i:
                home[i] = home[home[i]]              # flatten as we go
                i = home[i]
            return i

        for a, b, _ in self.wires:
            home[root(a)] = root(b)
        while True:
            nearest = None
            for i in range(len(self.cells)):
                for j in range(i + 1, len(self.cells)):
                    if root(i) == root(j):
                        continue
                    gap = self._gap(self.cells[i], self.cells[j])
                    if nearest is None or gap < nearest[0]:
                        nearest = (gap, i, j)
            if nearest is None:                      # nothing left to join
                return
            _, i, j = nearest
            home[root(i)] = root(j)
            self._cable(i, j, seen)

    def _fire(self, cell, now, spread=True):
        self.lit[cell] = now
        if not spread:
            return
        for w, (a, b, path) in enumerate(self.wires):
            if cell in (a, b) and len(self.pulses) < 14 and random.random() < 0.65:
                self.pulses.append([w, 0.0, random.uniform(0.5, 1.1), cell == b])

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if (cols, rows) != self.size:
            self._wire(cols, rows)
        if not self.cells:
            return

        for _, _, path in self.wires:                    # the dendrites themselves
            run = (path[-1][0] - path[0][0], path[-1][1] - path[0][1])
            char = ("-" if abs(run[1]) * 2 < abs(run[0]) else
                    "|" if abs(run[0]) < abs(run[1]) else
                    "\\" if run[0] * run[1] > 0 else "/")
            for x, y in path:
                canvas.put(x, y, char, self.WIRE)

        for pulse in list(self.pulses):                  # charge running along them
            pulse[1] += pulse[2] * dt
            path = self.wires[pulse[0]][2]
            if pulse[1] >= 1.0:
                self.pulses.remove(pulse)
                target = self.wires[pulse[0]][0 if pulse[3] else 1]
                self._fire(target, now, spread=random.random() < 0.7)
                continue
            where = pulse[1] if not pulse[3] else 1.0 - pulse[1]
            at = path[min(len(path) - 1, int(where * (len(path) - 1)))]
            canvas.put(at[0], at[1], "•", self.PULSE)

        for i, (x, y) in enumerate(self.cells):          # the cells, lit or resting
            age = now - self.lit.get(i, -9.9)
            if age < 0.5:
                canvas.put(x - 1, y, "(O)", self.FIRING)
            elif age < 1.2:
                canvas.put(x, y, "O", self.FIRING)
            else:
                canvas.put(x, y, "o", self.CELL)

        if now >= self.next_spark:                       # something has to start it
            self._fire(random.randrange(len(self.cells)), now)
            self.next_spark = now + random.uniform(1.5, 4.5)


class Galaxy(Theme):
    name = "galaxy"
    blurb = "a spiral galaxy turning slowly, arms of stars around a bright core"

    CORE = rgb(255, 246, 215)
    INNER = rgb(232, 200, 255)
    ARM = rgb(150, 170, 245)
    OUTER = rgb(96, 110, 180)
    FIELD = rgb(115, 122, 150)

    def __init__(self):
        Theme.__init__(self)
        self.stars, self.jitter, self.size = [], [], (0, 0)

    def _seed(self, cols, rows):
        self.size = (cols, rows)
        self.stars = [(random.randrange(cols), random.randrange(rows),
                       random.uniform(0, 6.3)) for _ in range((cols * rows) // 40)]
        self.jitter = [(random.uniform(-1.2, 1.2), random.uniform(-0.6, 0.6))
                       for _ in range(600)]

    def draw(self, canvas, now):
        self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if (cols, rows) != self.size:
            self._seed(cols, rows)

        for x, y, phase in self.stars:                   # the field it sits in
            canvas.put(x, y, "." if math.sin(now * 1.3 + phase) < 0.7 else "·", self.FIELD)

        cx, cy = cols * 0.71, rows * 0.32
        reach = min(cols / 3.1, rows / 1.55)
        spin = now * 0.07
        index = 0
        for arm in range(2):
            radius = 0.6
            while radius < reach:
                angle = spin + arm * math.pi + radius * 0.62
                wobble = self.jitter[index % len(self.jitter)]
                index += 1
                x = cx + math.cos(angle) * radius * 2.05 + wobble[0]
                y = cy + math.sin(angle) * radius + wobble[1]
                near = radius / reach
                canvas.put(x, y, "*" if near < 0.35 else "·" if near < 0.7 else ".",
                           self.INNER if near < 0.3 else
                           self.ARM if near < 0.72 else self.OUTER)
                radius += 0.12

        canvas.sprite(int(cx) - 2, int(cy) - 1,                      # the core
                      [" ·*· ", "*(@)*", " ·*· "], self.CORE, opaque=True)



class Haunted(Theme):
    name = "haunted"
    blurb = "a house on the hill, bats, a ghost and lightning (Halloween week)"
    seasonal = True

    @staticmethod
    def in_season(today=None):
        """The Monday-to-Sunday week that holds the 31st of October."""
        today = today or datetime.now().date()
        eve = date(today.year, 10, 31)
        monday = eve - timedelta(days=eve.weekday())
        return monday <= today <= monday + timedelta(days=6)

    MOON = rgb(238, 236, 214)
    CLOUD = rgb(78, 76, 98)
    WALL = rgb(62, 56, 78)
    ROOF = rgb(44, 40, 58)
    LIT = rgb(255, 178, 58)
    DARK = rgb(38, 34, 48)
    BAT = rgb(96, 86, 110)
    GHOST = rgb(205, 218, 238)
    PUMPKIN = rgb(246, 138, 40)
    TREE = rgb(74, 62, 62)
    STONE = rgb(122, 120, 134)
    FOG = rgb(84, 82, 100)
    BOLT = rgb(255, 255, 235)

    HOUSE = [
        "         /\\",
        "        /  \\",
        "     __/    \\__________",
        "    /                   \\",
        "   /_____________________\\",
        "   |                     |",
        "   |         ____        |",
        "   |        |    |       |",
        "   |________|____|_______|",
    ]
    WINDOWS = ((5, 5), (17, 5), (9, 3))      # offsets into the house
    MOON_ART = [" .---.", "(  °  )", " '---'"]
    TREE_ART = ["\\  |  /", " \\_|_/", "   |", "   |"]
    GRAVE = [" ___ ", "|RIP|"]
    BATS = [["\\^/"], ["/^\\"]]
    GHOST_ART = [" .--.", "( .. )", " )~~("]

    def __init__(self):
        Theme.__init__(self)
        self.bats, self.ghost = [], None
        self.clouds = []
        self.next_bat = 0.0
        self.next_ghost = 0.0
        self.next_bolt = 0.0
        self.flash = 0.0
        self.bolt = []
        self.site, self.built = None, 0
        self.started = None

    def _build(self, cols, rows):
        if cols == self.built:
            return
        self.built = cols
        self.site = max(2, int(cols * 0.42) - 12) if cols >= 34 and rows >= 15 else None
        self.clouds = [Sprite([" .--.", "(     )"], self.CLOUD,
                              random.randrange(cols), random.randint(0, max(0, rows // 4)),
                              random.uniform(0.4, 1.0)) for _ in range(2)]

    def _sky(self, canvas, dt, now, cols, rows):
        canvas.sprite(cols - 11, 1, self.MOON_ART, self.MOON, opaque=True)
        if now >= self.next_bat and len(self.bats) < 4:
            heading = random.choice((-1, 1))
            self.bats.append(Sprite(self.BATS[0], self.BAT,
                                    -4 if heading > 0 else cols + 2,
                                    random.randint(1, max(1, rows // 2)),
                                    heading * random.uniform(7.0, 14.0)))
            self.next_bat = now + random.uniform(2.0, 6.0)
        for bat in self.bats:                          # they never fly straight
            bat.art = self.BATS[int(now * 8 + bat.y) % 2]
            bat.vy = math.sin(now * 2.6 + bat.x * 0.2) * 3.0
        self.advance(canvas, self.bats, dt, cols, rows)
        for cloud in self.clouds:
            cloud.move(dt)
            if cloud.x > cols:
                cloud.x = -8.0
            canvas.sprite(cloud.x, cloud.y, cloud.art, cloud.tint)

    def _ground(self, canvas, now, cols, rows):
        if self.site is None:
            return
        x = self.site
        top = rows - len(self.HOUSE)
        bright = now < self.flash
        for gx in range(0, cols, 9):                   # fog rolling along the ground
            canvas.put(gx + int(math.sin(now * 0.6 + gx) * 3), rows - 1, "~~~", self.FOG)
        canvas.sprite(x, top, self.HOUSE[:5], self.BOLT if bright else self.ROOF, opaque=True)
        canvas.sprite(x, top + 5, self.HOUSE[5:], self.BOLT if bright else self.WALL,
                      opaque=True)
        for i, (dx, dy) in enumerate(self.WINDOWS):    # candles guttering inside
            flicker = math.sin(now * (3.1 + i) + i * 2.0) + math.sin(now * 7.3 + i)
            canvas.put(x + dx, top + dy, "██",
                       self.LIT if flicker > -0.4 else self.DARK)
        canvas.put(x + 13, top + 7, "·", self.LIT)     # the door handle

        pumpkin = x + 16
        canvas.put(pumpkin, rows - 1, "(^^)" if int(now * 3) % 4 else "(oo)", self.PUMPKIN)
        canvas.sprite(max(0, x - 12), rows - len(self.TREE_ART), self.TREE_ART,
                      self.BOLT if bright else self.TREE)
        for i, spot in enumerate((x - 20, x + 30)):
            if 0 <= spot < cols - 5:
                canvas.sprite(spot, rows - 2, self.GRAVE, self.STONE)

    def _ghost(self, canvas, dt, now, cols, rows):
        if self.ghost is None:
            if now < self.next_ghost:
                return
            # It comes off the roof, not out of the middle of the walls.
            start = self.site + 8 if self.site is not None else cols // 2
            roof = rows - len(self.HOUSE) - 3 if self.site is not None else rows - 6
            self.ghost = Sprite(self.GHOST_ART, self.GHOST, start, roof,
                                0.0, -random.uniform(1.0, 1.8), kind="ghost")
            self.ghost.born = now
        ghost = self.ghost
        ghost.vx = math.sin((now - ghost.born) * 1.4) * 4.0
        ghost.move(dt)
        age = now - ghost.born
        if ghost.y + len(ghost.art) < 0 or age > 24.0:
            self.ghost = None
            self.next_ghost = now + random.uniform(30.0, 75.0)
            return
        canvas.sprite(ghost.x, ghost.y, ghost.art,
                      self.GHOST if age < 6.0 else DIM + self.GHOST)

    def _lightning(self, canvas, now, cols, rows):
        if now >= self.next_bolt:
            self.flash = now + random.uniform(0.08, 0.2)
            self.next_bolt = now + random.uniform(25.0, 70.0)
            x = random.randrange(max(1, cols - 2))
            self.bolt, y = [], 0
            while y < rows * 0.6:                      # a jagged line out of the cloud
                step = random.choice((-1, 0, 1))
                self.bolt.append((x, y, "\\" if step > 0 else "/" if step < 0 else "|"))
                x, y = x + step, y + 1
        if now < self.flash:
            for x, y, char in self.bolt:
                canvas.put(x, y, char, self.BOLT)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_ghost = now + random.uniform(8.0, 30.0)
            self.next_bolt = now + random.uniform(10.0, 40.0)
        self._build(cols, rows)
        self._sky(canvas, dt, now, cols, rows)
        self._ground(canvas, now, cols, rows)
        self._ghost(canvas, dt, now, cols, rows)
        self._lightning(canvas, now, cols, rows)



class Christmas(Theme):
    name = "christmas"
    blurb = "snow over a cabin and a lit tree, with a sleigh going by (December)"
    seasonal = True

    SNOW = rgb(242, 247, 255)
    DRIFT = rgb(206, 219, 238)
    STAR = rgb(255, 228, 130)
    NEEDLE = rgb(58, 138, 74)
    TRUNK = rgb(122, 86, 56)
    WALL = rgb(126, 88, 60)
    LIT = rgb(255, 184, 62)
    SMOKE = rgb(150, 150, 168)
    SLEIGH = rgb(214, 66, 62)
    DEER = rgb(156, 114, 72)
    COAL = rgb(44, 42, 50)
    CARROT = rgb(240, 142, 60)
    BAUBLES = [rgb(236, 74, 74), rgb(250, 208, 92), rgb(96, 164, 242),
               rgb(96, 224, 128), rgb(224, 126, 224)]

    TREE = ["    /\\", "   /  \\", "  /    \\", " /      \\", "/________\\"]
    LIGHTS = ((4, 1), (2, 2), (6, 2), (1, 3), (4, 3), (7, 3), (3, 4), (6, 4))
    CABIN = ["   ______", "  /      \\", " /________\\", " |        |", " |________|"]
    SNOWMAN = ["  ___", " (o o)", "(  +  )"]
    SLEIGH_ART = ["   o      \\|/   \\|/",
                  "  /#\\     (o)   (o)",
                  " (___)~~~~/\\~~~~/\\>"]

    def __init__(self):
        Theme.__init__(self)
        self.flakes, self.drifts, self.laid = [], [], 0
        self.stars = []
        self.smoke, self.next_puff = [], 0.0
        self.sleigh, self.next_sleigh = None, 0.0
        self.yard = None
        self.started = None

    @staticmethod
    def in_season(today=None):
        return (today or datetime.now().date()).month == 12

    def _settle(self, cols, rows):
        """Snow on the ground, and where the cabin, tree and snowman stand."""
        if cols == self.laid:
            return
        self.laid = cols
        self.drifts = [1 + (1 if math.sin(x * 0.11) + math.sin(x * 0.27) > 0.7 else 0)
                       for x in range(cols)]
        self.flakes = [[random.uniform(0, cols), random.uniform(0, rows),
                        random.uniform(1.6, 5.0), random.uniform(0, 6.3)]
                       for _ in range((cols * rows) // 26)]
        self.stars = [(random.randrange(cols), random.randrange(max(1, rows // 3)),
                       random.uniform(0, 6.3)) for _ in range(cols // 8)]
        # Cabin left, tree well right of the clock, snowman at the far end.
        self.yard = (2, max(16, int(cols * 0.70)), max(30, cols - 12)) if cols >= 44 else None

    def _sky(self, canvas, now, cols, rows):
        for x, y, phase in self.stars:
            canvas.put(x, y, "·" if math.sin(now * 1.7 + phase) > 0 else ".", self.DRIFT)

    def _snow(self, canvas, dt, now, cols, rows):
        for flake in self.flakes:
            flake[1] += flake[2] * dt
            flake[0] += math.sin(now * 1.2 + flake[3]) * 1.6 * dt
            if flake[1] >= rows - self.drifts[min(int(flake[0]) % cols, cols - 1)]:
                flake[1], flake[0] = 0.0, random.uniform(0, cols)
            canvas.put(flake[0], flake[1],
                       "*" if flake[2] > 4.0 else "·" if flake[2] > 2.6 else ".", self.SNOW)
        for x, deep in enumerate(self.drifts[:cols]):   # what has already landed
            for y in range(rows - deep, rows):
                canvas.put(x, y, "█", self.SNOW if y == rows - deep else self.DRIFT)

    def _yard(self, canvas, dt, now, cols, rows):
        if self.yard is None:
            return
        cabin_x, tree_x, man_x = self.yard
        ground = rows - 2

        top = ground - len(self.CABIN) + 1
        canvas.sprite(cabin_x, top, self.CABIN[:3], self.SNOW, opaque=True)
        canvas.sprite(cabin_x, top + 3, self.CABIN[3:], self.WALL, opaque=True)
        canvas.put(cabin_x + 3, top + 3, "▓▓", self.LIT)
        canvas.put(cabin_x + 7, top - 1, "▐▌", self.WALL)
        if now >= self.next_puff:                       # chimney, drawing steadily
            puff = Sprite(["o"], self.SMOKE, cabin_x + 7, top - 2,
                          random.uniform(0.3, 1.0), -random.uniform(1.2, 2.2))
            puff.born = now
            self.smoke.append(puff)
            self.next_puff = now + random.uniform(0.6, 1.4)
        for puff in list(self.smoke):
            puff.move(dt)
            age = now - puff.born
            if puff.y < 0 or age > 9.0:
                self.smoke.remove(puff)
                continue
            canvas.put(puff.x, puff.y, "o" if age < 1.5 else "°" if age < 3.5 else ".",
                       self.SMOKE)

        tree_top = ground - len(self.TREE)
        canvas.sprite(tree_x, tree_top, self.TREE, self.NEEDLE, opaque=True)
        canvas.put(tree_x + 4, tree_top - 1,
                   "*" if math.sin(now * 3.0) > -0.3 else "+", self.STAR)
        canvas.put(tree_x + 4, ground, "||", self.TRUNK)
        for i, (dx, dy) in enumerate(self.LIGHTS):      # the string blinks out of step
            if math.sin(now * (1.7 + i * 0.3) + i) > -0.2:
                canvas.put(tree_x + dx, tree_top + dy, "o", self.BAUBLES[i % 5])

        canvas.sprite(man_x, ground - 2, self.SNOWMAN, self.SNOW, opaque=True)
        canvas.put(man_x + 2, ground - 1, "o o", self.COAL)
        canvas.put(man_x + 3, ground, "+", self.CARROT)
        canvas.put(man_x - 1, ground, "-", self.TRUNK)
        canvas.put(man_x + 7, ground, "-", self.TRUNK)

    def _sleigh(self, canvas, dt, now, cols, rows):
        if self.sleigh is None:
            if now < self.next_sleigh:
                return
            heading = random.choice((-1, 1))
            art = self.SLEIGH_ART if heading > 0 else mirror(self.SLEIGH_ART)
            span = max(len(row) for row in art)
            self.sleigh = Sprite(art, self.DEER, -span - 2 if heading > 0 else cols + 2,
                                 random.randint(0, max(0, rows // 3)),
                                 heading * random.uniform(7.0, 11.0), kind="sleigh")
        rig = self.sleigh
        rig.move(dt)
        rig.vy = math.sin(now * 1.1) * 0.8              # it rides the air
        if (rig.vx > 0 and rig.x > cols + 2) or (rig.vx < 0 and rig.x + rig.width < 0):
            self.sleigh = None
            self.next_sleigh = now + random.uniform(45.0, 110.0)
            return
        canvas.sprite(rig.x, rig.y, rig.art, rig.tint)
        # The reindeer are drawn in one piece; Santa and his sleigh are painted
        # back over it in red, on whichever end the team is pulling from.
        box = 1 if rig.vx > 0 else rig.width - 6
        head = 3 if rig.vx > 0 else rig.width - 4
        canvas.put(rig.x + box, rig.y + 2, "(___)", self.SLEIGH)
        canvas.put(rig.x + head, rig.y, "o", self.SLEIGH)
        canvas.put(rig.x + head - 1, rig.y + 1, "/#\\", self.SLEIGH)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_sleigh = now + random.uniform(8.0, 30.0)
        self._settle(cols, rows)
        self._sky(canvas, now, cols, rows)
        self._snow(canvas, dt, now, cols, rows)
        self._yard(canvas, dt, now, cols, rows)
        self._sleigh(canvas, dt, now, cols, rows)



class Easter(Theme):
