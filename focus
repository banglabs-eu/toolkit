        for x, shade, phase, height in self.flowers:
            lean = int(round(math.sin(now * 1.3 + phase)))
            for i in range(height):
                canvas.put(x, ground - 1 - i, "|", self.STEM)
            canvas.put(x + lean, ground - 1 - height,
                       "*" if shade % 2 else "o", self.PETALS[shade])
        for x, shade in self.eggs:
            canvas.sprite(x, ground - 2, self.EGG, self.SHELLS[shade % 5])

    def _arc(self, cols, rows):
        """The rainbow, worked out once per size and kept.

        Each band is a ring of cells at one distance from the centre, rather
        than a line at one radius: a curve drawn a cell thick has no room for
        seven colours, and they smear together down the flanks.
        """
        if cols < 40 or rows < 12:
            return []
        cells = []
        cx, cy = cols * 0.80, rows * 0.66      # off in the distance, clear of the meadow
        base = min(rows * 0.42, cols * 0.16)
        for y in range(rows):
            for x in range(cols):
                dy = cy - y
                if dy < 1.5:
                    continue
                band = int(round(base - math.hypot((x - cx) / 2.0, dy)))
                if 0 <= band < len(self.ARC):
                    cells.append((x, y, self.ARC[band]))
        return cells

    def _rainbow(self, canvas):
        for x, y, tint in self.arc:
            canvas.put(x, y, "▄", tint)

    def _bunnies(self, canvas, dt, now, cols, rows):
        ground = rows - 1
        if now >= self.next_bunny and len(self.bunnies) < 2:
            heading = random.choice((-1, 1))
            art = self.BUNNY if heading < 0 else mirror(self.BUNNY)
            hare = Sprite(art, random.choice(self.FURS),
                          -8 if heading > 0 else cols + 2, 0,
                          heading * random.uniform(5.0, 9.0), kind="bunny")
            hare.born = now
            self.bunnies.append(hare)
            self.next_bunny = now + random.uniform(6.0, 18.0)
        for hare in list(self.bunnies):
            hare.move(dt)
            if (hare.vx > 0 and hare.x > cols + 2) or (hare.vx < 0 and hare.x + hare.width < 0):
                self.bunnies.remove(hare)
                continue
            hop = abs(math.sin((now - hare.born) * 4.5)) * 2.0
            canvas.sprite(hare.x, ground - 2 - len(hare.art) - hop + 1, hare.art, hare.tint)
            if 0 < hare.x < cols - 5 and len(self.eggs) < 14 and random.random() < 0.012:
                self.eggs.append([hare.x, random.randrange(5)])   # one left behind

    def _moths(self, canvas, dt, now, cols, rows):
        if now >= self.next_moth and len(self.moths) < 3:
            heading = random.choice((-1, 1))
            self.moths.append(Sprite(self.WINGS[0], random.choice(self.PETALS),
                                     -3 if heading > 0 else cols + 2,
                                     random.randint(1, max(1, rows - 4)),
                                     heading * random.uniform(1.8, 3.6)))
            self.next_moth = now + random.uniform(4.0, 10.0)
        for moth in self.moths:
            moth.art = self.WINGS[int(now * 7) % 2]
            moth.vy = math.sin(now * 3.0 + moth.x) * 1.7
        self.advance(canvas, self.moths, dt, cols, rows)

    @staticmethod
    def in_season(today=None):
        """Palm Sunday through Easter Monday — nine days around the feast."""
        today = today or datetime.now().date()
        sunday = easter_sunday(today.year)
        return sunday - timedelta(days=7) <= today <= sunday + timedelta(days=1)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_bunny = now + random.uniform(2.0, 8.0)
        self._sow(cols, rows)
        self._rainbow(canvas)
        if cols > 30:
            canvas.sprite(2, 0, self.SUN_ART, self.SUN)
        self._meadow(canvas, now, cols, rows)
        self._moths(canvas, dt, now, cols, rows)
        self._bunnies(canvas, dt, now, cols, rows)



class Birthday(Theme):
    name = "birthday"
    blurb = "cake, candles and balloons — on your birthday, once focus knows it"
    seasonal = True

    BUNTING = [rgb(240, 110, 120), rgb(250, 205, 90), rgb(120, 200, 235),
               rgb(150, 220, 140), rgb(205, 145, 235)]
    ICING = rgb(250, 240, 245)
    SPONGE = rgb(190, 130, 85)
    PLATE = rgb(200, 205, 215)
    FLAME = rgb(255, 190, 70)
    WAX = rgb(240, 245, 250)
    RIBBON = rgb(240, 110, 120)
    BOX = rgb(130, 170, 230)

    CAKE = ["  __________ ", " |~~~~~~~~~~|", " |##########|", " \\__________/"]
    GIFT = ["_|_", "[#]"]

    def __init__(self):
        Theme.__init__(self)
        self.balloons, self.bits = [], []
        self.next_balloon = 0.0
        self.who = load_profile().get("name", "")
        self.started = None

    @staticmethod
    def in_season(today=None):
        who = load_profile()
        today = today or datetime.now().date()
        return who.get("month") == today.month and who.get("day") == today.day

    def _banner(self, canvas, now, cols):
        for x in range(cols):                          # bunting along the top
            canvas.put(x, 0, "/\\"[x % 2], self.BUNTING[(x // 2) % 5])
        greeting = ("HAPPY BIRTHDAY, " + self.who.upper()) if self.who else "HAPPY BIRTHDAY"
        if len(greeting) > cols - 2:
            greeting = greeting[: cols - 3] + "…"
        start = max(0, (cols - len(greeting) - 2) // 2)
        canvas.put(start, 2, " " * (len(greeting) + 2), "", opaque=True)
        for i, char in enumerate(greeting):            # each letter its own colour
            canvas.put(start + 1 + i, 2, char,
                       BOLD + self.BUNTING[(i + int(now * 3)) % 5])

    def _balloons(self, canvas, dt, now, cols, rows):
        if now >= self.next_balloon and len(self.balloons) < 7:
            balloon = Sprite([" __ ", "(  )", " \\/ "], random.choice(self.BUNTING),
                             random.uniform(1, max(1, cols - 5)), float(rows),
                             0.0, -random.uniform(1.4, 3.0))
            balloon.born = now
            self.balloons.append(balloon)
            self.next_balloon = now + random.uniform(1.2, 3.5)
        for balloon in list(self.balloons):
            balloon.vx = math.sin(now * 1.3 + balloon.born) * 1.8
            balloon.move(dt)
            if balloon.y + 3 < 0:
                self.balloons.remove(balloon)
                continue
            canvas.sprite(balloon.x, balloon.y, balloon.art, balloon.tint)
            for i in range(1, 4):                      # its string, trailing below
                canvas.put(balloon.x + 2 + (i % 2), balloon.y + 2 + i, "|", DIM + balloon.tint)

    def _confetti(self, canvas, dt, now, cols, rows):
        while len(self.bits) < cols // 3:
            self.bits.append([random.uniform(0, cols), random.uniform(-rows, 0),
                              random.uniform(2.5, 6.0), random.choice(self.BUNTING),
                              random.uniform(0, 6.3)])
        for bit in self.bits:
            bit[1] += bit[2] * dt
            bit[0] += math.sin(now * 3.0 + bit[4]) * 1.4 * dt
            if bit[1] > rows - 1:
                bit[1], bit[0] = -1.0, random.uniform(0, cols)
            canvas.put(bit[0], bit[1], "*/\\-o"[int(bit[4] * 5) % 5], bit[3])

    def _cake(self, canvas, now, cols, rows):
        if cols < 26:
            return
        x = cols // 2 - 6
        top = rows - len(self.CAKE)
        canvas.sprite(x, top, self.CAKE[:2], self.ICING, opaque=True)
        canvas.sprite(x, top + 2, self.CAKE[2:], self.SPONGE, opaque=True)
        canvas.put(x, rows - 1, "=" * 13, self.PLATE)
        for i in range(3):                             # candles, guttering
            cx = x + 3 + i * 3
            canvas.put(cx, top - 1, "|", self.WAX)
            canvas.put(cx, top - 2, "*'."[int(now * 7 + i * 2) % 3], self.FLAME)
        for gift in (x - 6, x + 14):                   # presents either side
            if 0 <= gift < cols - 3:
                canvas.sprite(gift, rows - 2, self.GIFT, self.BOX)
                canvas.put(gift + 1, rows - 2, "|", self.RIBBON)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
        self._confetti(canvas, dt, now, cols, rows)
        self._balloons(canvas, dt, now, cols, rows)
        self._banner(canvas, now, cols)                # last, so nothing falls through it
        self._cake(canvas, now, cols, rows)


RANDOM = "random"                  # a different scene every block


def pick(name):
    """Resolve a theme name, drawing a scene at random when asked to.

    Seasonal themes keep to their dates: ask for one by name any day of the
    year, but random only offers it in season, where it is weighted to turn up
    rather than hide among the other ten.
    """
    if name != RANDOM:
        return name
    if Birthday.in_season():                   # one day a year, it wins outright
        return Birthday.name
    pool = []
    for theme_name, theme in THEMES.items():
        if theme_name == Theme.name:
            continue
        if not theme.seasonal:
            pool.append(theme_name)
        elif theme.in_season():
            pool += [theme_name] * 3
    return random.choice(pool)



class Desert(Theme):
    name = "desert"
    blurb = "dunes under a blazing sun, an oasis, and camel caravans crossing"

    SAND = rgb(226, 196, 132)
    SHADE = rgb(190, 156, 100)
    DEEP = rgb(158, 124, 78)
    SUN = rgb(255, 214, 92)
    HAZE = rgb(228, 202, 158)
    CAMEL = rgb(184, 132, 78)
    RIDER = rgb(88, 84, 118)
    PALM = rgb(92, 160, 82)
    TRUNK = rgb(142, 106, 66)
    WATER = rgb(95, 175, 205)
    VULTURE = rgb(74, 68, 74)

    CAMEL_ART = [
        "          _,",
        "   /\\_/\\ / o\\",
        "  /       \\__/",
        "  |  |  |  |",
    ]
    LEGS = ["  |  |  |  |", "  /  |  |  \\"]
    RIDER_ART = [" o ", "/|\\"]
    PALM_ART = [" \\\\|//", "  \\|/", "   |", "   |"]
    SUN_ART = [" \\ | /", "-- O --", " / | \\"]
    WINGS = [["~^~"], ["~v~"]]

    def __init__(self):
        Theme.__init__(self)
        self.dunes, self.shaped = [], 0
        self.oasis = None
        self.caravan, self.grains = [], []
        self.next_caravan = 0.0
        self.started = None

    def _shape(self, cols, rows):
        """The dune profile is fixed for a width, so the sand stays put."""
        if cols == self.shaped:
            return
        self.shaped = cols
        crest = max(2, min(4, rows // 7))
        self.dunes = [1 + int(crest + math.sin(x * 0.07) * 1.7
                              + math.sin(x * 0.17 + 2.0) * 1.0) for x in range(cols)]
        self.oasis = random.randint(4, max(5, cols - 18)) if cols >= 40 else None
        self.grains = [[random.uniform(0, cols), random.uniform(rows - 9, rows - 5),
                        random.uniform(5.0, 13.0)] for _ in range(9)]

    def _height(self, x, cols, span=1):
        """The sand under a footprint — the highest of it, so nothing sinks in."""
        if not self.dunes:
            return 2
        left = min(max(int(x), 0), cols - 1)
        right = min(max(int(x + span), 0), cols - 1)
        return max(self.dunes[min(left, right):max(left, right) + 1] or [2])

    def _sand(self, canvas, dt, now, cols, rows):
        floor = rows - 1
        for x, height in enumerate(self.dunes[:cols]):
            top = floor - height + 1
            canvas.put(x, top, "▒", self.SAND)
            for y in range(top + 1, floor + 1):
                canvas.put(x, y, "░", self.SHADE if y < floor - 1 else self.DEEP)
            shimmer = math.sin(now * 3.0 + x * 0.35)
            if shimmer > 0.85:                           # heat coming off the crest
                canvas.put(x, top - 1, "~", self.HAZE)
        for grain in self.grains:                        # wind off the dunes
            grain[0] += grain[2] * dt
            if grain[0] > cols:
                grain[0], grain[1] = -1.0, random.uniform(rows - 9, rows - 5)
            canvas.put(grain[0], grain[1], ".", self.HAZE)

    def _oasis(self, canvas, now, cols, rows):
        if self.oasis is None:
            return
        x = self.oasis
        base = rows - self._height(x, cols)
        canvas.sprite(x, base - len(self.PALM_ART), self.PALM_ART, self.PALM)
        canvas.put(x + 3, base - 1, "|", self.TRUNK)
        canvas.sprite(x + 7, base - 3, [" \\|/", "  |", "  |"], self.PALM)
        canvas.put(x + 2, base, "~≈~~≈~", self.WATER)

    def _caravan(self, canvas, dt, now, cols, rows):
        if not self.caravan and now >= self.next_caravan:
            heading = random.choice((-1, 1))
            speed = heading * random.uniform(1.8, 3.0)
            art = self.CAMEL_ART if heading > 0 else mirror(self.CAMEL_ART)
            span = max(len(row) for row in art)
            for i in range(random.randint(2, 4)):        # roped nose to tail
                start = (-span - 2 - i * random.randint(18, 24) if heading > 0
                         else cols + 2 + i * random.randint(18, 24))
                camel = Sprite(list(art), self.CAMEL, start, 0, speed,
                               kind="camel", flip=heading < 0)
                camel.born = 1.0 if i == 0 else 0.0      # the leader carries a rider
                self.caravan.append(camel)
            self.next_caravan = now + random.uniform(35.0, 70.0)

        for camel in list(self.caravan):
            camel.move(dt)
            if (camel.vx > 0 and camel.x > cols + 2) or \
               (camel.vx < 0 and camel.x + camel.width < 0):
                self.caravan.remove(camel)
                continue
            legs = self.LEGS[int(now * 3.5 + camel.x * 0.1) % 2]
            camel.art[3] = mirror([legs])[0] if camel.flip else legs
            top = rows - self._height(camel.x, cols, camel.width) - len(camel.art)
            canvas.sprite(camel.x, top, camel.art, camel.tint)
            if camel.born:
                canvas.sprite(camel.x + (3 if not camel.flip else camel.width - 6),
                              top - 1, self.RIDER_ART, self.RIDER)
        if self.caravan:
            self.next_caravan = max(self.next_caravan, now + 20.0)

    def _vulture(self, canvas, now, cols, rows):
        turn = now * 0.35
        x = cols * 0.5 + math.cos(turn) * cols * 0.3
        y = max(0, rows * 0.16) + math.sin(turn) * 2.0
        canvas.sprite(x, y, self.WINGS[int(now * 4) % 2], self.VULTURE)

    def draw(self, canvas, now):
        dt = self.tick(now)
        cols, rows = canvas.cols, canvas.rows
        if self.started is None:
            self.started = now
            self.next_caravan = now + random.uniform(4.0, 14.0)
        self._shape(cols, rows)
        if cols > 30:
            canvas.sprite(cols - 9, 0, self.SUN_ART, self.SUN)
        self._sand(canvas, dt, now, cols, rows)
        self._oasis(canvas, now, cols, rows)
        self._vulture(canvas, now, cols, rows)
        self._caravan(canvas, dt, now, cols, rows)


THEMES = {theme.name: theme for theme in (Theme, Aquarium, Airport, Space, Galaxy, Desert, Farm,
                                  Matrix, Neurons, Haunted, Christmas, Easter,
                                  Birthday)}


def compose(canvas, goal, remaining, total, paused, started_at, choosing=None,
            default=None):
    """The goal, the clock, the bar and the hint, centred over whatever scene."""
    cols, rows = canvas.cols, canvas.rows
    tint = AMBER if paused or remaining <= 60 else ACCENT

    text = clock(remaining)
    digits = big(text)
    if len(digits[0]) > cols - 2:                        # too narrow for block digits
        digits = [text]

    goal_line = goal if len(goal) <= cols - 4 else goal[: cols - 5] + "…"

    bar_width = min(44, max(10, cols - 10))
    filled = int(round((1 - remaining / total if total else 1) * bar_width))

    length = "%g min" % (total / 60) if total % 60 else "%d min" % (total // 60)
    state = "paused" if paused else "started " + started_at.strftime("%H:%M")
    if choosing is None:
        keys = "space %s · t theme · q stop" % ("resume" if paused else "pause")
        short = "space · t · q"
    else:                                  # the picker says how to leave it
        keys = "← → scene · d default · t, enter or esc to go back"
        short = "← → · d · enter"
    for hint in ("%s · %s · %s" % (length, state, keys), "%s · %s" % (length, keys),
                 keys, short):                        # the last one fits anything
        if len(hint) <= cols - 2:
            break

    # Every line blanks what is behind it, so a scene never intrudes into the
    # text: a plane crossing the hint is cut by it rather than mixed into it.
    lines = [[(" " + goal_line + " ", BOLD)], []]
    lines += [[(row, tint)] for row in digits]
    lines += [[], [("━" * filled, tint), ("━" * (bar_width - filled), DIM)], []]
    lines += [[(" " + hint + " ", DIM)]]

    top = max(0, (rows - len(lines)) // 2)
    for i, segments in enumerate(lines):
        x = max(0, (cols - sum(len(s) for s, _ in segments)) // 2)
        for text, seg_tint in segments:
            canvas.put(x, top + i, text, seg_tint, opaque=True)
            x += len(text)

    below = top + len(lines)
    taken = corner(canvas, below)
    if choosing is not None:
        picker(canvas, choosing, below, canvas.cols - 4 - taken, default)


def corner(canvas, below):
    """The GlyphClock reading, dim in the bottom right, out of the clock's way.

    The glyph on its own: the picture is the reading, and a name beside it
    would only be the picture spelled out. A glyph is one character here but
    two cells on the screen, so each is padded out to the width it will take
    and nothing downstream of it shifts.

    Returns the columns it took, which is what the corner opposite has left.
    """
    row = canvas.rows - 2
    if row < below:                              # a short window: the clock first
        return 0
    emoji, count, _ = glyphclock()
    text = " " + (emoji + " " * (2 - len(emoji))) * count
    if len(text) + 2 > canvas.cols:
        return 0
    canvas.put(canvas.cols - 2 - len(text), row, text, DIM, opaque=True)
    return len(text) + 2


def picker(canvas, at, below, room, default=None):
    """The scene rota along the bottom, with the one on screen picked out.

    Only as much of it as fits: the list is windowed around the choice and
    grown outwards until the room runs out, with a chevron on whichever side
    still has names behind it. The scene itself is the preview — this is only
    the label for what is already being drawn. The default, if there is one, is
    the name in green.
    """
    row = canvas.rows - 2
    if room < 12:                      # the GlyphClock has that row; go under it
        row, room = canvas.rows - 1, canvas.cols - 2
    if row < below or room < 12:
        return
    rota = list(THEMES)
    marked = ["[%s]" % name if i == at else " %s " % name
              for i, name in enumerate(rota)]
    left = right = at
    width = len(marked[at]) + 2                       # the chevrons' own room
    while True:
        grew = False
        if left > 0 and width + len(marked[left - 1]) <= room:
            left -= 1
            width += len(marked[left])
            grew = True
        if right < len(rota) - 1 and width + len(marked[right + 1]) <= room:
            right += 1
            width += len(marked[right])
            grew = True
        if not grew:
            break

    segments = [("‹" if left > 0 else " ", DIM)]
    for i in range(left, right + 1):
        kept = rota[i] == default
        segments.append((marked[i], (BOLD if i == at else "")
                         + (GREEN if kept else ACCENT if i == at else DIM)))
    segments.append(("›" if right < len(rota) - 1 else " ", DIM))

    x = 1
    for text, tint in segments:
        canvas.put(x, row, text, tint, opaque=True)
        x += len(text)


def frame(canvas):
    out = ["\033[H"]
    lines = canvas.lines()
    for i, line in enumerate(lines):
        out.append(line + "\033[K")
        if i < len(lines) - 1:
            out.append("\n")
    out.append("\033[J")
    sys.stdout.write("".join(out))
    sys.stdout.flush()


SPARKS = [rgb(255, 215, 95), rgb(255, 125, 90), rgb(120, 220, 255),
          rgb(195, 145, 255), rgb(140, 250, 150), rgb(255, 255, 255)]


class Finale:
    """The last seconds of a block: loud enough to see from across the room."""

    def __init__(self, style):
        self.style = style
        self.rockets, self.sparks, self.rings, self.bits = [], [], [], []
        self.next_rocket = self.next_ring = 0.0
        self.last = None

    def _burst(self, x, y, now, tint):
        for i in range(30):
            angle = i / 30 * math.tau + random.uniform(-0.06, 0.06)
            speed = random.uniform(5.0, 13.0)
            self.sparks.append([x, y, math.cos(angle) * speed * 2.0,
                                math.sin(angle) * speed, now, tint])

    def _fireworks(self, canvas, dt, now, t, cols, rows):
        if t < FINALE - 2.0 and now >= self.next_rocket:
            self.rockets.append([random.uniform(cols * 0.08, cols * 0.92), float(rows - 1),
                                 -random.uniform(13.0, 19.0),
                                 random.uniform(1.0, rows * 0.45),
                                 random.choice(SPARKS)])
            self.next_rocket = now + random.uniform(0.18, 0.5)
        for rocket in list(self.rockets):
            rocket[1] += rocket[2] * dt
            if rocket[1] <= rocket[3]:                   # apogee, and it lets go
                self._burst(rocket[0], rocket[1], now, rocket[4])
                self.rockets.remove(rocket)
                continue
            canvas.put(rocket[0], rocket[1], "|", rocket[4])
            canvas.put(rocket[0], rocket[1] + 1, ".", DIM + rocket[4])

        for spark in list(self.sparks):
            age = now - spark[4]
            if age > 1.9:
                self.sparks.remove(spark)
                continue
            spark[0] += spark[2] * dt
            spark[1] += spark[3] * dt
            spark[3] += 11.0 * dt                        # they fall as they fade
            spark[2] *= 0.985
            canvas.put(spark[0], spark[1],
                       "*" if age < 0.3 else "+" if age < 0.7 else
                       "·" if age < 1.2 else ".",
                       spark[5] if age < 1.0 else DIM + spark[5])

    def _shockwave(self, canvas, dt, now, t, cols, rows):
        if now >= self.next_ring and t < FINALE - 1.2:
            self.rings.append([now, random.choice(SPARKS)])
            self.next_ring = now + 0.5
        cx, cy = cols / 2.0, rows / 2.0
        for ring in list(self.rings):
            age = now - ring[0]
            radius = age * 15.0
            if radius * 2 > cols + 10:
                self.rings.remove(ring)
                continue
            char = "O" if age < 0.25 else "o" if age < 0.6 else "·" if age < 1.1 else "."
            for i in range(max(16, int(radius * 7))):
                angle = i / max(16, int(radius * 7)) * math.tau
                canvas.put(cx + math.cos(angle) * radius * 2.0,
                           cy + math.sin(angle) * radius, char,
                           ring[1] if age < 0.8 else DIM + ring[1])

    def _confetti(self, canvas, dt, now, t, cols, rows):
        while len(self.bits) < cols * 2 and t < FINALE - 1.5:
            self.bits.append([random.uniform(0, cols), random.uniform(-rows, 0),
                              random.uniform(-1.5, 1.5), random.uniform(6.0, 15.0),
                              random.choice(SPARKS), random.uniform(0, 6.3)])
        for bit in self.bits:
            bit[0] += (bit[2] + math.sin(now * 4.0 + bit[5]) * 2.0) * dt
            bit[1] += bit[3] * dt
            if bit[1] > rows:                            # round again, until it stops
                bit[1], bit[0] = -1.0, random.uniform(0, cols)
            canvas.put(bit[0], bit[1], "/\\|-o*v"[int(bit[5] * 7) % 7], bit[4])

    def draw(self, canvas, now, t):
        dt = 0.0 if self.last is None else min(0.25, now - self.last)
        self.last = now
        painter = {"fireworks": self._fireworks, "shockwave": self._shockwave}.get(
            self.style, self._confetti)
        painter(canvas, dt, now, t, canvas.cols, canvas.rows)


def banner(canvas, goal, minutes, now):
    """DONE across the middle, with what it was for underneath."""
    cols, rows = canvas.cols, canvas.rows
    flash = GREEN if math.sin(now * 7.0) > 0 else rgb(205, 255, 215)
    word = big("DONE")
    if len(word[0]) > cols - 2:
        word = ["DONE"]
    caption = "%g minutes · %s" % (minutes, goal)
    if len(caption) > cols - 4:
        caption = caption[: cols - 5] + "…"

    lines = [[(row, BOLD + flash)] for row in word]
    lines += [[], [(" " + caption + " ", BOLD)], [("any key to close", DIM)]]
    top = max(0, (rows - len(lines)) // 2)
    for i, segments in enumerate(lines):
        x = max(0, (cols - sum(len(text) for text, _ in segments)) // 2)
        for text, tint in segments:
            canvas.put(x, top + i, text, tint, opaque=True)
            x += len(text)


def celebrate(theme, goal, minutes, colour):
    """Run the finish animation until it is done or a key says enough."""
    show = Finale(random.choice(FINALES))
    start = time.monotonic()
    rung = 0
    while True:
        now = time.monotonic()
        elapsed = now - start
        if elapsed >= FINALE:
            return
        if rung < 3 and elapsed >= rung * 0.5:
            rung += 1
            sys.stdout.write("\a")
        cols, rows = shutil.get_terminal_size((80, 24))
        canvas = Canvas(max(20, cols), max(8, rows), colour)
        theme.draw(canvas, now)
        show.draw(canvas, now, elapsed)
        banner(canvas, goal, minutes, now)
        frame(canvas)
        ready, _, _ = select.select([sys.stdin], [], [], FRAME)
        if ready:
            sys.stdin.read(1)
            return


def alarm(goal, minutes):
    """Notification and chime — the half of it that reaches another room."""
    message = "%g minutes done — %s" % (minutes, goal)
    if shutil.which("notify-send"):
        subprocess.run(
            ["notify-send", "--urgency=critical", "--app-name=focus", "focus", message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    sound = "/usr/share/sounds/freedesktop/stereo/complete.oga"
    if shutil.which("paplay") and os.path.exists(sound):
        subprocess.Popen(
            ["paplay", sound], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    return message


def finished(message, colour, quiet):
    if quiet:                                    # no animation rang them, so ring here
        for _ in range(3):
            sys.stdout.write("\a")
            sys.stdout.flush()
            time.sleep(0.4)
    tick = (GREEN if colour else "") + "✓" + (RESET if colour else "")
    print("%s %s — %s" % (tick, message, datetime.now().strftime("%H:%M")))


def one_key(allowed):
    """A single keypress, without the Enter that input() waits for."""
    old = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin.fileno())
        while True:
            key = sys.stdin.read(1)
            if key in ("", "\x04", "\x1b"):        # end of input, Ctrl-D, Esc
                return "q"
            key = key.lower()
            if key in allowed:
                return key
    except KeyboardInterrupt:
        return "q"
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old)


def ask_goal(prompt="Goal: "):
    try:
        return input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""


def again(goal, minutes, colour):
    """What follows a block that landed: a new goal, the same one, or nothing.

    Returns the goal of the next block, or None to stop here.
    """
    short = goal if len(goal) <= 40 else goal[:39] + "…"
    print()
    print("  %s new session   %s repeat “%s”   %s quit" % (
        paint("[f]", GREEN, colour), paint("[r]", GREEN, colour), short,
        paint("[q]", GREEN, colour)))
    choice = one_key("frq")
    if choice == "q":
        return None
    if choice == "r":
        print("  Again: %s — %g minutes" % (goal, minutes))
        return goal
    return ask_goal("  New goal (%g min): " % minutes) or None


def load_profile():
    try:
        with open(PROFILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_profile(profile):
    os.makedirs(LOG_DIR, exist_ok=True)
    with open(PROFILE, "w") as fh:
        json.dump(profile, fh, indent=2, sort_keys=True)
        fh.write("\n")


def default_scene():
    """The scene every block draws unless something says otherwise.

    $FOCUS_THEME first, for a shell that wants one session to differ, then
    whatever d last kept in the profile, then the lottery.
    """
    name = os.environ.get("FOCUS_THEME") or load_profile().get("theme") or RANDOM
    return name if name == RANDOM or name in THEMES else RANDOM


def keep_default(name):
    """Keep this scene as the default, or drop it if it already is.

    Pressing d on the scene that is already the default is how you get the
    lottery back, so the one key both sets and clears. Returns what the
    default is now, or None for random.
    """
    profile = load_profile()
    if profile.get("theme") == name:
        profile.pop("theme", None)
        name = None
    else:
        profile["theme"] = name
    save_profile(profile)
    return name


def parse_birthday(text):
    """Day first, as it is written here: 7-3, 07/03, 7.3.1985, or an ISO date."""
    for separator in "-/.,":
        text = text.replace(separator, " ")
    parts = [part for part in text.split() if part]
    year = None
    try:
        if len(parts) == 3 and len(parts[0]) == 4:
            year, month, day = int(parts[0]), int(parts[1]), int(parts[2])
        elif len(parts) == 3:
            day, month, year = int(parts[0]), int(parts[1]), int(parts[2])
        elif len(parts) == 2:
            day, month = int(parts[0]), int(parts[1])
        else:
            return None
        date(year or 2000, month, day)         # a leap year, so 29 February stands
    except (ValueError, IndexError):
        return None
    return month, day, year


def ask_profile(force=False):
    """Ask once for a name and a birthday, so the day itself gets its own scene."""
    profile = load_profile()
    if (profile.get("asked") and not force) or not sys.stdin.isatty():
        return profile
    print("focus can throw you a party on your birthday. Both answers are")
    print("optional — press enter to skip, or run focus --me to change them later.")
    try:
        name = input("  Your name: ").strip()
        born = input("  Your birthday (day-month, e.g. 7-3): ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return profile

    profile = {"asked": True, "name": name}
    kept = load_profile().get("theme")     # the picker's d put it there; leave it
    if kept:
        profile["theme"] = kept
    when = parse_birthday(born) if born else None
    if born and when is None:
        print("  Sorry, I could not read that date. Run focus --me to try again.")
    elif when:
        profile["month"], profile["day"], profile["year"] = when
        stamp = date(2000, when[0], when[1]).strftime("%-d %B")
        print("  Noted: %s%s." % (stamp, " %d" % when[2] if when[2] else ""))
    save_profile(profile)
    return profile



# --- The account, and where the history lives --------------------------------
#
# Signed out, focus is what it has always been: one script, one CSV, no
# network at all. Signing in moves the record to the toolkit database behind
# accounts.bang-labs.eu, so a block started on the laptop is there in
# --history on the desktop. Still nothing outside the standard library.


class ApiError(Exception):
    """Something the user needs to hear about a request, in their words."""


def api_url():
    return os.environ.get("FOCUS_API_URL", DEFAULT_API_URL).rstrip("/")


def accounts_url():
    return os.environ.get("FOCUS_ACCOUNTS_URL", DEFAULT_ACCOUNTS_URL).rstrip("/")


def load_token():
    try:
        with open(TOKEN_FILE) as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def save_token(token):
    os.makedirs(LOG_DIR, exist_ok=True)
    # A 30-day session for every Bang Labs site, so it is written the way a
    # private key is: created 0600, not chmod-ed to 0600 a moment later.
    handle = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(handle, "w") as fh:
        fh.write(token + "\n")


def clear_token():
    try:
        os.remove(TOKEN_FILE)
    except OSError:
        pass


def signed_in():
    return load_token() is not None


def explain(error):
    """An HTTP failure in the words the service used, when it sent any.

    Every Bang Labs service answers an error with a `detail` — and its
    wording beats anything invented here. "Too many failed attempts. Try
    again in 15 minutes." is the whole message; "HTTP 429" is not.
    """
    try:
        detail = json.loads(error.read().decode()).get("detail")
    except (ValueError, AttributeError, OSError):
        detail = None
    if isinstance(detail, list) and detail:        # a FastAPI validation error
        first = detail[0]
        detail = first.get("msg") if isinstance(first, dict) else None
    return str(detail) if detail else "HTTP %s from %s." % (error.code, error.url)


def request(method, url, body=None, token=None, timeout=TIMEOUT):
    """One JSON request. Returns the decoded body, or raises ApiError
    carrying a sentence worth printing on its own."""
    host = urllib.parse.urlsplit(url).netloc
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = "Bearer " + token

    call = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(call, timeout=timeout) as response:
            return json.loads(response.read().decode() or "{}")
    except urllib.error.HTTPError as error:        # a subclass of URLError, so first
        raise ApiError(explain(error)) from None
    except urllib.error.URLError as error:
        raise ApiError("%s is unreachable (%s)." % (host, error.reason)) from None
    except ValueError:
        raise ApiError("%s sent something that was not JSON." % host) from None
    except OSError as error:
        raise ApiError("%s did not answer (%s)." % (host, error)) from None


def api(method, path, body=None, params=None):
    """A call to the toolkit API, signed with the session on this machine."""
    token = load_token()
    if not token:
        raise ApiError("Not signed in. Run: focus --login")
    url = api_url() + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    try:
        return request(method, url, body, token)
    except ApiError as error:
        if "session" in str(error).lower():        # expired, invalid, revoked
            raise ApiError("%s Run: focus --login" % error) from None
        raise


def whoami():
    """The account this machine is signed in as, or None."""
    token = load_token()
    if not token:
        return None
    return request("GET", accounts_url() + "/me", token=token).get("username")


def device():
    """Which machine a block was done on, so a day spent across two of them
    can still be told apart later."""
    return os.uname().nodename


def aware(moment):
    """The absolute instant a local wall-clock time names.

    astimezone() reads a naive datetime as local time, which is what every
    time in this script is — the CSV has always written wall clock.
    """
    return moment.astimezone()


def local(text):
    """An instant from the API as local wall clock, the way the rest of this
    script writes and compares time."""
    moment = datetime.fromisoformat(text)
    if moment.tzinfo is not None:
        moment = moment.astimezone().replace(tzinfo=None)
    return moment


def csv_id(row):
    """A stable id for a block that predates the account.

    The CSV never carried one, so it is derived from the block itself: the
    same row uploaded twice — from a second machine, or a second run of
    --upload — comes out as the same uuid, and the server's idempotency does
    the rest. uuid5 rather than a bare hash, so it is a uuid like the ids
    every block minted since.
    """
    key = "%s|%s|%s" % (row["started"], row["goal"], row["actual_minutes"])
    return str(uuid.uuid5(CSV_NAMESPACE, key))


def as_row(session):
    """A block from the API in the shape the rest of focus reads: the CSV's.

    Keeping this one conversion at the edge is what lets blocks_on, show_day,
    strip and the rest stay exactly as they were, local and naive, whichever
    source the day came from.
    """
    return {
        "started": local(session["started_at"]).isoformat(timespec="seconds"),
        "goal": session["goal"],
        "planned_minutes": "%g" % session["planned_minutes"],
        "actual_minutes": "%.1f" % session["actual_minutes"],
        "completed": "yes" if session["completed"] else "no",
    }


def as_session(row):
    """A CSV row in the shape the API takes."""
    return {
        "client_id": csv_id(row),
        "started_at": aware(datetime.fromisoformat(row["started"])).isoformat(),
        "goal": row["goal"],
        "planned_minutes": float(row["planned_minutes"]),
        "actual_minutes": float(row["actual_minutes"]),
        "completed": row["completed"] == "yes",
    }


def queue(session):
    """Hold a block that could not be uploaded, so a later run can send it.

    The account is the record once you are signed in, but a block you sat
    through is not something to lose to a dropped connection on the way to
    it.
    """
    os.makedirs(LOG_DIR, exist_ok=True)
    with open(PENDING_FILE, "a") as fh:
        fh.write(json.dumps(session) + "\n")


def pending():
    """Blocks waiting to go up, oldest first."""
    try:
        with open(PENDING_FILE) as fh:
            return [json.loads(line) for line in fh if line.strip()]
    except (OSError, ValueError):
        return []


def hold(sessions):
    """Rewrite the queue with what is still waiting."""
    if not sessions:
        try:
            os.remove(PENDING_FILE)
        except OSError:
            pass
        return
    with open(PENDING_FILE, "w") as fh:
        for session in sessions:
            fh.write(json.dumps(session) + "\n")


def flush(quiet=True):
    """Send whatever is waiting, in pages. Returns how many blocks landed."""
    waiting = pending()
    if not waiting:
        return 0
    sent = 0
    for start in range(0, len(waiting), BATCH):
        page = waiting[start:start + BATCH]
        try:
            answer = api("POST", "/focus/sessions/import", {"sessions": page})
        except ApiError as error:
            # Keep only what has not gone up, so a flush that fails halfway
            # still made progress instead of resending from the top forever.
            hold(waiting[start:])
            if not quiet:
                print("Could not send %d waiting block%s: %s"
                      % (len(waiting) - start, "" if len(waiting) - start == 1 else "s",
                         error), file=sys.stderr)
            return sent
        sent += answer["created"]
    hold([])
    return sent


def upload_csv():
    """Send ~/focus/sessions.csv — the blocks logged before there was an
    account to put them in."""
    rows = local_log()
    if not rows:
        print("Nothing in %s to send." % LOG_FILE)
        return 0
    sessions = [as_session(row) for row in rows]
    created = 0
    for start in range(0, len(sessions), BATCH):
        try:
            answer = api("POST", "/focus/sessions/import",
                         {"sessions": sessions[start:start + BATCH]})
        except ApiError as error:
            print(error, file=sys.stderr)
            return 1
        created += answer["created"]
    already = len(sessions) - created
    print("  Uploaded %d block%s%s."
          % (created, "" if created == 1 else "s",
             "" if not already else ", %d already there" % already))
    return 0


def offer_upload():
    """Ask once, at sign-in, about the history already on this machine.

    Without this the account simply starts empty, and a year of blocks
    quietly stops showing up in --log — the CSV is not gone, but it is no
    longer what focus reads.
    """
    rows = local_log()
    if not rows:
        return 0
    if not sys.stdin.isatty():
        return 0
    try:
        answer = input("  Upload the %d block%s already logged on this machine? [Y/n] "
                       % (len(rows), "" if len(rows) == 1 else "s")).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        answer = "n"
    if answer.startswith("n"):
        print("  Left where they are. focus --upload sends them later.")
        return 0
    return upload_csv()


def do_login():
    """Sign in to accounts.bang-labs.eu, and offer to bring this machine's
    history along."""
    if signed_in():
        try:
            who = whoami()
        except ApiError:
            who = None                             # a dead token; sign in over it
        if who:
            print("Already signed in as %s. Run focus --logout to change account."
                  % who)
            return 0

    print("Sign in with your Bang Labs account — the same one as every other")
    print("bang-labs.eu site. Register at %s if you have none yet." % accounts_url())
    try:
        username = input("  Username: ").strip()
        password = getpass.getpass("  Password: ")
    except (EOFError, KeyboardInterrupt):
        print()
        return 1
    if not username or not password:
        print("Nothing entered. Not signed in.", file=sys.stderr)
        return 1

    try:
        answer = request("POST", accounts_url() + "/login",
                         {"username": username, "password": password,
                          "service": "focus"})
    except ApiError as error:
        print(error, file=sys.stderr)
        return 1

    save_token(answer["token"])
    print("Signed in as %s. Blocks are kept in your account from now on."
          % answer["username"])
    return offer_upload()


def do_logout():
    token = load_token()
    if not token:
        print("Not signed in.")
        return 0

    waiting = len(pending())
    if waiting:
        flush(quiet=False)
    waiting = len(pending())
    if waiting:
        print("%d block%s could not be sent, and stay in %s until the next "
              "sign-in." % (waiting, "" if waiting == 1 else "s", PENDING_FILE),
              file=sys.stderr)

    try:
        request("POST", accounts_url() + "/logout", {}, token=token)
    except ApiError:
        pass                                       # the token goes either way
    clear_token()
    print("Signed out. focus logs to %s again." % LOG_FILE)
    return 0


def do_whoami():
    if not signed_in():
        print("Not signed in — blocks are logged to %s." % LOG_FILE)
        print("Run focus --login to keep them in your Bang Labs account.")
        return 0
    try:
        who = whoami()
    except ApiError as error:
        print(error, file=sys.stderr)
        return 1
    print("Signed in as %s." % who)
    print("Blocks are kept at %s." % api_url())
    waiting = len(pending())
    if waiting:
        print("%d block%s waiting to upload. Run: focus --sync"
              % (waiting, "" if waiting == 1 else "s"))
    return 0


def do_sync():
    if not signed_in():
        print("Not signed in. Run: focus --login", file=sys.stderr)
        return 1
    waiting = len(pending())
    if not waiting:
        print("Nothing waiting.")
        return 0
    flush(quiet=False)
    left = len(pending())
    print("Sent %d of %d waiting block%s."
          % (waiting - left, waiting, "" if waiting == 1 else "s"))
    return 1 if left else 0


def record(started, goal, planned, actual, completed, theme=None):
    """Keep the block: in the account when there is one, in the CSV when
    there is not, and never nowhere."""
    if not signed_in():
        record_locally(started, goal, planned, actual, completed)
        return

    session = {
        "client_id": str(uuid.uuid4()),
        "started_at": aware(started).isoformat(),
        "goal": goal,
        "planned_minutes": float(planned),
        "actual_minutes": round(actual, 1),
        "completed": completed,
        "theme": theme,
        "device": device(),
    }
    try:
        api("POST", "/focus/sessions", session)
    except ApiError as error:
        queue(session)
        print("Kept on this machine for now — %s" % error, file=sys.stderr)
        return
    flush()                                        # anything an earlier block left


def record_locally(started, goal, planned, actual, completed):
    os.makedirs(LOG_DIR, exist_ok=True)
    new = not os.path.exists(LOG_FILE)
    with open(LOG_FILE, "a", newline="") as fh:
        writer = csv.DictWriter(fh, fieldnames=LOG_FIELDS)
        if new:
            writer.writeheader()
        writer.writerow(
            {
                "started": started.isoformat(timespec="seconds"),
                "goal": goal,
                "planned_minutes": "%g" % planned,
                "actual_minutes": "%.1f" % actual,
                "completed": "yes" if completed else "no",
            }
        )


def countdown(goal, minutes, theme_name=RANDOM, preview=False, finale=True):
    theme_name = pick(theme_name)
    total = minutes * 60.0
    started_at = datetime.now()
    colour = colours_on()
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    theme = THEMES[theme_name]()
    # A preview compresses whatever a theme saves for once a block, so that the
    # rare things are actually watchable instead of arriving in ten minutes.
    theme.total = 45.0 if preview else total

    remaining = total
    paused = False
    resumed_at = time.monotonic()
    old_attrs = None
    rota = list(THEMES)                    # what the picker walks, plain included
    at = rota.index(theme_name)
    picking = False                        # is the rota on screen?
    default = load_profile().get("theme")  # marked green in the strip

    def scene(index):
        """The theme at that place in the rota, ready to draw."""
        chosen = THEMES[rota[index]]()
        chosen.total = 45.0 if preview else total
        return chosen

    if interactive:
        old_attrs = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())      # cbreak, not raw: Ctrl-C still works
        # Alternate screen, so whatever was in the terminal comes back at the end.
        sys.stdout.write("\033[?1049h\033[?25l\033[2J")

    completed = False
    try:
        while True:
            now = time.monotonic()
            if not paused:
                remaining = max(0.0, remaining - (now - resumed_at))
            resumed_at = now
            if interactive:
                cols, rows = shutil.get_terminal_size((80, 24))
                canvas = Canvas(max(20, cols), max(8, rows), colour)
                theme.draw(canvas, now)
                compose(canvas, goal, remaining, total, paused, started_at,
                        at if picking else None, default)
                frame(canvas)
            if remaining <= 0:
                completed = True
                if not preview:
                    message = alarm(goal, minutes)
                    if interactive and finale:
                        celebrate(theme, goal, minutes, colour)
                break

            if not interactive:
                time.sleep(min(remaining, 1.0))
                continue

            ready, _, _ = select.select([sys.stdin], [], [], FRAME)
            if not ready and not unread():
                continue
            key = read_key()
            if picking:                        # the rota is up; the block runs on
                if key in ("left", "up", "right", "down"):
                    at = (at + (1 if key in ("right", "down") else -1)) % len(rota)
                    theme_name = rota[at]
                    theme = scene(at)
                elif key in ("d", "D"):        # this one, from now on
                    default = keep_default(rota[at])
                elif key in ("t", "T", "\r", "\n", "\x1b", "q", "Q"):
                    picking = False            # q closes the rota, it does not stop
                elif key == " ":
                    paused = not paused
                continue
            if key in ("q", "Q", "\x1b"):
                break
            if key == " ":
                paused = not paused
            if key in ("t", "T"):
                picking = True
    except KeyboardInterrupt:
        pass
    finally:
        if interactive:
            sys.stdout.write("\033[?25h\033[?1049l")
            sys.stdout.flush()
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_attrs)

    actual = (total - remaining) / 60.0
    if preview:
        print("Preview of the %s theme — %s" % (theme_name, THEMES[theme_name].blurb))
        return 0

    record(started_at, goal, minutes, actual, completed, theme_name)
    if completed:
        finished(message, colour, quiet=not (interactive and finale))
    else:
        print("Stopped after %.1f min of %g — %s" % (actual, minutes, goal))
    return 0 if completed else 1


def read_log(since=None, until=None, limit=None):
    """Blocks, oldest first, in the CSV's shape whatever the source.

    Signed in, the account is the record and this asks it; signed out it is
    ~/focus/sessions.csv, exactly as before. `since` and `until` are local
    wall-clock datetimes, `until` is exclusive so a day and the next never
    both claim a block on the boundary, and `limit` takes the most recent N.
    """
    if not signed_in():
        return local_log(since, until, limit)

    params = {}
    if since is not None:
        params["since"] = aware(since).isoformat()
    if until is not None:
        params["until"] = aware(until).isoformat()
    if limit is not None:
        # The API refuses more than a thousand in one go, and a terminal that
        # wanted to print more than that was not going to be read anyway.
        params["limit"] = min(limit, 1000)
    answer = api("GET", "/focus/sessions", params=params)
    return [as_row(session) for session in answer["sessions"]]


def local_log(since=None, until=None, limit=None):
    """The same read against the CSV, which is already in the order it
    happened — it has only ever been appended to."""
    if not os.path.exists(LOG_FILE):
        return []
    with open(LOG_FILE, newline="") as fh:
        rows = list(csv.DictReader(fh))
    if since is not None or until is not None:
        kept = []
        for row in rows:
            started = datetime.fromisoformat(row["started"])
            if since is not None and started < since:
                continue
            if until is not None and started >= until:
                continue
            kept.append(row)
        rows = kept
    return rows[-limit:] if limit else rows


def summary():
    """Minutes today, minutes over the last seven days, blocks ever.

    The three numbers --log prints above its tail. Both window edges are
    worked out here, from this machine's clock, because "today" is a local
    question and the server has no business guessing the answer.
    """
    midnight = datetime.combine(date.today(), datetime.min.time())
    week = midnight - timedelta(days=6)
    if signed_in():
        answer = api("GET", "/focus/sessions/summary", params={
            "day_since": aware(midnight).isoformat(),
            "week_since": aware(week).isoformat(),
        })
        return (answer["today_minutes"], answer["week_minutes"],
                answer["total_sessions"])

    rows = local_log()
    today_min = week_min = 0.0
    for row in rows:
        started = datetime.fromisoformat(row["started"])
        minutes = float(row["actual_minutes"])
        if started >= midnight:
            today_min += minutes
        if started >= week:
            week_min += minutes
    return today_min, week_min, len(rows)


def paint(text, tint, colour=True):
    return (tint + text + RESET) if (colour and tint) else text


def spell(minutes):
    """95 minutes reads better as 1 h 35 min."""
    minutes = int(round(minutes))
    hours, rest = divmod(minutes, 60)
    if not hours:
        return "%d min" % rest
    return "%d h" % hours if not rest else "%d h %d min" % (hours, rest)


def stamp(moment, day, width=5):
    """23:50-00:15 is one block, not a span running backwards, so an end that
    falls on the next day says so."""
    clock = moment.strftime("%H:%M")
    if moment.date() == day or clock == "00:00":   # midnight belongs to both
        return "%-*s" % (width, clock)
    return "%-*s" % (width, clock + "+1")


def parse_when(text):
    """A day, written as it comes to mind.

    today, yesterday, a weekday name for the most recent one, a bare number
    for that day of this month, or a date — day first, as parse_birthday reads
    it: 14-9, 14/09/2026, or ISO. Returns None if it cannot be read.
    """
    today = date.today()
    word = text.strip().lower()
    if word in ("", "today"):
        return today
    if word in ("yesterday", "yday"):
        return today - timedelta(days=1)
    if len(word) >= 3 and word.isalpha():
        for back in range(7):                  # the most recent Tuesday, etc.
            day = today - timedelta(days=back)
            if day.strftime("%A").lower().startswith(word):
                return day
        return None

    for separator in "-/.,":
        word = word.replace(separator, " ")
    parts = [part for part in word.split() if part.isdigit()]
    try:
        if len(parts) == 3 and len(parts[0]) == 4:
            return date(int(parts[0]), int(parts[1]), int(parts[2]))
        if len(parts) == 3:
            year = int(parts[2])
            return date(year + 2000 if year < 100 else year, int(parts[1]), int(parts[0]))
        # A day with no year, or no month, means the most recent one that has
        # already happened — nobody asks what they did next Thursday.
        if len(parts) == 2:
            day = date(today.year, int(parts[1]), int(parts[0]))
            return day if day <= today else date(today.year - 1, int(parts[1]), int(parts[0]))
        if len(parts) == 1:
            day = date(today.year, today.month, int(parts[0]))
            if day > today:
                month = today.month - 1 or 12
                day = date(today.year - (today.month == 1), month, int(parts[0]))
            return day
    except ValueError:
        return None
    return None


def blocks_on(rows, day):
    """Every session that started on that day, in the order it happened."""
    blocks = []
    for row in rows:
        started = datetime.fromisoformat(row["started"])
        if started.date() != day:
            continue
        minutes = float(row["actual_minutes"])
        blocks.append((started, started + timedelta(minutes=minutes), minutes,
                       row["goal"], row["completed"] == "yes"))
    return sorted(blocks)


def strip(blocks, width):
    """The day as one row of cells, from the hour the first block started to
    the hour the last one ended: filled where you were working, dots between."""
    first = blocks[0][0].replace(minute=0, second=0, microsecond=0)
    last = max(block[1] for block in blocks)
    ceiling = last.replace(minute=0, second=0, microsecond=0)
    if ceiling < last:
        ceiling += timedelta(hours=1)
    span = max((ceiling - first).total_seconds(), 3600.0)
    cells = ["·"] * width
    for started, ended, _, _, completed in blocks:
        start = int((started - first).total_seconds() / span * width)
        stop = int(math.ceil((ended - first).total_seconds() / span * width))
        for cell in range(max(0, start), min(width, max(stop, start + 1))):
            cells[cell] = "█" if completed else "▒"
    return first, ceiling, "".join(cells)


def show_day(rows, day, colour, cols):
    """One day: what each block was for, when it started, when it stopped."""
    title = day.strftime("%A %-d %B")
    if day.year != date.today().year:
        title += day.strftime(" %Y")
    blocks = blocks_on(rows, day)
    if not blocks:
        print("%s — nothing logged." % paint(title, BOLD, colour))
        return 0.0

    focused = sum(block[2] for block in blocks)
    # Wider columns only on a day that needs them: most days end before midnight.
    width = 7 if any(block[1].date() != day for block in blocks) else 5
    last = max(block[1] for block in blocks)
    summary = ("%d block%s · %s focused · %s to %s"
               % (len(blocks), "" if len(blocks) == 1 else "s", spell(focused),
                  blocks[0][0].strftime("%H:%M"), stamp(last, day).strip()))
    heading = paint(title, BOLD + ACCENT, colour)
    if len(title) + len(summary) + 3 <= cols:
        print("%s — %s" % (heading, summary))
    else:                                      # too narrow for one line
        print(heading)
        print("  %s" % paint(summary, DIM, colour))
    print()

    room = max(20, cols - 38)
    for index, (started, ended, minutes, goal, completed) in enumerate(blocks):
        if index:
            gap = (started - blocks[index - 1][1]).total_seconds() / 60.0
            if gap >= 5:
                print(paint("    ⋯  %s away" % spell(gap), DIM, colour))
        if len(goal) > room - (width - 5):
            goal = goal[: room - 1] + "…"
        # Pad before colouring: the escape codes would count towards a width.
        state = paint("%-7s" % ("done" if completed else "stopped"),
                      GREEN if completed else AMBER, colour)
        print("  %s–%s  %6s min  %s  %s"
              % (started.strftime("%H:%M"), stamp(ended, day, width),
                 "%.1f" % minutes, state, goal))

    print()
    start, end, cells = strip(blocks, max(12, min(cols - 16, 60)))
    print("  %s %s %s" % (paint(start.strftime("%H:%M"), DIM, colour),
                          paint(cells, ACCENT, colour),
                          paint(stamp(end, day).strip(), DIM, colour)))
    return focused


def show_history(when):
    """--history: a day at a time, or the last seven days at once."""
    colour = colours_on()
    cols = shutil.get_terminal_size((80, 24)).columns
    today = date.today()

    word = (when or "today").strip().lower()
    a_week = word in ("week", "7", "7d")
    if a_week:
        days = [today - timedelta(days=back) for back in range(6, -1, -1)]
    else:
        day = parse_when(word)
        if day is None:
            print("I could not read \"%s\" as a day. Try today, yesterday, "
                  "monday, 14-9 or 2026-09-14." % when, file=sys.stderr)
            return 1
        days = [day]

    # One read for the whole span however many days it covers: the account is
    # a network hop away, and seven of them to draw one week would be silly.
    start = datetime.combine(days[0], datetime.min.time())
    end = datetime.combine(days[-1] + timedelta(days=1), datetime.min.time())
    try:
        rows = read_log(since=start, until=end)
        if not rows and not summary()[2]:
            print("No sessions yet. Run: focus \"your goal\"")
            return 0

        if a_week:
            days = [day for day in days if blocks_on(rows, day)]
            if not days:
                print("Nothing logged in the last seven days.")
                return 0

        total = 0.0
        for index, day in enumerate(days):
            if index:
                print()
            total += show_day(rows, day, colour, cols)

        if len(days) > 1:
            print("\n%s across %d days." % (paint(spell(total), BOLD, colour), len(days)))
        elif not total:
            earlier = read_log(until=start, limit=1)
            if earlier:
                seen = datetime.fromisoformat(earlier[0]["started"]).date()
                print("The last block before that was %s."
                      % seen.strftime("%A %-d %B"))
    except ApiError as error:
        print(error, file=sys.stderr)
        return 1
    return 0


def show_log(limit):
    try:
        today_min, week_min, total = summary()
        rows = read_log(limit=limit)
    except ApiError as error:
        print(error, file=sys.stderr)
        return 1
    if not rows:
        print("No sessions yet. Run: focus \"your goal\"")
        return 0

    print("Today %d min · last 7 days %d min · %d sessions logged\n"
          % (today_min, week_min, total))

    goal_width = max(20, min(50, max(len(r["goal"]) for r in rows)))
    for row in rows:
        when = datetime.fromisoformat(row["started"])
        goal = row["goal"]
        if len(goal) > goal_width:
            goal = goal[: goal_width - 1] + "…"
        print("%s  %-*s  %5s min  %s"
              % (when.strftime("%a %d %b %H:%M"), goal_width, goal,
                 row["actual_minutes"],
                 "done" if row["completed"] == "yes" else "stopped"))
    return 0


def main():
    default_theme = default_scene()
    parser = argparse.ArgumentParser(
        prog="focus",
        description="Name a goal, then count %d minutes down against it." % DEFAULT_MINUTES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="themes:\n  " + "\n  ".join(
            ["%-9s %s" % (name, theme.blurb) for name, theme in THEMES.items()]
            + ["%-9s %s" % (RANDOM, "one of the above, drawn fresh for each block")]
        ) + "\n\nspace pauses, q stops early, t opens the scene picker: the arrows\n"
          "walk it, d keeps one as the default, t, enter or escape leave it.\n"
          "A finished block\n"
          "asks what comes next:\n"
          "f starts a new session, r runs the same goal again, q quits.\n"
          "Sessions are logged to " + LOG_FILE
          + ",\nor to your Bang Labs account once you have run focus --login.",
    )
    parser.add_argument("goal", nargs="*", help="what this block is for")
    parser.add_argument("-m", "--minutes", type=float, default=DEFAULT_MINUTES,
                        help="length of the countdown (default: %d)" % DEFAULT_MINUTES)
    parser.add_argument("-t", "--theme", choices=sorted(THEMES) + [RANDOM],
                        default=default_theme,
                        help="scene behind the clock (default: %s — d in the "
                             "picker, or $FOCUS_THEME)" % default_theme)
    parser.add_argument("-p", "--preview", metavar="THEME",
                        choices=sorted(THEMES) + [RANDOM], nargs="?", const=default_theme,
                        help="watch a theme run, logging nothing; q to leave")
    parser.add_argument("--me", action="store_true",
                        help="set the name and birthday focus greets you by")
    parser.add_argument("--login", action="store_true",
                        help="sign in, so the history follows you between machines")
    parser.add_argument("--logout", action="store_true",
                        help="forget the account on this machine")
    parser.add_argument("--whoami", action="store_true",
                        help="which account this machine keeps its blocks in")
    parser.add_argument("--sync", action="store_true",
                        help="send blocks that could not be uploaded when they ended")
    parser.add_argument("--upload", action="store_true",
                        help="send this machine's ~/focus/sessions.csv to the account")
    parser.add_argument("--no-finale", action="store_true",
                        help="end quietly, without the finish animation")
    parser.add_argument("-l", "--log", action="store_true",
                        help="show the sessions logged so far and exit")
    parser.add_argument("-H", "--history", metavar="WHEN", nargs="?", const="today",
                        help="what you did on a day: today, yesterday, monday, "
                             "14-9, 2026-09-14, or week (default: today)")
    parser.add_argument("-n", "--limit", type=int, default=15,
                        help="how many sessions --log prints (default: 15)")
    args = parser.parse_args()

    if args.login:
        return do_login()

    if args.logout:
        return do_logout()

    if args.whoami:
        return do_whoami()

    if args.sync:
        return do_sync()

    if args.upload:
        if not signed_in():
            print("Not signed in. Run: focus --login", file=sys.stderr)
            return 1
        return upload_csv()

    if args.me:
        ask_profile(force=True)
        return 0

    if args.history is not None:
        return show_history(args.history)

    if args.log:
        return show_log(args.limit)

    if args.minutes <= 0:
        parser.error("--minutes must be greater than zero")

    signal.signal(signal.SIGINT, signal.default_int_handler)

    if args.preview:
        return countdown(" ".join(args.goal).strip() or "theme preview",
                         args.minutes, args.preview, preview=True)

    ask_profile()

    goal = " ".join(args.goal).strip() or ask_goal()
    if not goal:
        print("A block needs a goal. Nothing started.", file=sys.stderr)
        return 1

    finale = not args.no_finale
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    while True:
        status = countdown(goal, args.minutes, args.theme, finale=finale)
        if status != 0 or not (interactive and finale):
            return status                        # stopped early, or nobody to ask
        goal = again(goal, args.minutes, colours_on())
        if not goal:
            return status


if __name__ == "__main__":
    sys.exit(main())
