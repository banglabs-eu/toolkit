class Stalled(Exception):
    """The filesystem did not answer in time."""


# --------------------------------------------------------------------------- subprocess

def run_guarded(cmd, timeout, capture_stdout=True):
    """
    Run cmd under a wall-clock timeout and return (stdout, stderr).

    A child wedged on unresponsive storage cannot be killed, so we make one
    best-effort attempt to reap it and then abandon it rather than block the scan.
    """
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE if capture_stdout else subprocess.DEVNULL,
        stderr=subprocess.PIPE,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate(timeout=5)
        except Exception:
            pass                      # unkillable D state: leave it behind, keep going
        raise Stalled("no response after {}s".format(timeout))
    if proc.returncode != 0:
        lines = (err or b"").decode("utf-8", "replace").strip().splitlines()
        raise ValueError(lines[-1][:150] if lines else
                         "exit status {}".format(proc.returncode))
    return out, err


def probe(path):
    """(duration_seconds, {tag: value}) via ffprobe."""
    out, _ = run_guarded(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-show_entries", "format_tags", "-of", "json", path],
        PROBE_TIMEOUT)
    try:
        info = json.loads(out.decode("utf-8", "replace")).get("format", {})
    except json.JSONDecodeError:
        raise ValueError("ffprobe returned no usable metadata")
    try:
        duration = float(info.get("duration") or 0.0)
    except (TypeError, ValueError):
        duration = 0.0
    tags = {str(k).lower(): v for k, v in (info.get("tags") or {}).items()}
    return duration, tags


def decode_and_measure(path):
    """
    One decode of the whole track, producing both:
      - the audio as mono float32 at SAMPLE_RATE, for tempo and key
      - EBU R128 integrated loudness, loudness range and true peak, at native rate

    Splitting the stream inside ffmpeg means the file crosses the network once.
    """
    import numpy as np

    out, err = run_guarded(
        ["ffmpeg", "-v", "info", "-nostdin", "-i", path,
         "-filter_complex",
         "[0:a]asplit=2[a][b];"
         "[a]ebur128=peak=true[e];"
         "[b]aresample={},aformat=sample_fmts=flt:channel_layouts=mono[m]".format(SAMPLE_RATE),
         "-map", "[m]", "-f", "f32le", "-",
         "-map", "[e]", "-f", "null", "-"],
        DECODE_TIMEOUT)

    samples = np.frombuffer(out, dtype=np.float32)
    text = (err or b"").decode("utf-8", "replace")

    loudness = peak_db = lra = None
    summary = text.rsplit("Integrated loudness:", 1)
    if len(summary) == 2:
        match = re.search(r"I:\s*(-?[\d.]+)\s*LUFS", summary[1])
        if match:
            loudness = float(match.group(1))
        # "LRA:" and not "LRA low:"/"LRA high:", which report levels rather than range.
        match = re.search(r"LRA:\s*(-?[\d.]+)\s*LU", summary[1])
        if match:
            lra = float(match.group(1))
    match = re.search(r"Peak:\s*(-?[\d.]+)\s*dBFS", text)
    if match:
        peak_db = float(match.group(1))

    return samples, loudness, peak_db, lra


# --------------------------------------------------------------------------- files

def find_audio_files(root):
    """Every audio file under root, skipping hidden files and macOS ._ resource forks."""
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for name in filenames:
            if name.startswith("."):
                continue
            if os.path.splitext(name)[1].lower() in AUDIO_EXTS:
                found.append(os.path.join(dirpath, name))
    found.sort()
    return found


def describe(path, tags):
    """Title / artist / album, from the file's tags, falling back to its path."""
    def tag(*names):
        for name in names:
            value = tags.get(name)
            if value:
                return str(value).strip()
        return ""

    title = tag("title") or os.path.splitext(os.path.basename(path))[0]
    artist = tag("artist", "album_artist", "albumartist")
    album = tag("album") or os.path.basename(os.path.dirname(path))
    if not artist:
        # .../Artists/<artist>/<album>/<track>  ->  the folder two levels up
        parts = os.path.normpath(path).split(os.sep)
        artist = parts[-3] if len(parts) >= 3 else ""
    return title, artist, album


# --------------------------------------------------------------------------- analysis

def tempo_function():
    """librosa keeps moving its tempo estimator; find whichever one this build has."""
    import librosa
    for owner, name in ((getattr(librosa.feature, "rhythm", None), "tempo"),
                        (librosa.feature, "tempo"),
                        (librosa.beat, "tempo")):
        if owner is not None and hasattr(owner, name):
            return getattr(owner, name)
    raise RuntimeError("this librosa build exposes no tempo estimator")


def fold_to(value, reference):
    """Halve or double value until it sits closest to reference."""
    if value <= 0 or reference <= 0:
        return value
    while value / reference > 1.45:
        value /= 2.0
    while value / reference < 0.69:
        value *= 2.0
    return value


def window_slices(total_samples):
    """Sample ranges for the windows we analyse, spread across the track."""
    length = int(WINDOW_SECONDS * SAMPLE_RATE)
    start = int(SKIP_INTRO_SECONDS * SAMPLE_RATE)
    end = max(0, total_samples - int(SKIP_OUTRO_SECONDS * SAMPLE_RATE))
    if end - start < length:
        return [(0, total_samples)]                 # short track: take it whole
    span = end - start - length
    return [(start + int(span * f), start + int(span * f) + length)
            for f in (0.15, 0.5, 0.85)]


def detect_key(chroma_mean):
    """(key name, confidence) from an averaged chroma vector, Krumhansl-Schmuckler."""
    import numpy as np

    vector = np.asarray(chroma_mean, dtype=float)
    if vector.sum() <= 0:
        return "", 0.0
    vector = vector - vector.mean()

    scores = []
    for profile, suffix in ((KRUMHANSL_MAJOR, ""), (KRUMHANSL_MINOR, "m")):
        base = np.asarray(profile, dtype=float)
        base = base - base.mean()
        for tonic in range(12):
            rotated = np.roll(base, tonic)
            denominator = np.linalg.norm(vector) * np.linalg.norm(rotated)
            correlation = float(vector.dot(rotated) / denominator) if denominator else 0.0
            scores.append((correlation, PITCH_NAMES[tonic] + suffix))

    scores.sort(reverse=True)
    best, runner_up = scores[0], scores[1]
    # How clearly the winner beats the next candidate, not how well it fits overall.
    confidence = max(0.0, min(1.0, (best[0] - runner_up[0]) * 4.0))
    return best[1], round(confidence, 3)


def rate_energy(loudness, centroid_hz, onset_rate):
    """A 1-10 energy score. Heuristic: loudness, brightness and how busy the beat is."""
    def scale(value, low, high):
        if value is None:
            return 0.5
        return max(0.0, min(1.0, (value - low) / (high - low)))

    loud = scale(loudness, -30.0, -6.0)
    bright = scale(centroid_hz, 700.0, 3500.0)
    drive = scale(onset_rate, 0.5, 5.0)
    blended = 0.45 * loud + 0.25 * bright + 0.30 * drive
    return int(round(1 + 9 * blended))


def pulse_clarity(onset, sr, hop=512):
    """
    How strongly a steady beat stands out of the onset envelope, 0-1.

    The envelope is autocorrelated and the largest peak over musically plausible
    lags (40-200 BPM) taken, normalised by the zero-lag energy. Dance music lands
    near 0.8, a rubato piano ballad near 0.15 -- and neither number moves when the
    master gets louder, which is exactly what the energy rating cannot manage.
    """
    import numpy as np

    centred = onset - onset.mean()
    if centred.size < 32 or not np.any(centred):
        return None
    correlation = np.correlate(centred, centred, mode="full")[centred.size - 1:]
    if correlation[0] <= 0:
        return None
    correlation = correlation / correlation[0]
    low = max(1, int(60.0 / 200.0 * sr / hop))       # 200 BPM: shortest lag we believe
    high = min(correlation.size, int(60.0 / 40.0 * sr / hop))   # 40 BPM: longest
    if high <= low:
        return None
    return float(max(0.0, min(1.0, correlation[low:high].max())))


def percussive_share(spectrum):
    """Fraction of spectral energy in the percussive half of an HPSS split, 0-1."""
    import numpy as np
    import librosa

    harmonic, percussive = librosa.decompose.hpss(spectrum)
    total = float((harmonic ** 2).sum() + (percussive ** 2).sum())
    if total <= 0:
        return None
    return float((percussive ** 2).sum() / total)


def dynamic_spread(spectrum):
    """Loud-to-quiet spread in dB across frames: 95th percentile minus 10th."""
    import numpy as np
    import librosa

    rms = librosa.feature.rms(S=spectrum)[0]
    if rms.size < 8 or not np.any(rms):
        return None
    db = librosa.amplitude_to_db(rms + 1e-9)
    return float(np.percentile(db, 95) - np.percentile(db, 10))


def analyse_audio(samples, loudness):
    """Tempo, key, energy and the rhythm measures, from the decoded track."""
    import numpy as np
    import librosa

    tempo = tempo_function()
    estimates = []
    chromas = []
    centroids = []
    onset_rates = []
    pulses = []
    percussives = []
    spreads = []

    for start, end in window_slices(samples.size):
        block = np.ascontiguousarray(samples[start:end], dtype=np.float32)
        if block.size < SAMPLE_RATE * 5:
            continue

        # One STFT per window, shared by brightness, HPSS and the RMS spread, rather
        # than letting each librosa helper compute its own.
        spectrum = np.abs(librosa.stft(block))

        onset = librosa.onset.onset_strength(y=block, sr=SAMPLE_RATE)
        if onset.size >= 16 and np.any(onset):
            clarity = pulse_clarity(onset, SAMPLE_RATE)
            if clarity is not None:
                pulses.append(clarity)
            value = float(np.atleast_1d(
                tempo(onset_envelope=onset, sr=SAMPLE_RATE, aggregate=np.median))[0])
            if value > 0:
                estimates.append(value)
            peaks = librosa.util.peak_pick(onset, pre_max=3, post_max=3, pre_avg=3,
                                           post_avg=5, delta=0.2, wait=3)
            onset_rates.append(len(peaks) / (block.size / float(SAMPLE_RATE)))

        chromas.append(librosa.feature.chroma_cqt(y=block, sr=SAMPLE_RATE).mean(axis=1))
        centroids.append(float(
            librosa.feature.spectral_centroid(S=spectrum, sr=SAMPLE_RATE).mean()))

        share = percussive_share(spectrum)
        if share is not None:
            percussives.append(share)
        spread = dynamic_spread(spectrum)
        if spread is not None:
            spreads.append(spread)

    if not estimates:
        raise ValueError("no tempo found (silent or too short)")

    anchor = float(np.median(estimates))
    folded = [fold_to(v, anchor) for v in estimates]
    bpm = float(np.median(folded))

    if len(folded) > 1:
        spread = max(folded) / min(folded) - 1.0       # 0.0 means every window agreed
        confidence = max(0.0, 1.0 - spread * 8.0)
        if any(abs(np.log2(v / bpm)) > 0.12 for v in estimates):
            confidence *= 0.6                          # windows disagreed on beat level
    else:
        confidence = 0.5                               # one window: nothing to cross-check

    key, key_confidence = detect_key(np.mean(chromas, axis=0)) if chromas else ("", 0.0)
    energy = rate_energy(loudness,
                         float(np.mean(centroids)) if centroids else None,
                         float(np.mean(onset_rates)) if onset_rates else None)

    def median(values, digits=3):
        return round(float(np.median(values)), digits) if values else None

    return {
        "bpm": round(bpm, 1),
        "confidence": round(confidence, 3),
        "key": key,
        "key_confidence": key_confidence,
        "mode": "minor" if key.endswith("m") else ("major" if key else ""),
        "energy": energy,
        "pulse": median(pulses),
        "percussive": median(percussives),
        "dynamics": median(spreads, 1),
        "centroid_hz": round(float(np.mean(centroids)), 1) if centroids else None,
    }


def analyse(path):
    """Worker entry point. Always returns a record, error or not."""
    record = {"path": path, "bpm": None, "confidence": 0.0, "duration": None,
              "key": "", "key_confidence": 0.0, "mode": "", "energy": None,
              "pulse": None, "percussive": None, "dynamics": None, "centroid_hz": None,
              "loudness": None, "peak_db": None, "gain_db": None, "lra": None,
              "features": FEATURE_VERSION, "error": ""}
    tags = {}
    try:
        duration, tags = probe(path)
        record["duration"] = round(duration, 1) if duration else None

        samples, loudness, peak_db, lra = decode_and_measure(path)
        record["loudness"] = loudness
        record["peak_db"] = peak_db
        record["lra"] = lra
        if loudness is not None and loudness > -70.0:      # -70 LUFS means silence
            record["gain_db"] = round(REPLAYGAIN_REFERENCE_LUFS - loudness, 2)

        record.update(analyse_audio(samples, loudness))
    except Stalled as exc:
        record["error"] = "stalled: {}".format(exc)
    except Exception as exc:
        record["error"] = "{}: {}".format(type(exc).__name__, exc)[:180]

    title, artist, album = describe(path, tags)
    record.update(title=title, artist=artist, album=album)
    return record


# --------------------------------------------------------------------------- tagging

def tag_values(record):
    """The tag name/value pairs we want stored for one track."""
    values = {}
    if record.get("bpm") is not None:
        values["bpm"] = str(int(round(record["bpm"])))
    if record.get("key"):
        values["key"] = record["key"]
    if record.get("energy") is not None:
        values["energy"] = str(record["energy"])
    if record.get("gain_db") is not None:
        values["replaygain_track_gain"] = "{:.2f} dB".format(record["gain_db"])
    if record.get("peak_db") is not None:
        values["replaygain_track_peak"] = "{:.6f}".format(10.0 ** (record["peak_db"] / 20.0))
    return values


def write_tags(path, values):
    """
    Store values in the file's tags, using each format's own conventions.
    Returns 'written' or 'unchanged'.
    """
    import mutagen
    from mutagen.id3 import ID3, TBPM, TKEY, TXXX
    from mutagen.flac import FLAC
    from mutagen.oggvorbis import OggVorbis
    from mutagen.mp4 import MP4, MP4FreeForm

    audio = mutagen.File(path)
    if audio is None:
        raise ValueError("unsupported container")

    changed = False

    if isinstance(audio, (FLAC, OggVorbis)):
        # Vorbis comments: plain uppercase keys.
        mapping = {"bpm": "BPM", "key": "INITIALKEY", "energy": "ENERGYLEVEL",
                   "replaygain_track_gain": "REPLAYGAIN_TRACK_GAIN",
                   "replaygain_track_peak": "REPLAYGAIN_TRACK_PEAK"}
        for name, value in values.items():
            field = mapping[name]
            if audio.get(field, [None])[0] != value:
                audio[field] = value
                changed = True

    elif isinstance(audio, MP4):
        # iTunes atoms: tmpo is a real integer, the rest are freeform strings.
        if "bpm" in values and audio.get("tmpo", [None])[0] != int(values["bpm"]):
            audio["tmpo"] = [int(values["bpm"])]
            changed = True
        freeform = {"key": "initialkey", "energy": "energylevel",
                    "replaygain_track_gain": "replaygain_track_gain",
                    "replaygain_track_peak": "replaygain_track_peak"}
        for name, atom in freeform.items():
            if name not in values:
                continue
            field = "----:com.apple.iTunes:{}".format(atom)
            encoded = values[name].encode("utf-8")
            if bytes(audio.get(field, [b""])[0]) != encoded:
                audio[field] = [MP4FreeForm(encoded)]
                changed = True

    else:
        # Anything with ID3 (MP3, and AIFF/WAV that carry an ID3 chunk).
        try:
            id3 = ID3(path)
        except Exception:
            id3 = ID3()
        if "bpm" in values and str(id3.get("TBPM", "")) != values["bpm"]:
            id3.setall("TBPM", [TBPM(encoding=3, text=[values["bpm"]])])
            changed = True
        if "key" in values and str(id3.get("TKEY", "")) != values["key"]:
            id3.setall("TKEY", [TKEY(encoding=3, text=[values["key"]])])
            changed = True
        # ReplayGain and energy have no standard frame; TXXX is the convention.
        for name, description in (("replaygain_track_gain", "REPLAYGAIN_TRACK_GAIN"),
                                  ("replaygain_track_peak", "REPLAYGAIN_TRACK_PEAK"),
                                  ("energy", "ENERGYLEVEL")):
            if name not in values:
                continue
            existing = next((f for f in id3.getall("TXXX") if f.desc == description), None)
            if existing is None or str(existing) != values[name]:
                if existing is not None:
                    id3.delall("TXXX:{}".format(description))
                id3.add(TXXX(encoding=3, desc=description, text=[values[name]]))
                changed = True
        if changed:
            id3.save(path, v2_version=3)
        return "written" if changed else "unchanged"

    if changed:
        audio.save()
    return "written" if changed else "unchanged"


def tag_in_child(record, script):
    """
    Tag one file in a separate process, so a file the storage cannot serve costs
    one abandoned child rather than a stuck worker.
    """
    payload = json.dumps(tag_values(record))
    out, _ = run_guarded([sys.executable, script, "--tag-one", record["path"], payload],
                         TAG_TIMEOUT)
    return out.decode("utf-8", "replace").strip() or "written"


def tag_library(records, min_confidence, jobs, script, dry_run):
    targets = [r for r in records
               if r.get("bpm") is not None
               and r.get("confidence", 0.0) >= min_confidence
               and tag_values(r)]
    print("\n{} {} of {} tracks (confidence >= {:g})".format(
        "Would tag" if dry_run else "Tagging", len(targets), len(records), min_confidence),
        flush=True)

    if dry_run:
        for rec in targets[:10]:
            print("  {}  ->  {}".format(os.path.basename(rec["path"])[:50],
                                        tag_values(rec)))
        if len(targets) > 10:
            print("  ... and {} more".format(len(targets) - 10))
        return 0, 0, 0

    written = unchanged = failed = done = 0
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = {pool.submit(tag_in_child, r, script): r for r in targets}
        for future in as_completed(futures):
            rec = futures[future]
            try:
                if future.result() == "unchanged":
                    unchanged += 1
                else:
                    written += 1
            except Exception as exc:
                failed += 1
                if failed <= 20:
                    print("  could not tag {}: {}".format(
                        os.path.basename(rec["path"]), exc), flush=True)
            done += 1
            if done % 200 == 0 or done == len(targets):
                print("  {}/{} ({} written, {} already correct, {} failed)".format(
                    done, len(targets), written, unchanged, failed), flush=True)
    return written, unchanged, failed


# --------------------------------------------------------------------------- cache

def load_cache(cache_path):
    cached = {}
    if not os.path.exists(cache_path):
        return cached
    with open(cache_path, "r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue                      # a torn line from an interrupted run
            if record.get("path"):
                cached[record["path"]] = record       # later entries win
    return cached


# --------------------------------------------------------------------------- output

def write_csv(records, csv_path, root):
    def sort_key(rec):
        return (rec.get("bpm") is None, rec.get("bpm") or 0.0,
                rec.get("artist") or "", rec.get("title") or "")

    with open(csv_path, "w", encoding="utf-8-sig", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(["Title", "Artist", "Album", "BPM", "BPM_Half", "BPM_Double",
                         "Confidence", "Key", "KeyConfidence", "Mode", "Energy",
                         "Pulse", "Percussive", "Dynamics_dB",
                         "Loudness_LUFS", "LRA_LU", "ReplayGain_dB", "TruePeak_dBFS",
                         "Duration_sec", "Duration", "Path", "Error"])
        for rec in sorted(records, key=sort_key):
            bpm, seconds = rec.get("bpm"), rec.get("duration")

            def number(value, fmt="{:.1f}"):
                return "" if value is None else fmt.format(value)

            writer.writerow([
                rec.get("title", ""), rec.get("artist", ""), rec.get("album", ""),
                number(bpm), number(bpm / 2 if bpm else None),
                number(bpm * 2 if bpm else None),
                "" if bpm is None else "{:.3f}".format(rec.get("confidence", 0.0)),
                rec.get("key", ""),
                "" if not rec.get("key") else "{:.3f}".format(rec.get("key_confidence", 0.0)),
                rec.get("mode", ""),
                "" if rec.get("energy") is None else str(rec["energy"]),
                number(rec.get("pulse"), "{:.3f}"), number(rec.get("percussive"), "{:.3f}"),
                number(rec.get("dynamics")),
                number(rec.get("loudness")), number(rec.get("lra")),
                number(rec.get("gain_db"), "{:.2f}"),
                number(rec.get("peak_db")),
                number(seconds),
                "" if seconds is None else "{:d}:{:02d}".format(int(seconds) // 60, int(seconds) % 60),
                os.path.relpath(rec["path"], root),
                rec.get("error", ""),
            ])


def write_playlist(records, playlist_path, root, low, high, min_confidence,
                   title="Running", include_high=True):
    """Everything inside the BPM window, slowest first, as .m3u8 with relative paths."""
    def in_window(bpm):
        return low <= bpm <= high if include_high else low <= bpm < high

    picked = [r for r in records
              if r.get("bpm") is not None
              and in_window(r["bpm"])
              and r.get("confidence", 0.0) >= min_confidence]
    picked.sort(key=lambda r: (r["bpm"], r.get("artist") or "", r.get("title") or ""))

    with open(playlist_path, "w", encoding="utf-8", newline="\n") as handle:
        handle.write("#EXTM3U\n")
        handle.write("#PLAYLIST:{} {:g}-{:g} BPM\n".format(title, low, high))
        for rec in picked:
            handle.write("#EXTINF:{},{} - {} [{:.0f} BPM]\n".format(
                int(rec.get("duration") or 0), rec.get("artist", ""),
                rec.get("title", ""), rec["bpm"]))
            handle.write(os.path.relpath(rec["path"], root) + "\n")
    return picked


def scale(value, low, high, default=0.5):
    """Map a measurement onto 0-1 between two anchors, clamped."""
    if value is None:
        return default
    return max(0.0, min(1.0, (value - low) / (high - low)))


def cadence_fit(bpm, cadence):
    """
    How well a tempo matches a target step rate, 0-1.

    A runner lands on the beat, on every second beat, or takes two steps to the
    beat, so the track's double and half count too -- discounted, because a
    half-time match is a weaker pull than the real thing.
    """
    best = 0.0
    for candidate, discount in ((bpm, 1.0), (bpm * 2.0, 0.90), (bpm / 2.0, 0.85)):
        best = max(best, math.exp(
            -((candidate - cadence) / RUN_CADENCE_TOLERANCE) ** 2) * discount)
    return best


def score_run(record, cadence):
    """
    0-1 fitness as a feel-good running track, with the parts that made it.

    Deliberately not a function of loudness: how hard a record was mastered says
    nothing about whether it carries a run. Returns None for a track that was
    never measured with the rhythm features.
    """
    if record.get("bpm") is None or record.get("pulse") is None:
        return None

    # A confidently major key reads as bright, a confidently minor one as not; an
    # unsure reading stays near the middle rather than voting on noise.
    raw_mode = {"major": 1.0, "minor": 0.35}.get(record.get("mode"), 0.6)
    mode_score = 0.6 + (raw_mode - 0.6) * min(1.0, record.get("key_confidence") or 0.0)

    # Loudness range if ffmpeg gave us one, otherwise the in-window RMS spread.
    swing = record.get("lra")
    if swing is None:
        swing = record.get("dynamics")

    parts = {
        "cadence": cadence_fit(record["bpm"], cadence),
        "pulse": scale(record.get("pulse"), 0.25, 0.75),
        "percussive": scale(record.get("percussive"), 0.10, 0.35),
        "valence": 0.6 * mode_score + 0.4 * scale(record.get("centroid_hz"), 700.0, 3500.0),
        "consistency": 1.0 - scale(swing, 3.0, 14.0),
    }
    return sum(RUN_WEIGHTS[name] * value for name, value in parts.items()), parts


def write_run_mix(records, playlist_path, root, cadence, top, min_confidence):
    """The best-scoring tracks for a run, best first, one entry per song."""
    scored = []
    for rec in records:
        if (rec.get("confidence", 0.0) < min_confidence
                or (rec.get("duration") or 0.0) < RUN_MIN_DURATION):
            continue
        result = score_run(rec, cadence)
        if result:
            scored.append((result[0], rec))

    # One entry per song: the same track off a single and off an album is one song.
    best = {}
    for score, rec in scored:
        signature = ((rec.get("artist") or "").strip().lower(),
                     (rec.get("title") or "").strip().lower())
        if signature not in best or score > best[signature][0]:
            best[signature] = (score, rec)
    picked = sorted(best.values(), key=lambda pair: -pair[0])[:top]

    with open(playlist_path, "w", encoding="utf-8", newline="\n") as handle:
        handle.write("#EXTM3U\n")
        handle.write("#PLAYLIST:Run mix {:g} spm\n".format(cadence))
        for score, rec in picked:
            handle.write("#EXTINF:{},{} - {} [{:.0f} BPM, score {:.2f}]\n".format(
                int(rec.get("duration") or 0), rec.get("artist", ""),
                rec.get("title", ""), rec["bpm"], score))
            handle.write(os.path.relpath(rec["path"], root) + "\n")

    scorable = len(scored)
    print("Wrote {} ({} tracks, best {} of {} scorable, cadence {:g} spm)".format(
        playlist_path, len(picked), len(picked), scorable, cadence))
    if not scorable and records:
        print("  nothing scorable yet: the rhythm measures arrive with the next full "
              "run, which re-analyses tracks measured by an older version")
    return picked


def parse_band(text):
    """--band Run=130-150, or bare 130-150 with the window as its own name."""
    name, _, window = text.rpartition("=")
    match = re.match(r"^\s*(\d+(?:\.\d+)?)\s*-\s*(\d+(?:\.\d+)?)\s*$", window)
    if not match:
        raise argparse.ArgumentTypeError(
            "expected NAME=LOW-HIGH (e.g. Run=130-150), got {!r}".format(text))
    low, high = float(match.group(1)), float(match.group(2))
    if low >= high:
        raise argparse.ArgumentTypeError("{}: low must be below high".format(text))
    return (name.strip() or "BPM", low, high)


def band_filename(name, low, high):
    slug = re.sub(r"[^A-Za-z0-9]+", "-", name).strip("-").lower() or "bpm"
    return "{}_{:g}_{:g}.m3u8".format(slug, low, high)


def write_bands(records, bands, root, min_confidence):
    """One playlist per band. Half-open windows, so a track belongs to exactly one."""
    for name, low, high in bands:
        path = os.path.join(root, band_filename(name, low, high))
        picked = write_playlist(records, path, root, low, high, min_confidence,
                                title=name, include_high=False)
        print("Wrote {} ({} tracks, {:g}-{:g} BPM)".format(
            path, len(picked), low, high))


# --------------------------------------------------------------------------- main

# --------------------------------------------------------------------------- environment

def ensure_analysis_env():
    """
    Re-exec under the venv holding librosa and mutagen, building it on first run.

    Checked with sys.prefix rather than sys.executable: venv/bin/python is a
    symlink out to the system interpreter, so resolving the executable would
    look like we had never moved.
    """
    if os.path.realpath(sys.prefix) == os.path.realpath(VENV):
        return

    if not os.path.exists(VENV_PYTHON):
        print("Analysis environment missing, creating it (a few minutes)...", flush=True)
        os.makedirs(os.path.dirname(VENV), exist_ok=True)
        subprocess.check_call([sys.executable, "-m", "venv", VENV])
        subprocess.check_call([VENV_PYTHON, "-m", "pip", "install", "--quiet",
                               "librosa", "mutagen"])

    os.execv(VENV_PYTHON, [VENV_PYTHON, "-u", os.path.realpath(__file__)] + sys.argv[1:])


def main():
    ensure_analysis_env()

    script = os.path.realpath(__file__)      # realpath: it is symlinked into /usr/local/bin

    # Internal mode: tag a single file, used by the parent to isolate stalling storage.
    if len(sys.argv) == 4 and sys.argv[1] == "--tag-one":
        print(write_tags(sys.argv[2], json.loads(sys.argv[3])))
        return 0

    parser = argparse.ArgumentParser(
        description="Analyse tempo, key, loudness and energy across a music library.")
    parser.add_argument("--root", default=DEFAULT_ROOT,
                        help="library root (default: {})".format(DEFAULT_ROOT))
    parser.add_argument("--jobs", type=int, default=4,
                        help="parallel workers; keep low on network storage")
    parser.add_argument("--rescan", action="store_true",
                        help="ignore the cache and re-analyse everything")
    parser.add_argument("--retry-failed", action="store_true",
                        help="re-analyse only the tracks that previously failed")
    parser.add_argument("--limit", type=int, default=0, help="stop after N new files")
    parser.add_argument("--playlist", default=None,
                        help="single-window playlist filename "
                             "(default: running_130_160.m3u8, empty string to skip)")
    parser.add_argument("--band", action="append", type=parse_band, default=[],
                        metavar="NAME=LOW-HIGH",
                        help="write a playlist for this BPM window; repeatable")
    parser.add_argument("--bands", action="store_true",
                        help="write the default ladder of BPM playlists: " +
                             ", ".join("{} {:g}-{:g}".format(*b) for b in DEFAULT_BANDS))
    parser.add_argument("--run-mix", nargs="?", const="run_mix.m3u8", default=None,
                        metavar="FILE",
                        help="write a ranked feel-good running playlist "
                             "(default filename: run_mix.m3u8)")
    parser.add_argument("--cadence", type=float, default=170.0,
                        help="target steps per minute for --run-mix (default: 170)")
    parser.add_argument("--top", type=int, default=60,
                        help="how many tracks --run-mix keeps (default: 60)")
    parser.add_argument("--playlists-only", action="store_true",
                        help="build the playlists from the cache alone: no library "
                             "walk, no analysis, no CSV")
    parser.add_argument("--low", type=float, default=130.0, help="playlist lower BPM bound")
    parser.add_argument("--high", type=float, default=160.0, help="playlist upper BPM bound")
    parser.add_argument("--min-confidence", type=float, default=0.85,
                        help="keep unsteady estimates out of the playlist")
    parser.add_argument("--tag", action="store_true",
                        help="write the analysis into each file's tags (modifies your music)")
    parser.add_argument("--tag-dry-run", action="store_true",
                        help="show what --tag would do, without touching any file")
    parser.add_argument("--tag-min-confidence", type=float, default=0.0,
                        help="only tag tracks measured at least this confidently")
    args = parser.parse_args()

    root = os.path.abspath(args.root)
    cache_path = os.path.join(root, CACHE_NAME)
    csv_path = os.path.join(root, CSV_NAME)

    bands = list(args.band) + (DEFAULT_BANDS if args.bands else [])
    # Explicit --playlist always wins; otherwise the old single window is the default
    # only when no bands were asked for.
    playlist_name = args.playlist
    if playlist_name is None:
        playlist_name = "" if bands else "running_130_160.m3u8"

    if args.playlists_only:
        # Straight from the cache: the library walk is the slow part on network
        # storage, and nothing here needs to touch the audio.
        records = list(load_cache(cache_path).values())
        print("Loaded {} tracks from {}".format(len(records), cache_path), flush=True)
        if playlist_name:
            playlist_path = os.path.join(root, playlist_name)
            picked = write_playlist(records, playlist_path, root,
                                    args.low, args.high, args.min_confidence)
            print("Wrote {} ({} tracks between {:g} and {:g} BPM)".format(
                playlist_path, len(picked), args.low, args.high))
        write_bands(records, bands, root, args.min_confidence)
        if args.run_mix:
            write_run_mix(records, os.path.join(root, args.run_mix), root,
                          args.cadence, args.top, args.min_confidence)
        return 0

    files = find_audio_files(root)
    print("Found {} audio files under {}".format(len(files), root), flush=True)

    cached = {} if args.rescan else load_cache(cache_path)
    if args.retry_failed:
        cached = {p: r for p, r in cached.items() if not r.get("error")}

    # A record written before the current FEATURE_VERSION is missing measurements
    # this build knows how to take, so it is re-analysed like a new file. Errors are
    # left alone: retrying those is what --retry-failed is for.
    def outdated(path):
        record = cached.get(path)
        return (record is not None and not record.get("error")
                and record.get("features", 1) < FEATURE_VERSION)

    pending = [f for f in files if f not in cached or outdated(f)]
    stale = sum(1 for f in pending if f in cached)
    todo = pending[:args.limit] if args.limit else pending
    print("{} already measured, {} to analyse ({} new, {} re-measured for the "
          "newer features)".format(len(files) - len(pending), len(todo),
                                   len(todo) - min(stale, len(todo)),
                                   min(stale, len(todo))), flush=True)

    if todo:
        # Threads, not processes: each worker mostly waits on ffmpeg, and librosa's
        # heavy numeric work releases the GIL.
        with open(cache_path, "w" if args.rescan else "a", encoding="utf-8") as cache_file, \
                ThreadPoolExecutor(max_workers=args.jobs) as pool:
            futures = {pool.submit(analyse, path): path for path in todo}
            done = failed = 0
            for future in as_completed(futures):
                path = futures[future]
                try:
                    record = future.result()
                except Exception as exc:
                    record = {"path": path, "bpm": None, "confidence": 0.0, "duration": None,
                              "key": "", "key_confidence": 0.0, "mode": "", "energy": None,
                              "pulse": None, "percussive": None, "dynamics": None,
                              "centroid_hz": None, "loudness": None, "peak_db": None,
                              "gain_db": None, "lra": None, "features": FEATURE_VERSION,
                              "error": "worker failed: {}".format(exc)[:180],
                              "title": os.path.basename(path), "artist": "", "album": ""}
                cached[path] = record
                cache_file.write(json.dumps(record, ensure_ascii=False) + "\n")
                cache_file.flush()

                done += 1
                if record.get("error"):
                    failed += 1
                if done % 25 == 0 or done == len(todo):
                    print("  {}/{} analysed ({} failed)".format(done, len(todo), failed),
                          flush=True)

    records = [cached[f] for f in files if f in cached]
    write_csv(records, csv_path, root)
    measured = [r for r in records if r.get("bpm") is not None]
    print("\nWrote {}".format(csv_path))
    print("{} tracks measured, {} could not be read".format(
        len(measured), len(records) - len(measured)))

    if playlist_name:
        playlist_path = os.path.join(root, playlist_name)
        picked = write_playlist(records, playlist_path, root,
                                args.low, args.high, args.min_confidence)
        print("Wrote {} ({} tracks between {:g} and {:g} BPM)".format(
            playlist_path, len(picked), args.low, args.high))

    write_bands(records, bands, root, args.min_confidence)

    if args.run_mix:
        write_run_mix(records, os.path.join(root, args.run_mix), root,
                      args.cadence, args.top, args.min_confidence)

    if args.tag or args.tag_dry_run:
        written, unchanged, failed = tag_library(
            records, args.tag_min_confidence, args.jobs, script, args.tag_dry_run)
        if not args.tag_dry_run:
            print("Tagged {} files ({} already correct, {} failed)".format(
                written, unchanged, failed))
    return 0


if __name__ == "__main__":
    sys.exit(main())
