#!/usr/bin/env python3
"""
music-index -- Analyse a music library and record, for every track, its tempo,
musical key, loudness (ReplayGain) and an energy rating. Results go to a CSV you
can open in Excel, to a playlist built from a BPM window, and optionally into the
files' own tags.

Re-running only analyses what is not already in the cache, so adding music next
month costs the new tracks and nothing else. --rescan is the one flag that throws
that away and starts over.

Usage:
    music-index                    # analyse whatever is new in the library
    music-index --jobs 4           # parallel workers (be gentle on network storage)
    music-index --retry-failed     # re-try only the tracks that previously failed
    music-index --limit 20         # stop after 20 new files
    music-index --tag-dry-run      # preview what would be written to the files
    music-index --tag              # write the analysis into the files' tags
    music-index --root ~/other     # point it at a different library
    music-index --rescan           # ignore the cache, analyse everything again

Output, written next to the library root:
    bpm_index.csv          every track: title, artist, album, BPM, key, energy, path
    running_130_160.m3u8   the BPM window as a playlist, slowest track first
    .bpm_cache.jsonl       append-only cache, so an interrupted scan resumes

What gets measured, and how much to trust it
    Tempo      Three windows are taken from across the track, each turned into an
               onset-strength envelope whose dominant periodicity is the tempo. The
               three answers are folded onto a common metrical level and the median
               taken, so one window mishearing double-time cannot drag the result off.
               Their agreement becomes the Confidence column. Tempo detection cannot
               tell a bar from a half-bar, so a track may legitimately land on half or
               double its felt tempo -- hence the BPM_Half and BPM_Double columns.
    Key        Chroma averaged over those same windows, matched against the
               Krumhansl-Schmuckler profiles. Dependable on tonal pop and rock, much
               less so on classical, jazz and ambient material, so it is reported with
               its own KeyConfidence.
    Loudness   EBU R128 integrated loudness and true peak, measured by ffmpeg over the
               whole track. ReplayGain gain is referenced to -18 LUFS. These are
               standard-compliant numbers, not estimates.
    Energy     A 1-10 heuristic blending loudness, brightness and onset density. It is
               a convenience for ordering a run, not an established measure.

Why every file read goes through a subprocess
    This library lives on network storage (pCloud/FUSE). A file the server cannot
    serve puts the reading process into uninterruptible D state, where it ignores
    SIGKILL and cannot be timed out. So no worker touches the audio directly:
    decoding runs in an ffmpeg subprocess and tagging in a short child process, each
    under a wall-clock timeout. A stalled file costs one abandoned child rather than
    wedging the whole scan. Keep --jobs low; hammering the mount is what stalls it.
"""

import argparse
import csv
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed

DEFAULT_ROOT = os.path.expanduser("~/pCloudDrive/Audio/Music/Artists")

# librosa and mutagen are heavy, pip-only dependencies, so they live in their own
# environment rather than in the system Python. Nothing to activate by hand --
# ensure_analysis_env() puts this script there.
VENV = os.path.expanduser("~/.local/share/bpm-scan/venv")
VENV_PYTHON = os.path.join(VENV, "bin", "python")

# Keep numba's compile cache on disk, not /tmp, so a reboot does not force a slow
# first run while every track waits on a fresh JIT compile.
os.environ.setdefault("NUMBA_CACHE_DIR",
                      os.path.expanduser("~/.local/share/bpm-scan/numba-cache"))
os.makedirs(os.environ["NUMBA_CACHE_DIR"], exist_ok=True)

AUDIO_EXTS = {".mp3", ".flac", ".m4a", ".ogg", ".opus", ".wav", ".wma", ".aac", ".aiff", ".aif"}

SAMPLE_RATE = 22050        # plenty for tempo and chroma, and keeps the maths cheap
WINDOW_SECONDS = 45.0      # length of each analysis window
SKIP_INTRO_SECONDS = 15.0  # ignore this much of the start, when the track is long enough
SKIP_OUTRO_SECONDS = 10.0  # ...and this much of the end

PROBE_TIMEOUT = 60         # seconds to wait for ffprobe on one file
DECODE_TIMEOUT = 900       # seconds to wait for one full decode
TAG_TIMEOUT = 180          # seconds to wait for one tag write

REPLAYGAIN_REFERENCE_LUFS = -18.0    # ReplayGain 2.0 reference level

CSV_NAME = "bpm_index.csv"
CACHE_NAME = ".bpm_cache.jsonl"

PITCH_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
# Krumhansl-Kessler key profiles: how strongly each scale degree belongs to a key.
KRUMHANSL_MAJOR = [6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88]
KRUMHANSL_MINOR = [6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17]


class Stalled(Exception):
    """The filesystem did not answer in time."""


# --------------------------------------------------------------------------- subprocess

def run_guarded(cmd, timeout, capture_stdout=True):
    """
    Run cmd under a wall-clock timeout and return (stdout, stderr).

    A child wedged on unresponsive storage cannot be killed, so we make one
    best-effort attempt to reap it and then abandon it rather than block the scan.
    """
    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE if capture_stdout else subprocess.DEVNULL,
        stderr=subprocess.PIPE,
    )
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate(timeout=5)
        except Exception:
            pass                      # unkillable D state: leave it behind, keep going
        raise Stalled("no response after {}s".format(timeout))
    if proc.returncode != 0:
        lines = (err or b"").decode("utf-8", "replace").strip().splitlines()
        raise ValueError(lines[-1][:150] if lines else
                         "exit status {}".format(proc.returncode))
    return out, err


def probe(path):
    """(duration_seconds, {tag: value}) via ffprobe."""
    out, _ = run_guarded(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-show_entries", "format_tags", "-of", "json", path],
        PROBE_TIMEOUT)
    try:
        info = json.loads(out.decode("utf-8", "replace")).get("format", {})
    except json.JSONDecodeError:
        raise ValueError("ffprobe returned no usable metadata")
    try:
        duration = float(info.get("duration") or 0.0)
    except (TypeError, ValueError):
        duration = 0.0
    tags = {str(k).lower(): v for k, v in (info.get("tags") or {}).items()}
    return duration, tags


def decode_and_measure(path):
    """
    One decode of the whole track, producing both:
      - the audio as mono float32 at SAMPLE_RATE, for tempo and key
      - EBU R128 integrated loudness and true peak, measured at native rate

    Splitting the stream inside ffmpeg means the file crosses the network once.
    """
    import numpy as np

    out, err = run_guarded(
        ["ffmpeg", "-v", "info", "-nostdin", "-i", path,
         "-filter_complex",
         "[0:a]asplit=2[a][b];"
         "[a]ebur128=peak=true[e];"
         "[b]aresample={},aformat=sample_fmts=flt:channel_layouts=mono[m]".format(SAMPLE_RATE),
         "-map", "[m]", "-f", "f32le", "-",
         "-map", "[e]", "-f", "null", "-"],
        DECODE_TIMEOUT)

    samples = np.frombuffer(out, dtype=np.float32)
    text = (err or b"").decode("utf-8", "replace")

    loudness = peak_db = None
    summary = text.rsplit("Integrated loudness:", 1)
    if len(summary) == 2:
        match = re.search(r"I:\s*(-?[\d.]+)\s*LUFS", summary[1])
        if match:
            loudness = float(match.group(1))
    match = re.search(r"Peak:\s*(-?[\d.]+)\s*dBFS", text)
    if match:
        peak_db = float(match.group(1))

    return samples, loudness, peak_db


# --------------------------------------------------------------------------- files

def find_audio_files(root):
    """Every audio file under root, skipping hidden files and macOS ._ resource forks."""
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for name in filenames:
            if name.startswith("."):
                continue
            if os.path.splitext(name)[1].lower() in AUDIO_EXTS:
                found.append(os.path.join(dirpath, name))
    found.sort()
    return found


def describe(path, tags):
    """Title / artist / album, from the file's tags, falling back to its path."""
    def tag(*names):
        for name in names:
            value = tags.get(name)
            if value:
                return str(value).strip()
        return ""

    title = tag("title") or os.path.splitext(os.path.basename(path))[0]
    artist = tag("artist", "album_artist", "albumartist")
    album = tag("album") or os.path.basename(os.path.dirname(path))
    if not artist:
        # .../Artists/<artist>/<album>/<track>  ->  the folder two levels up
        parts = os.path.normpath(path).split(os.sep)
        artist = parts[-3] if len(parts) >= 3 else ""
    return title, artist, album


# --------------------------------------------------------------------------- analysis

def tempo_function():
    """librosa keeps moving its tempo estimator; find whichever one this build has."""
    import librosa
    for owner, name in ((getattr(librosa.feature, "rhythm", None), "tempo"),
                        (librosa.feature, "tempo"),
                        (librosa.beat, "tempo")):
        if owner is not None and hasattr(owner, name):
            return getattr(owner, name)
    raise RuntimeError("this librosa build exposes no tempo estimator")


def fold_to(value, reference):
    """Halve or double value until it sits closest to reference."""
    if value <= 0 or reference <= 0:
        return value
    while value / reference > 1.45:
        value /= 2.0
    while value / reference < 0.69:
        value *= 2.0
    return value


def window_slices(total_samples):
    """Sample ranges for the windows we analyse, spread across the track."""
    length = int(WINDOW_SECONDS * SAMPLE_RATE)
    start = int(SKIP_INTRO_SECONDS * SAMPLE_RATE)
    end = max(0, total_samples - int(SKIP_OUTRO_SECONDS * SAMPLE_RATE))
    if end - start < length:
        return [(0, total_samples)]                 # short track: take it whole
    span = end - start - length
    return [(start + int(span * f), start + int(span * f) + length)
            for f in (0.15, 0.5, 0.85)]


def detect_key(chroma_mean):
    """(key name, confidence) from an averaged chroma vector, Krumhansl-Schmuckler."""
    import numpy as np

    vector = np.asarray(chroma_mean, dtype=float)
    if vector.sum() <= 0:
        return "", 0.0
    vector = vector - vector.mean()

    scores = []
    for profile, suffix in ((KRUMHANSL_MAJOR, ""), (KRUMHANSL_MINOR, "m")):
        base = np.asarray(profile, dtype=float)
        base = base - base.mean()
        for tonic in range(12):
            rotated = np.roll(base, tonic)
            denominator = np.linalg.norm(vector) * np.linalg.norm(rotated)
            correlation = float(vector.dot(rotated) / denominator) if denominator else 0.0
            scores.append((correlation, PITCH_NAMES[tonic] + suffix))

    scores.sort(reverse=True)
    best, runner_up = scores[0], scores[1]
    # How clearly the winner beats the next candidate, not how well it fits overall.
    confidence = max(0.0, min(1.0, (best[0] - runner_up[0]) * 4.0))
    return best[1], round(confidence, 3)


def rate_energy(loudness, centroid_hz, onset_rate):
    """A 1-10 energy score. Heuristic: loudness, brightness and how busy the beat is."""
    def scale(value, low, high):
        if value is None:
            return 0.5
        return max(0.0, min(1.0, (value - low) / (high - low)))

    loud = scale(loudness, -30.0, -6.0)
    bright = scale(centroid_hz, 700.0, 3500.0)
    drive = scale(onset_rate, 0.5, 5.0)
    blended = 0.45 * loud + 0.25 * bright + 0.30 * drive
    return int(round(1 + 9 * blended))


def analyse_audio(samples, loudness):
    """Tempo, key and energy from the decoded track."""
    import numpy as np
    import librosa

    tempo = tempo_function()
    estimates = []
    chromas = []
    centroids = []
    onset_rates = []

    for start, end in window_slices(samples.size):
        block = np.ascontiguousarray(samples[start:end], dtype=np.float32)
        if block.size < SAMPLE_RATE * 5:
            continue

        onset = librosa.onset.onset_strength(y=block, sr=SAMPLE_RATE)
        if onset.size >= 16 and np.any(onset):
            value = float(np.atleast_1d(
                tempo(onset_envelope=onset, sr=SAMPLE_RATE, aggregate=np.median))[0])
            if value > 0:
                estimates.append(value)
            peaks = librosa.util.peak_pick(onset, pre_max=3, post_max=3, pre_avg=3,
                                           post_avg=5, delta=0.2, wait=3)
            onset_rates.append(len(peaks) / (block.size / float(SAMPLE_RATE)))

        chromas.append(librosa.feature.chroma_cqt(y=block, sr=SAMPLE_RATE).mean(axis=1))
        centroids.append(float(
            librosa.feature.spectral_centroid(y=block, sr=SAMPLE_RATE).mean()))

    if not estimates:
        raise ValueError("no tempo found (silent or too short)")

    anchor = float(np.median(estimates))
    folded = [fold_to(v, anchor) for v in estimates]
    bpm = float(np.median(folded))

    if len(folded) > 1:
        spread = max(folded) / min(folded) - 1.0       # 0.0 means every window agreed
        confidence = max(0.0, 1.0 - spread * 8.0)
        if any(abs(np.log2(v / bpm)) > 0.12 for v in estimates):
            confidence *= 0.6                          # windows disagreed on beat level
    else:
        confidence = 0.5                               # one window: nothing to cross-check

    key, key_confidence = detect_key(np.mean(chromas, axis=0)) if chromas else ("", 0.0)
    energy = rate_energy(loudness,
                         float(np.mean(centroids)) if centroids else None,
                         float(np.mean(onset_rates)) if onset_rates else None)

    return {
        "bpm": round(bpm, 1),
        "confidence": round(confidence, 3),
        "key": key,
        "key_confidence": key_confidence,
        "energy": energy,
    }


def analyse(path):
    """Worker entry point. Always returns a record, error or not."""
    record = {"path": path, "bpm": None, "confidence": 0.0, "duration": None,
              "key": "", "key_confidence": 0.0, "energy": None,
              "loudness": None, "peak_db": None, "gain_db": None, "error": ""}
    tags = {}
    try:
        duration, tags = probe(path)
        record["duration"] = round(duration, 1) if duration else None

        samples, loudness, peak_db = decode_and_measure(path)
        record["loudness"] = loudness
        record["peak_db"] = peak_db
        if loudness is not None and loudness > -70.0:      # -70 LUFS means silence
            record["gain_db"] = round(REPLAYGAIN_REFERENCE_LUFS - loudness, 2)

        record.update(analyse_audio(samples, loudness))
    except Stalled as exc:
        record["error"] = "stalled: {}".format(exc)
    except Exception as exc:
        record["error"] = "{}: {}".format(type(exc).__name__, exc)[:180]

    title, artist, album = describe(path, tags)
    record.update(title=title, artist=artist, album=album)
    return record


# --------------------------------------------------------------------------- tagging

def tag_values(record):
    """The tag name/value pairs we want stored for one track."""
    values = {}
    if record.get("bpm") is not None:
        values["bpm"] = str(int(round(record["bpm"])))
    if record.get("key"):
        values["key"] = record["key"]
    if record.get("energy") is not None:
        values["energy"] = str(record["energy"])
    if record.get("gain_db") is not None:
        values["replaygain_track_gain"] = "{:.2f} dB".format(record["gain_db"])
    if record.get("peak_db") is not None:
        values["replaygain_track_peak"] = "{:.6f}".format(10.0 ** (record["peak_db"] / 20.0))
    return values


def write_tags(path, values):
    """
    Store values in the file's tags, using each format's own conventions.
    Returns 'written' or 'unchanged'.
    """
    import mutagen
    from mutagen.id3 import ID3, TBPM, TKEY, TXXX
    from mutagen.flac import FLAC
    from mutagen.oggvorbis import OggVorbis
    from mutagen.mp4 import MP4, MP4FreeForm

    audio = mutagen.File(path)
    if audio is None:
        raise ValueError("unsupported container")

    changed = False

    if isinstance(audio, (FLAC, OggVorbis)):
        # Vorbis comments: plain uppercase keys.
        mapping = {"bpm": "BPM", "key": "INITIALKEY", "energy": "ENERGYLEVEL",
                   "replaygain_track_gain": "REPLAYGAIN_TRACK_GAIN",
                   "replaygain_track_peak": "REPLAYGAIN_TRACK_PEAK"}
        for name, value in values.items():
            field = mapping[name]
            if audio.get(field, [None])[0] != value:
                audio[field] = value
                changed = True

    elif isinstance(audio, MP4):
        # iTunes atoms: tmpo is a real integer, the rest are freeform strings.
        if "bpm" in values and audio.get("tmpo", [None])[0] != int(values["bpm"]):
            audio["tmpo"] = [int(values["bpm"])]
            changed = True
        freeform = {"key": "initialkey", "energy": "energylevel",
                    "replaygain_track_gain": "replaygain_track_gain",
                    "replaygain_track_peak": "replaygain_track_peak"}
        for name, atom in freeform.items():
            if name not in values:
                continue
            field = "----:com.apple.iTunes:{}".format(atom)
            encoded = values[name].encode("utf-8")
            if bytes(audio.get(field, [b""])[0]) != encoded:
                audio[field] = [MP4FreeForm(encoded)]
                changed = True

    else:
        # Anything with ID3 (MP3, and AIFF/WAV that carry an ID3 chunk).
        try:
            id3 = ID3(path)
        except Exception:
            id3 = ID3()
        if "bpm" in values and str(id3.get("TBPM", "")) != values["bpm"]:
            id3.setall("TBPM", [TBPM(encoding=3, text=[values["bpm"]])])
            changed = True
        if "key" in values and str(id3.get("TKEY", "")) != values["key"]:
            id3.setall("TKEY", [TKEY(encoding=3, text=[values["key"]])])
            changed = True
        # ReplayGain and energy have no standard frame; TXXX is the convention.
        for name, description in (("replaygain_track_gain", "REPLAYGAIN_TRACK_GAIN"),
                                  ("replaygain_track_peak", "REPLAYGAIN_TRACK_PEAK"),
                                  ("energy", "ENERGYLEVEL")):
            if name not in values:
                continue
            existing = next((f for f in id3.getall("TXXX") if f.desc == description), None)
            if existing is None or str(existing) != values[name]:
                if existing is not None:
                    id3.delall("TXXX:{}".format(description))
                id3.add(TXXX(encoding=3, desc=description, text=[values[name]]))
                changed = True
        if changed:
            id3.save(path, v2_version=3)
        return "written" if changed else "unchanged"

    if changed:
        audio.save()
    return "written" if changed else "unchanged"


def tag_in_child(record, script):
    """
    Tag one file in a separate process, so a file the storage cannot serve costs
    one abandoned child rather than a stuck worker.
    """
    payload = json.dumps(tag_values(record))
    out, _ = run_guarded([sys.executable, script, "--tag-one", record["path"], payload],
                         TAG_TIMEOUT)
    return out.decode("utf-8", "replace").strip() or "written"


def tag_library(records, min_confidence, jobs, script, dry_run):
    targets = [r for r in records
               if r.get("bpm") is not None
               and r.get("confidence", 0.0) >= min_confidence
               and tag_values(r)]
    print("\n{} {} of {} tracks (confidence >= {:g})".format(
        "Would tag" if dry_run else "Tagging", len(targets), len(records), min_confidence),
        flush=True)

    if dry_run:
        for rec in targets[:10]:
            print("  {}  ->  {}".format(os.path.basename(rec["path"])[:50],
                                        tag_values(rec)))
        if len(targets) > 10:
            print("  ... and {} more".format(len(targets) - 10))
        return 0, 0, 0

    written = unchanged = failed = done = 0
    with ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = {pool.submit(tag_in_child, r, script): r for r in targets}
        for future in as_completed(futures):
            rec = futures[future]
            try:
                if future.result() == "unchanged":
                    unchanged += 1
                else:
                    written += 1
            except Exception as exc:
                failed += 1
                if failed <= 20:
                    print("  could not tag {}: {}".format(
                        os.path.basename(rec["path"]), exc), flush=True)
            done += 1
            if done % 200 == 0 or done == len(targets):
                print("  {}/{} ({} written, {} already correct, {} failed)".format(
                    done, len(targets), written, unchanged, failed), flush=True)
    return written, unchanged, failed


# --------------------------------------------------------------------------- cache

def load_cache(cache_path):
    cached = {}
    if not os.path.exists(cache_path):
        return cached
    with open(cache_path, "r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue                      # a torn line from an interrupted run
            if record.get("path"):
                cached[record["path"]] = record       # later entries win
    return cached


# --------------------------------------------------------------------------- output

def write_csv(records, csv_path, root):
    def sort_key(rec):
        return (rec.get("bpm") is None, rec.get("bpm") or 0.0,
                rec.get("artist") or "", rec.get("title") or "")

    with open(csv_path, "w", encoding="utf-8-sig", newline="") as handle:
        writer = csv.writer(handle)
        writer.writerow(["Title", "Artist", "Album", "BPM", "BPM_Half", "BPM_Double",
                         "Confidence", "Key", "KeyConfidence", "Energy",
                         "Loudness_LUFS", "ReplayGain_dB", "TruePeak_dBFS",
                         "Duration_sec", "Duration", "Path", "Error"])
        for rec in sorted(records, key=sort_key):
            bpm, seconds = rec.get("bpm"), rec.get("duration")

            def number(value, fmt="{:.1f}"):
                return "" if value is None else fmt.format(value)

            writer.writerow([
                rec.get("title", ""), rec.get("artist", ""), rec.get("album", ""),
                number(bpm), number(bpm / 2 if bpm else None),
                number(bpm * 2 if bpm else None),
                "" if bpm is None else "{:.3f}".format(rec.get("confidence", 0.0)),
                rec.get("key", ""),
                "" if not rec.get("key") else "{:.3f}".format(rec.get("key_confidence", 0.0)),
                "" if rec.get("energy") is None else str(rec["energy"]),
                number(rec.get("loudness")), number(rec.get("gain_db"), "{:.2f}"),
                number(rec.get("peak_db")),
                number(seconds),
                "" if seconds is None else "{:d}:{:02d}".format(int(seconds) // 60, int(seconds) % 60),
                os.path.relpath(rec["path"], root),
                rec.get("error", ""),
            ])


def write_playlist(records, playlist_path, root, low, high, min_confidence):
    """Everything inside the BPM window, slowest first, as .m3u8 with relative paths."""
    picked = [r for r in records
              if r.get("bpm") is not None
              and low <= r["bpm"] <= high
              and r.get("confidence", 0.0) >= min_confidence]
    picked.sort(key=lambda r: (r["bpm"], r.get("artist") or "", r.get("title") or ""))

    with open(playlist_path, "w", encoding="utf-8", newline="\n") as handle:
        handle.write("#EXTM3U\n")
        handle.write("#PLAYLIST:Running {:g}-{:g} BPM\n".format(low, high))
        for rec in picked:
            handle.write("#EXTINF:{},{} - {} [{:.0f} BPM]\n".format(
                int(rec.get("duration") or 0), rec.get("artist", ""),
                rec.get("title", ""), rec["bpm"]))
            handle.write(os.path.relpath(rec["path"], root) + "\n")
    return picked


