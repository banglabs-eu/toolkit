#!/usr/bin/env bash
# install — Install dependencies and symlink toolkit scripts to ~/.local/bin.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$HOME/.local/bin"

info() { echo -e "\033[0;32m$*\033[0m"; }

# --- Dependencies ---

PACKAGES=()
dpkg -s parted    &>/dev/null || PACKAGES+=(parted)
dpkg -s exfatprogs &>/dev/null || PACKAGES+=(exfatprogs)

if [[ ${#PACKAGES[@]} -gt 0 ]]; then
    info "Installing missing packages: ${PACKAGES[*]}"
    sudo apt install -y "${PACKAGES[@]}"
else
    info "All dependencies already installed."
fi

# --- Symlinks ---

mkdir -p "$BIN_DIR"

declare -A TOOLS=(
    [clean-usb]=cleanusb
)

for script in "${!TOOLS[@]}"; do
    name="${TOOLS[$script]}"
    src="$SCRIPT_DIR/$script"
    dest="$BIN_DIR/$name"

    if [[ -L "$dest" && "$(readlink -f "$dest")" == "$src" ]]; then
        echo "  $name — already linked"
    else
        ln -sf "$src" "$dest"
        echo "  $name — linked"
    fi
done

# --- Build COSMIC app (if cargo is available) ---

if command -v cargo &>/dev/null && [[ -d "$SCRIPT_DIR/cosmic-clean-usb" ]]; then
    info "Building cosmic-clean-usb..."
    cargo build --release --manifest-path "$SCRIPT_DIR/cosmic-clean-usb/Cargo.toml"
    ln -sf "$SCRIPT_DIR/cosmic-clean-usb-launcher" "$BIN_DIR/cleanusb-gui"
    echo "  cleanusb-gui — built and linked"
else
    echo "  cosmic-clean-usb — skipped (cargo not found)"
fi

echo ""
info "Done. Tools available: ${TOOLS[*]} cleanusb-gui"
