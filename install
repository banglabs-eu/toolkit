#!/usr/bin/env bash
# install — Install dependencies and symlink toolkit scripts to ~/.local/bin.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="$HOME/.local/bin"

info() { echo -e "\033[0;32m$*\033[0m"; }

# --- Dependencies ---

PACKAGES=()
dpkg -s parted    &>/dev/null || PACKAGES+=(parted)
dpkg -s exfatprogs &>/dev/null || PACKAGES+=(exfatprogs)

if [[ ${#PACKAGES[@]} -gt 0 ]]; then
    info "Installing missing packages: ${PACKAGES[*]}"
    sudo apt install -y "${PACKAGES[@]}"
else
    info "All dependencies already installed."
fi

# --- Symlinks ---

mkdir -p "$BIN_DIR"

declare -A TOOLS=(
    [clean-usb]=cleanusb
)

for script in "${!TOOLS[@]}"; do
    name="${TOOLS[$script]}"
    src="$SCRIPT_DIR/$script"
    dest="$BIN_DIR/$name"

    if [[ -L "$dest" && "$(readlink -f "$dest")" == "$src" ]]; then
        echo "  $name — already linked"
    else
        ln -sf "$src" "$dest"
        echo "  $name — linked"
    fi
done

echo ""
info "Done. Tools available: ${TOOLS[*]}"
