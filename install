#!/usr/bin/env bash
# install — Build and install all toolkit scripts and apps.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BIN_DIR="/usr/local/bin"

info() { echo -e "\033[0;32m$*\033[0m"; }

# --- Dependencies ---

PACKAGES=()
dpkg -s parted     &>/dev/null || PACKAGES+=(parted)
dpkg -s exfatprogs &>/dev/null || PACKAGES+=(exfatprogs)
dpkg -s ffmpeg     &>/dev/null || PACKAGES+=(ffmpeg)
# bravia-ready: ffmpeg for conversion, the rest to OCR image-based subtitles.
dpkg -s tesseract-ocr  &>/dev/null || PACKAGES+=(tesseract-ocr)
dpkg -s python3-pil    &>/dev/null || PACKAGES+=(python3-pil)
dpkg -s python3-numpy  &>/dev/null || PACKAGES+=(python3-numpy)
# music-index: ffmpeg decodes the audio (above). librosa and mutagen are pip-only,
# so the tool builds its own venv under ~/.local/share/bpm-scan on first run.

if [[ ${#PACKAGES[@]} -gt 0 ]]; then
    info "Installing missing packages: ${PACKAGES[*]}"
    sudo apt install -y "${PACKAGES[@]}"
else
    info "All dependencies already installed."
fi

# --- CLI tool ---

sudo ln -sf "$SCRIPT_DIR/clean-usb" "$BIN_DIR/cleanusb"
echo "  cleanusb — linked to $BIN_DIR"

sudo ln -sf "$SCRIPT_DIR/bravia-ready" "$BIN_DIR/bravia-ready"
echo "  bravia-ready — linked to $BIN_DIR"

sudo ln -sf "$SCRIPT_DIR/music-index" "$BIN_DIR/music-index"
echo "  music-index — linked to $BIN_DIR"

echo ""
info "Done!"
echo "  Usage: sudo cleanusb"
echo "         bravia-ready --list"
echo "         music-index"
