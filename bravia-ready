VIDEO_EXT = {".mkv", ".mp4", ".m4v", ".avi", ".mov", ".wmv", ".ts", ".m2ts"}
# Directories holding bonus material rather than the feature itself.
EXTRA_DIRS = {"featurettes", "extras", "bonus", "samples", "sample", "trailers"}
# Text-based subtitle codecs. Image formats (PGS, VOBSUB) cannot become .srt.
TEXT_SUBS = {"subrip", "srt", "ass", "ssa", "mov_text", "text", "webvtt"}
# Scene-release subtitle files open with caption cards advertising the site.
SUB_ADVERTS = ("YTS", "YIFY", "DOWNLOADED FROM", "OPENSUBTITLES", "EXPLOSIVESKULL")

RED, GREEN, YELLOW, BLUE, BOLD, DIM, RESET = (
    "\033[0;31m", "\033[0;32m", "\033[1;33m", "\033[0;34m",
    "\033[1m", "\033[2m", "\033[0m",
)
